---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import SectionRenderer from '../../components/SectionRenderer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { serviceToSections } from '../../lib/service-sections';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

export const getStaticPaths = (async () => {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const { seo, hero } = service.data;

const settingsEntry = await getEntry('settings', 'site');
if (!settingsEntry) throw new Error('src/content/settings/site.yml bulunamadı.');

const whatsappUrl = buildWhatsAppUrl(settingsEntry.data.whatsapp.number, hero.whatsappMessage);
const sections = serviceToSections(service.data, whatsappUrl);
---

<BaseLayout title={seo.title} description={seo.description} whatsappMessage={hero.whatsappMessage}>
  <SectionRenderer {sections} />
</BaseLayout>
