---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, localizedPath } from '../lib/i18n';
import { t } from '../lib/ui';

/*
 * 404 tek bir statik dosyadır (`/404.html`) ve sunucu onu her yol için döner —
 * dolayısıyla bir dil seçmek zorundayız ve bu varsayılan dildir. Metinler yine de
 * sözlükten gelir; ileride `/en/404` üretilmek istenirse tek yapılacak bu bileşeni
 * dil başına basmaktır.
 */
const locale = DEFAULT_LOCALE;
---

<BaseLayout
  title={t('error.notFoundSeoTitle', locale)}
  description={t('error.notFoundSeoDescription', locale)}
  {locale}
  noindex
>
  <section class="notfound">
    <div class="container notfound__inner">
      <p class="eyebrow">404</p>
      <h1 class="h1">{t('error.notFoundTitle', locale)}</h1>
      <p class="lead notfound__lead">{t('error.notFoundBody', locale)}</p>
      <div class="notfound__ctas">
        <a href={localizedPath('home', locale)} class="btn btn--primary">{t('nav.home', locale)}</a>
        <a href={localizedPath('services', locale)} class="btn btn--outline">{t('nav.services', locale)}</a>
        <a href={localizedPath('contact', locale)} class="btn btn--outline">{t('nav.contact', locale)}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding: clamp(80px, 12vw, 160px) 0;
  }

  .notfound__inner {
    max-width: 680px;
  }

  .notfound__lead {
    margin-top: 22px;
  }

  .notfound__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }
</style>
