---
import type { PageSection } from '../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import BulletsSection from './sections/BulletsSection.astro';
import CardsSection from './sections/CardsSection.astro';
import ContactSection from './sections/ContactSection.astro';
import ContactInfoSection from './sections/ContactInfoSection.astro';
import CtaSection from './sections/CtaSection.astro';
import FaqSection from './sections/FaqSection.astro';
import FeaturedPostSection from './sections/FeaturedPostSection.astro';
import FormSection from './sections/FormSection.astro';
import HeroSection from './sections/HeroSection.astro';
import JobsSection from './sections/JobsSection.astro';
import LogosSection from './sections/LogosSection.astro';
import MarqueeSection from './sections/MarqueeSection.astro';
import MediaSection from './sections/MediaSection.astro';
import PostsSection from './sections/PostsSection.astro';
import ProjectsSection from './sections/ProjectsSection.astro';
import ServicesSection from './sections/ServicesSection.astro';
import StatsSection from './sections/StatsSection.astro';
import StepsSection from './sections/StepsSection.astro';
import TeamSection from './sections/TeamSection.astro';
import TextSection from './sections/TextSection.astro';
import PlatformsSection from './sections/PlatformsSection.astro';
import PrinciplesSection from './sections/PrinciplesSection.astro';
import ProcessSection from './sections/ProcessSection.astro';
import ScopeSection from './sections/ScopeSection.astro';
import SectorsSection from './sections/SectorsSection.astro';
import ShowreelSection from './sections/ShowreelSection.astro';
import WhySection from './sections/WhySection.astro';
import WorldMapSection from './sections/WorldMapSection.astro';

interface Props {
  sections: PageSection[];
  /** Koleksiyondan beslenen bölümler (hizmetler, yazılar) bağlantılarını bu dile göre kurar. */
  locale?: Locale;
}

const { sections, locale = DEFAULT_LOCALE } = Astro.props;
---

{
  sections.map((section) => {
    switch (section.type) {
      case 'hero':
        return <HeroSection section={section} {locale} />;
      case 'cards':
        return <CardsSection section={section} />;
      case 'steps':
        return <StepsSection section={section} />;
      case 'bullets':
        return <BulletsSection section={section} />;
      case 'marquee':
        return <MarqueeSection section={section} />;
      case 'platforms':
        return <PlatformsSection section={section} />;
      case 'principles':
        return <PrinciplesSection section={section} />;
      case 'why':
        return <WhySection section={section} />;
      case 'scope':
        return <ScopeSection section={section} />;
      case 'process':
        return <ProcessSection section={section} />;
      case 'worldMap':
        return <WorldMapSection section={section} />;
      case 'sectorCards':
        return <SectorsSection section={section} />;
      case 'showreel':
        return <ShowreelSection section={section} />;
      case 'text':
        return <TextSection section={section} />;
      case 'stats':
        return <StatsSection section={section} />;
      case 'faq':
        return <FaqSection section={section} />;
      case 'cta':
        return <CtaSection section={section} />;
      case 'logos':
        return <LogosSection section={section} {locale} />;
      case 'projects':
        return <ProjectsSection section={section} {locale} />;
      case 'posts':
        return <PostsSection section={section} {locale} />;
      case 'featuredPost':
        return <FeaturedPostSection section={section} {locale} />;
      case 'team':
        return <TeamSection section={section} {locale} />;
      case 'services':
        return <ServicesSection section={section} {locale} />;
      case 'form':
        return <FormSection section={section} {locale} />;
      case 'contact':
        return <ContactSection section={section} {locale} />;
      case 'contactInfo':
        return <ContactInfoSection section={section} />;
      case 'media':
        return <MediaSection section={section} />;
      case 'jobs':
        return <JobsSection section={section} {locale} />;
    }
  })
}
