---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../lib/format';
import { localizedPath, ROUTE_SLUGS, type Locale, type PageKey } from '../lib/i18n';
import { canonicalUrl } from '../lib/seo';
import { breadcrumbSchema } from '../lib/schema';
import { t } from '../lib/ui';

interface Props {
  entry: CollectionEntry<'legal'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { entry, locale, alternates } = Astro.props;
const { Content } = await render(entry);
const { title, seo, intro, updated } = entry.data;

const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';
const extraSchema = [
  breadcrumbSchema([
    { label: t('nav.home', locale), url: new URL(localizedPath('home', locale), site).toString() },
    { label: title },
  ]),
];

/* Sayfa altındaki "ilgili yasal metinler" — kendisi hariç diğer üçü. */
const LEGAL_KEYS: PageKey[] = ['kvkk', 'privacy', 'cookies', 'terms'];
const selfKey = entry.id.split('/').slice(1).join('/');
const related = LEGAL_KEYS.filter((key) => key !== selfKey);
const LEGAL_LABELS: Record<string, Record<Locale, string>> = {
  kvkk: { tr: 'KVKK Aydınlatma Metni', en: 'Personal Data Processing Notice' },
  privacy: { tr: 'Gizlilik Politikası', en: 'Privacy Policy' },
  cookies: { tr: 'Çerez Politikası', en: 'Cookie Policy' },
  terms: { tr: 'Kullanım Koşulları', en: 'Terms of Use' },
};
---

<BaseLayout title={seo.title} description={seo.description} {locale} {alternates} {extraSchema}>
  <article class="legal">
    <header class="legal__head">
      <div class="container legal__inner">
        <nav class="legal__crumbs" aria-label={t('nav.breadcrumb', locale)}>
          <a href={localizedPath('home', locale)}>{t('nav.home', locale)}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        <p class="eyebrow">{t('legal.eyebrow', locale)}</p>
        <h1 class="legal__title">{title}</h1>
        {intro && <p class="lead legal__intro">{intro}</p>}
        <p class="legal__updated">
          {t('legal.updated', locale)}: <time datetime={isoDate(updated)}>{formatDate(updated, locale)}</time>
        </p>
      </div>
    </header>

    <div class="legal__article">
      <div class="container legal__inner">
        <div class="legal__body">
          <Content />
        </div>

        <aside class="legal__related" aria-label={t('legal.related', locale)}>
          <h2 class="legal__related-title">{t('legal.related', locale)}</h2>
          <ul class="legal__related-list">
            {
              related.map((key) => (
                <li>
                  <a href={localizedPath(key, locale)}>{LEGAL_LABELS[key]?.[locale] ?? ROUTE_SLUGS[key][locale]}</a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal__head {
    padding: clamp(40px, 5vw, 64px) 0 clamp(36px, 5vw, 52px);
  }

  /* Metin gövdesi blog makaleleriyle aynı dilde: beyaz bant, koyu düzyazı. */
  .legal__article {
    background: var(--bg-light);
    color: var(--text-on-light);
    padding: clamp(48px, 6vw, 72px) 0 clamp(72px, 9vw, 110px);
  }

  .legal__inner {
    max-width: 820px;
  }

  .legal__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    margin-bottom: 24px;
  }

  .legal__crumbs a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--t-base);
  }

  .legal__crumbs a:hover {
    color: var(--accent);
  }

  .legal__crumbs [aria-current] {
    color: var(--text-soft);
  }

  .legal__title {
    margin: 18px 0 0;
    font: 600 clamp(28px, 4vw, 44px) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .legal__intro {
    margin-top: 18px;
    max-width: 680px;
  }

  .legal__updated {
    margin: 20px 0 0;
    font: 500 13.5px var(--font-display);
    color: var(--text-faint);
  }

  .legal__body {
    font-size: 16px;
    line-height: 1.75;
    color: rgba(10, 10, 10, 0.8);
  }

  .legal__body :global(h2) {
    margin: 40px 0 14px;
    font: 600 clamp(20px, 2.2vw, 25px) / 1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-on-light);
  }

  .legal__body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal__body :global(h3) {
    margin: 28px 0 10px;
    font: 600 18px var(--font-display);
    color: var(--text-on-light);
  }

  .legal__body :global(p) {
    margin: 0 0 16px;
  }

  .legal__body :global(ul),
  .legal__body :global(ol) {
    margin: 0 0 18px;
    padding-left: 22px;
  }

  .legal__body :global(li) {
    margin-bottom: 8px;
  }

  .legal__body :global(strong) {
    color: var(--text-on-light);
  }

  .legal__body :global(a) {
    color: var(--text-on-light);
  }

  /*
   * Çerez tablosu — yatay taşma kendi kutusunda kayar.
   *
   * Bu yorum buradaydı ama KURAL YAZILMAMIŞTI: tablo doğrudan `.legal__body` içinde
   * duruyor, sarılamıyor ve taşması BELGEYE yayılıyordu — 360 px'te +208 px, İngilizce
   * sayfada +233 px. Kullanıcı bunu "ekran sağa sola kayıyor" diye tarif ediyordu
   * (1 Eyl 2026).
   */
  .legal__body :global(table) {
    /*
     * `display: block` tabloyu KENDİ kaydırma kutusuna çevirir. Sarmalayıcı bir div
     * daha temiz olurdu ama markdown çıktısına düğüm ekleyemiyoruz: Astro'nun varsayılan
     * markdown işlemcisi rehype eklentisi almıyor ve almak için tüm boru hattını
     * değiştirmek gerekiyor — bir tablo için orantısız bir risk.
     *
     * `border-collapse` AÇIKÇA tekrar yazılmalı: kısayol sıfırlanınca `separate`e düşüyor
     * ve hücreler arasında boşluk kalıyordu (ekran görüntüsüyle doğrulandı). Blok kutuya
     * dönen tabloda da collapse çalışıyor — kenarlıklar tek çizgi kalıyor.
     */
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
    margin: 0 0 20px;
    font-size: 14px;
  }

  .legal__body :global(table:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Kutunun içinde sıkışıp okunmaz hâle gelmesin; dar ekranda tablo kayar. */
  .legal__body :global(thead),
  .legal__body :global(tbody) {
    min-width: 32rem;
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    border: 1px solid rgba(10, 10, 10, 0.15);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }

  .legal__body :global(th) {
    font: 600 13px var(--font-display);
    background: var(--bg-tint);
    color: var(--text-on-light);
  }

  /* Çerez Politikası içindeki "Tercihleri Yönet" butonu (markdown'dan gelir). */
  .legal__body :global(.btn) {
    margin: 6px 0 18px;
  }

  .legal__related {
    margin-top: clamp(40px, 5vw, 56px);
    border-top: 1px solid rgba(10, 10, 10, 0.12);
    padding-top: 24px;
  }

  .legal__related-title {
    margin: 0 0 12px;
    font: 600 15px var(--font-display);
    color: var(--text-on-light);
  }

  .legal__related-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal__related-list a {
    font-size: 14px;
    color: rgba(10, 10, 10, 0.7);
    text-underline-offset: 4px;
  }

  .legal__related-list a:hover {
    color: var(--text-on-light);
  }
</style>
