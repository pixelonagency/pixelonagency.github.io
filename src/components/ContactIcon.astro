---
/**
 * İletişim kanalı ikonları.
 *
 * Çizgi dili ProcessIcon · SectorIcon · PrincipleIcon · WhyIcon ile aynı: 24×24
 * kutu, stroke 1.6, yuvarlatılmış uçlar. Kütüphane eklenmedi (CLAUDE.md).
 */
type ContactIconName = 'whatsapp' | 'phone' | 'mail' | 'location' | 'social';

interface Props {
  name: ContactIconName;
}

const { name }: Props = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* WhatsApp — kuyruğu sol alta düşen konuşma balonu, içinde ahize. */}
  {
    name === 'whatsapp' && (
      <>
        <path d="M20.5 11.6a8.5 8.5 0 01-12.6 7.45L3.5 20.5l1.48-4.35A8.5 8.5 0 1120.5 11.6z" />
        <path d="M9.3 9.1c.35-.1.62.02.78.36l.62 1.32c.13.28.08.5-.14.72l-.4.4c-.14.14-.17.3-.07.48a5.4 5.4 0 002.6 2.6c.18.1.34.07.48-.07l.4-.4c.22-.22.44-.27.72-.14l1.32.62c.34.16.46.43.36.78-.22.8-.98 1.3-1.86 1.2-2.9-.32-5.5-2.92-5.82-5.82-.1-.88.4-1.64 1.2-1.86z" />
      </>
    )
  }

  {/* Telefon — klasik ahize. */}
  {
    name === 'phone' && (
      <path d="M6.2 3.6h3l1.5 3.7-1.85 1.1a11.4 11.4 0 005.75 5.75l1.1-1.85 3.7 1.5v3a1.7 1.7 0 01-1.85 1.7C11.3 17.9 6.1 12.7 4.5 5.45A1.7 1.7 0 016.2 3.6z" />
    )
  }

  {/* E-posta — kapağı açılmış zarf. */}
  {
    name === 'mail' && (
      <>
        <rect x="2.8" y="5.2" width="18.4" height="13.6" rx="2.2" />
        <path d="M3.4 7l7.5 5.3a2 2 0 002.2 0L20.6 7" />
      </>
    )
  }

  {/* Konum — harita pini. */}
  {
    name === 'location' && (
      <>
        <path d="M12 21.2s6.6-5.4 6.6-10.2a6.6 6.6 0 10-13.2 0c0 4.8 6.6 10.2 6.6 10.2z" />
        <circle cx="12" cy="10.6" r="2.5" />
      </>
    )
  }

  {/* Sosyal medya — birbirine bağlı üç düğüm. */}
  {
    name === 'social' && (
      <>
        <circle cx="17.6" cy="5.8" r="2.6" />
        <circle cx="6.4" cy="12" r="2.6" />
        <circle cx="17.6" cy="18.2" r="2.6" />
        <path d="M8.75 10.75l6.5-3.6M8.75 13.25l6.5 3.6" />
      </>
    )
  }
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
