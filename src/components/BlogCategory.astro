---
/**
 * Blog kategori merkezi.
 *
 * Aynı konudaki yazıları tek bir hedefte toplar. İki işi var: kırıntıya gerçek bir
 * hedef vermek (bkz. `blog-categories.ts`) ve konu başına toplu bir giriş noktası
 * kurarak yazıların birbirine ve hizmet sayfasına bağlanmasını sağlamak.
 *
 * Liste `PostsSection` ile çizilir — kart işaretlemesi ve stili blog listesiyle
 * birebir aynı kalsın diye; bu bileşen yalnızca süzülmüş listeyi geçirir.
 */
import { getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CategoryGroup } from '../lib/blog-categories';
import { categoryPath } from '../lib/blog-categories';
import { localizedPath, type Locale } from '../lib/i18n';
import { breadcrumbSchema } from '../lib/schema';
import { t } from '../lib/ui';
import { inlineHtml, paragraphs } from './article/types';
import PostsSection from './sections/PostsSection.astro';

interface Props {
  group: CategoryGroup<CollectionEntry<'posts'>>;
  /** Sayfası olan diğer kategoriler — alt gezinme için. */
  others: CategoryGroup<CollectionEntry<'posts'>>[];
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { group, others, locale, alternates } = Astro.props;

const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';
const blogPath = localizedPath('blog', locale);

/*
 * Editoryal giriş metni. Sayfa kendiliğinden üretiliyor ama metin elle yazılıyor;
 * eşleşmeyi `tests/content-integrity.test.ts` zorunlu kılar, bu yüzden burada eksikliği
 * sessizce tolere etmek güvenli — build'i düşürmek yerine sayfa eski hâline dönüyor.
 */
const editorial = await getEntry('categories', `${locale}/${group.slug}`);
const intro = editorial?.data;

const title = `${group.name} ${t('blog.category.titleSuffix', locale)} | Pixelon Blog`;
const description =
  locale === 'tr'
    ? `Pixelon blogunda ${group.name} kategorisindeki ${group.posts.length} yazı: strateji, uygulama ve ölçüm başlıklarıyla.`
    : `${group.posts.length} articles in the ${group.name} category on the Pixelon blog: strategy, implementation and measurement.`;

/* Son kırıntı bulunulan sayfadır; hedefi yoktur — `breadcrumbSchema` bunu bekler. */
const extraSchema = [
  breadcrumbSchema([
    { label: t('nav.home', locale), url: new URL(localizedPath('home', locale), site).toString() },
    { label: t('nav.blog', locale), url: new URL(blogPath, site).toString() },
    { label: group.name },
  ]),
];

/* `PostsSection` CMS bölümü bekler; liste dışarıdan geldiği için kabuk alanları sabit. */
const section = {
  type: 'posts' as const,
  heading: group.name,
  background: 'dark' as const,
  ctas: [],
};
---

<BaseLayout {title} {description} {locale} {alternates} {extraSchema}>
  <header class="cat__head">
    <div class="container cat__inner">
      <nav class="cat__crumbs" aria-label={t('nav.breadcrumb', locale)}>
        <a href={localizedPath('home', locale)}>{t('nav.home', locale)}</a>
        <span aria-hidden="true">/</span>
        <a href={blogPath}>{t('nav.blog', locale)}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{group.name}</span>
      </nav>

      <p class="eyebrow">{t('blog.category.eyebrow', locale)}</p>
      <h1 class="cat__title">{group.name}</h1>
      <p class="cat__count">{group.posts.length} {t('blog.category.posts', locale)}</p>

      {
        intro && (
          <div class="cat__intro">
            {paragraphs(intro.intro).map((part) => (
              <p set:html={inlineHtml(part)} />
            ))}
            {intro.serviceHref && intro.serviceLabel && (
              <a class="cat__service" href={intro.serviceHref}>
                {intro.serviceLabel} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        )
      }
    </div>
  </header>

  <PostsSection {section} {locale} entries={group.posts} />

  {
    others.length > 0 && (
      <nav class="cat__others" aria-label={t('blog.category.other', locale)}>
        <div class="container">
          <h2 class="cat__others-title">{t('blog.category.other', locale)}</h2>
          <ul class="cat__others-list" role="list">
            {others.map((other) => (
              <li>
                <a href={categoryPath(locale, other.name)}>
                  {other.name} <span class="cat__others-count">{other.posts.length}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="cat__back" href={blogPath}>
            {t('blog.category.all', locale)}
          </a>
        </div>
      </nav>
    )
  }
</BaseLayout>

<style>
  .cat__head {
    padding: clamp(40px, 5vw, 64px) 0 clamp(24px, 3vw, 36px);
  }

  .cat__inner {
    max-width: 820px;
  }

  .cat__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    margin-bottom: 24px;
  }

  .cat__crumbs a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--t-base);
  }

  .cat__crumbs a:hover {
    color: var(--accent);
  }

  .cat__crumbs [aria-current] {
    color: var(--text-soft);
  }

  /* Kategori merkezinin editoryal girişi — listeden önce konuyu tarif eden metin. */
  .cat__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: clamp(20px, 2.4vw, 28px);
    max-width: 68ch;
  }

  .cat__intro :global(p) {
    margin: 0;
    font: 400 clamp(15px, 1.3vw, 17px) / 1.72 var(--font-body);
    color: var(--text-muted);
  }

  .cat__intro :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
    transition: color var(--t-base);
  }

  .cat__intro :global(a:hover) {
    color: var(--accent);
  }

  .cat__service {
    align-self: flex-start;
    font: 600 14px var(--font-display);
    color: var(--accent);
    text-decoration: none;
    padding-top: 4px;
    transition: opacity var(--t-base);
  }

  .cat__service:hover {
    opacity: 0.75;
  }

  .cat__title {
    margin: 18px 0 0;
    font: 600 clamp(30px, 4.4vw, 48px) / 1.12 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .cat__count {
    margin: 14px 0 0;
    font: 500 14px var(--font-display);
    color: var(--text-faint);
  }

  .cat__others {
    padding: 0 0 clamp(60px, 7vw, 90px);
  }

  .cat__others-title {
    margin: 0 0 16px;
    font: 600 15px var(--font-display);
    color: var(--text-soft);
  }

  .cat__others-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .cat__others-list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 8px 16px;
    font: 500 14px var(--font-display);
    color: var(--text-soft);
    text-decoration: none;
    transition:
      border-color var(--t-base),
      color var(--t-base);
  }

  .cat__others-list a:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .cat__others-count {
    font-size: 12px;
    color: var(--text-faint);
  }

  .cat__back {
    font: 500 14px var(--font-display);
    color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
