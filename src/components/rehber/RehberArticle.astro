---
/**
 * Guide article. Same reading layout as a markdown blog post (`PostDetail.astro`):
 * dark title band, then the body on the light band at reading width. Structured data
 * reuses the blog posting node as an `Article`.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../../lib/format';
import type { Locale } from '../../lib/i18n';
import { rehberCrumbs, rehberPath, REHBER_AUDIENCE_LABELS } from '../../lib/rehber';
import { blogPostingSchema, breadcrumbSchema } from '../../lib/schema';
import { canonicalUrl } from '../../lib/seo';
import { t } from '../../lib/ui';
import { checklistRangeText, splitArticleBody } from '../../lib/rehber-blocks';
import ArticleCallout from '../article/ArticleCallout.astro';
import ArticleQuote from '../article/ArticleQuote.astro';
import { INFOGRAPHICS } from './infographics';
import RehberCover from './RehberCover.astro';
import RehberFigure from './RehberFigure.astro';
import RehberStats from './RehberStats.astro';
import RehberCrumbs from './RehberCrumbs.astro';

interface Props {
  article: CollectionEntry<'rehber'>;
  /** The related checklist when it has a page in this build. */
  checklist?: CollectionEntry<'checklists'> | undefined;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { article, checklist, locale, alternates } = Astro.props;
const {
  title,
  description,
  sektor,
  kitle,
  seri,
  okuma_suresi,
  yayin_tarihi,
  durum,
  kapak,
  kapak_alt,
  alinti,
  istatistikler,
} = article.data;
/*
 * The Markdown body is rendered by Astro as usual; blocks placed with marker lines
 * (`[[alinti]]`, `[[checklist: 13-17]]` …) are cut out of that HTML and rendered as
 * components. See src/lib/rehber-blocks.ts for the syntax and why no MDX.
 */
const html = article.rendered?.html;
if (html === undefined) throw new Error(`Guide article "${article.id}" has no rendered body.`);
const segments = splitArticleBody(html);

const crumbs = rehberCrumbs({ locale, sektor, kitle, title });
const audiencePath = rehberPath(locale, sektor, kitle);

const coverImage: ImageMetadata | undefined =
  kapak && typeof kapak === 'object' && 'src' in kapak ? (kapak as ImageMetadata) : undefined;
/* Share image as JPEG, same as blog posts: webp does not preview on every platform. */
const ogImage = coverImage ? await getImage({ src: coverImage, format: 'jpeg', width: 1200 }) : undefined;

const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';
const extraSchema = [
  blogPostingSchema({
    type: 'Article',
    headline: title,
    description,
    url: canonicalUrl(Astro.url.pathname, site),
    datePublished: isoDate(yayin_tarihi),
    author: 'Pixelon',
    locale,
    imageUrl: coverImage ? new URL(coverImage.src, site).toString() : undefined,
  }),
  breadcrumbSchema(
    crumbs.map((crumb) => ({ label: crumb.label, url: crumb.href ? new URL(crumb.href, site).toString() : undefined })),
  ),
];
---

<BaseLayout
  title={`${title} | Pixelon Rehber`}
  {description}
  ogType="article"
  {locale}
  {alternates}
  ogImage={ogImage?.src}
  {extraSchema}
>
  <article class="ra">
    <header class="ra__head">
      <div class="container ra__inner">
        <RehberCrumbs {crumbs} {locale} />
        {durum === 'taslak' && <p class="ra__draft">Taslak, yalnızca önizleme</p>}
        <p class="ra__chip">{seri}</p>
        <h1 class="ra__title">{title}</h1>
        <p class="lead ra__excerpt">{description}</p>
        <div class="ra__meta">
          <span>{REHBER_AUDIENCE_LABELS[kitle]}</span>
          <time datetime={isoDate(yayin_tarihi)}>{formatDate(yayin_tarihi, locale)}</time>
          <span>{okuma_suresi} {t('blog.readingTime', locale)}</span>
        </div>
      </div>
    </header>

    <div class="ra__article">
      <div class="container ra__wide">
        <RehberCover cover={{ image: kapak, alt: kapak_alt, label: seri, seed: article.data.slug }} size="hero" />
      </div>
      <div class="container ra__inner">
        <div class="ra__body">
          {
            segments.map((segment) => {
              switch (segment.kind) {
                case 'html':
                  return <div class="ra__prose" set:html={segment.html} />;
                case 'alinti':
                  if (!alinti) throw new Error(`"${article.id}" uses [[alinti]] without an alinti field.`);
                  return <ArticleQuote block={{ type: 'quote', text: alinti.metin, cite: alinti.kaynak }} />;
                case 'istatistikler':
                  if (istatistikler.length === 0) {
                    throw new Error(`"${article.id}" uses [[istatistikler]] without istatistikler.`);
                  }
                  return <RehberStats items={istatistikler} />;
                case 'checklist': {
                  if (!article.data.checklist) {
                    throw new Error(`"${article.id}" uses [[checklist]] without a checklist field.`);
                  }
                  /* Linked only when the checklist page is in this build; a draft checklist stays text. */
                  const link = checklist
                    ? ` [Checklisti açın →](${rehberPath(locale, sektor, kitle, checklist.data.slug)})`
                    : '';
                  return (
                    <ArticleCallout
                      block={{
                        type: 'callout',
                        heading: 'Checklist bağlantısı',
                        text: `${checklistRangeText(segment.from, segment.to)}${link}`,
                      }}
                    />
                  );
                }
                case 'infografik': {
                  const entry = INFOGRAPHICS[segment.name as keyof typeof INFOGRAPHICS];
                  if (!entry) throw new Error(`"${article.id}" names unknown infographic "${segment.name}".`);
                  const Graphic = entry.component;
                  return (
                    <RehberFigure title={entry.title} caption={entry.caption}>
                      <Graphic />
                    </RehberFigure>
                  );
                }
              }
            })
          }
        </div>

        {
          checklist && (
            <aside class="ra__checklist" aria-labelledby="ra-checklist-title">
              <p class="ra__checklist-eyebrow">Kontrol listesi</p>
              <p class="ra__checklist-title" id="ra-checklist-title">
                {checklist.data.title}
              </p>
              <p class="ra__checklist-text">{checklist.data.description}</p>
              <a class="btn btn--primary" href={rehberPath(locale, sektor, kitle, checklist.data.slug)}>
                Checklisti alın <span aria-hidden="true">→</span>
              </a>
            </aside>
          )
        }

        <a class="btn btn--outline ra__back" href={audiencePath}>
          ← {REHBER_AUDIENCE_LABELS[kitle]} rehberine dön
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .ra__head {
    padding: clamp(40px, 5vw, 64px) 0 clamp(40px, 5vw, 56px);
  }

  .ra__inner {
    max-width: 820px;
  }

  /* Cover uses the wider media line of the blog layout. */
  .ra__wide {
    max-width: calc(1080px + var(--gutter) * 2);
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .ra__draft {
    display: inline-block;
    margin: 0 12px 0 0;
    padding: 6px 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font: 600 12px var(--font-display);
    color: var(--text-soft);
  }

  /* Series chip: same treatment as the blog category chip. */
  .ra__chip {
    display: inline-block;
    margin: 0;
    padding: 6px 14px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    font: 600 var(--fs-eyebrow) var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ra__title {
    margin: 22px 0 0;
    font: 600 clamp(28px, 4vw, 44px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .ra__excerpt {
    margin-top: 20px;
  }

  .ra__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 24px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
    font: 500 13.5px var(--font-display);
    color: var(--text-faint);
  }

  .ra__article {
    background: var(--bg-light);
    color: var(--text-on-light);
    padding: clamp(48px, 6vw, 72px) 0 clamp(72px, 9vw, 110px);
  }

  /* Body copy matches the markdown blog body: 18/1.75, dark on the light band. */
  .ra__body {
    font-size: 18px;
    line-height: 1.75;
    color: rgba(10, 10, 10, 0.8);
  }

  .ra__body > .ra__prose:first-child > :global(:first-child) {
    margin-top: 0;
  }

  .ra__prose :global(h2) {
    margin: 44px 0 16px;
    font: 600 clamp(22px, 2.4vw, 28px) / 1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-on-light);
  }

  .ra__prose :global(h3) {
    margin: 32px 0 12px;
    font: 600 19px var(--font-display);
    color: var(--text-on-light);
  }

  .ra__prose :global(p) {
    margin: 0 0 20px;
  }

  .ra__prose :global(ul),
  .ra__prose :global(ol) {
    margin: 0 0 22px;
    padding-left: 22px;
  }

  .ra__prose :global(li) {
    margin-bottom: 10px;
  }

  .ra__prose :global(strong),
  .ra__prose :global(a) {
    color: var(--text-on-light);
  }

  /* Source lists carry long URLs; without this they push the page sideways on phones. */
  .ra__prose :global(a) {
    overflow-wrap: anywhere;
  }

  .ra__prose :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--accent);
    font-size: 17px;
    color: rgba(10, 10, 10, 0.75);
  }

  /*
   * Site links are lime with a white hover, which fails contrast on the light band.
   * Links inside guide blocks (e.g. the checklist callout) use dark ink instead.
   */
  .ra__body :global(.aq a),
  .ra__body :global(.aq a:hover) {
    font-weight: 600;
    color: var(--text-on-light);
  }

  .ra__checklist {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 48px;
    padding: clamp(28px, 4vw, 40px);
    border-radius: var(--radius-feature);
    background: var(--bg);
    color: var(--text);
  }

  .ra__checklist-eyebrow {
    margin: 0;
    font: 600 var(--fs-eyebrow) var(--font-display);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  .ra__checklist-title {
    margin: 0;
    font: 600 clamp(21px, 2.4vw, 26px) / 1.25 var(--font-display);
  }

  .ra__checklist-text {
    margin: 0 0 8px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .ra__back {
    margin-top: 44px;
    border-color: rgba(10, 10, 10, 0.25);
    color: var(--text-on-light);
  }

  .ra__back:hover {
    border-color: var(--text-on-light);
    color: var(--text-on-light);
  }
</style>
