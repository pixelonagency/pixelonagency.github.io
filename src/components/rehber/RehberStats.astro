---
/**
 * Stat cards row for a guide article (`[[istatistikler]]`). Each card shows a value,
 * a label and an optional qualifier, so a number never appears without its context
 * (e.g. "reklam destekli videolar dahil").
 */
interface Props {
  items: { deger: string; etiket: string; not?: string | undefined }[];
}

const { items } = Astro.props;
---

<ul class="rs" role="list">
  {
    items.map((item) => (
      <li class="rs__card">
        <span class="rs__bar" aria-hidden="true" />
        <span class="rs__value">{item.deger}</span>
        <span class="rs__label">{item.etiket}</span>
        {item.not && <span class="rs__note">{item.not}</span>}
      </li>
    ))
  }
</ul>

<style>
  .rs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 14px;
    margin: clamp(32px, 4vw, 48px) 0;
    padding: 0;
    list-style: none;
  }

  .rs__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 22px 20px;
    border: 1px solid var(--border-on-light);
    border-radius: var(--radius-media);
    background: #fff;
  }

  /* Lime as a short rule only, never as a text colour on the light band. */
  .rs__bar {
    width: 28px;
    height: 4px;
    margin-bottom: 8px;
    border-radius: 2px;
    background: var(--accent);
  }

  .rs__value {
    font: 600 clamp(34px, 4vw, 44px) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--text-on-light);
  }

  .rs__label {
    font: 600 15px var(--font-display);
    color: var(--text-on-light);
  }

  .rs__note {
    font: 400 var(--fs-small) / 1.5 var(--font-body);
    color: var(--text-muted-on-light);
  }
</style>
