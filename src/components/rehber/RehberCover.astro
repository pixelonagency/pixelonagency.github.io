---
/**
 * 16:9 cover for guide pages and cards.
 *
 * With a `kapak` image it renders an optimised <Picture>. Without one it draws the
 * fallback: a dark panel with the series (or audience) label and a lime pixel motif,
 * so a missing cover never shows a broken image. The fallback is decorative; the same
 * label is already in the card or page heading, so it is hidden from screen readers.
 *
 * Card images get an empty alt for the same reason: the card title already names the
 * link, and the description would be read twice.
 *
 * Cards crop to 4:3 and anchor the image to the right. The guide illustrations leave
 * the left ~45% as empty paper, so the crop drops paper and keeps the subject.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { MOTIF_GRID, pixelMotif, type RehberCover } from '../../lib/rehber';

interface Props {
  cover: RehberCover;
  /** `hero`: top of an article, loaded eagerly as the LCP candidate. `card`: lazy. */
  size: 'hero' | 'card';
}

const { cover, size } = Astro.props;

const image: ImageMetadata | undefined =
  cover.image && typeof cover.image === 'object' && 'src' in cover.image ? (cover.image as ImageMetadata) : undefined;

const CELL = 10;
const cells = image ? [] : pixelMotif(cover.seed);
const hero = size === 'hero';
---

{
  image ? (
    <div class:list={['rc', `rc--${size}`]}>
      <Picture
        src={image}
        alt={hero ? (cover.alt ?? '') : ''}
        formats={['avif']}
        fallbackFormat="webp"
        widths={hero ? [640, 1024, 1440, 1600] : [480, 720]}
        sizes={hero ? '(max-width: 720px) 100vw, 1080px' : '(max-width: 720px) 100vw, 420px'}
        quality={74}
        loading={hero ? 'eager' : 'lazy'}
        fetchpriority={hero ? 'high' : 'auto'}
        decoding="async"
      />
    </div>
  ) : (
    <div class:list={['rc', `rc--${size}`, 'rc--fallback']} aria-hidden="true">
      <svg
        class="rc__motif"
        viewBox={`0 0 ${MOTIF_GRID.columns * CELL} ${MOTIF_GRID.rows * CELL}`}
        preserveAspectRatio="xMidYMid slice"
        focusable="false"
      >
        {cells.map((cell) => (
          <rect
            x={cell.x * CELL + 0.5}
            y={cell.y * CELL + 0.5}
            width={CELL - 1}
            height={CELL - 1}
            class={cell.accent ? 'rc__px rc__px--accent' : 'rc__px'}
            opacity={cell.accent ? undefined : cell.alpha}
          />
        ))}
      </svg>
      <span class="rc__label">{cover.label}</span>
    </div>
  )
}

<style>
  .rc {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--bg-footer);
  }

  .rc--card {
    aspect-ratio: 4 / 3;
  }

  .rc :global(picture) {
    display: contents;
  }

  .rc :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rc--card :global(img) {
    object-position: right center;
  }

  .rc--fallback {
    border: 1px solid var(--border);
    background-image: radial-gradient(ellipse 70% 90% at 85% 40%, var(--accent-soft), transparent 70%);
  }

  .rc__motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--text);
  }

  .rc__px {
    fill: currentColor;
  }

  .rc__px--accent {
    fill: var(--accent);
  }

  /* Label sits on the calm left side of the motif; white on near-black passes AA. */
  .rc__label {
    position: absolute;
    left: clamp(16px, 4%, 32px);
    bottom: clamp(14px, 6%, 28px);
    max-width: 70%;
    font: 600 var(--fs-eyebrow) / 1.4 var(--font-display);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text);
  }

  .rc--hero .rc__label {
    font-size: clamp(12px, 1.4vw, 15px);
  }
</style>
