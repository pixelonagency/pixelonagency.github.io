---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { categoryPath, hasCategoryPage } from '../lib/blog-categories';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from './CtaButton.astro';
import ArticleBlocks from './article/ArticleBlocks.astro';
import BlogQuickAnswer from './article/BlogQuickAnswer.astro';
import RelatedArticles from './article/RelatedArticles.astro';
import { blocksText } from './article/types';
import { formatDate, isoDate, readingTime } from '../lib/format';
import { localizedPath, type Locale } from '../lib/i18n';
import { pickRelatedPosts } from '../lib/related-posts';
import { canonicalUrl } from '../lib/seo';
import { blogPostingSchema, breadcrumbSchema, faqPageSchema } from '../lib/schema';
import { t } from '../lib/ui';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { post, locale, alternates } = Astro.props;

/** Kart ızgarası üçlü ritimde akar (bkz. RelatedArticles.astro). */
const RELATED_COUNT = 3;
const { title, excerpt, category, date, author, cover, seo, article } = post.data;

/**
 * İki mod: `article` dolu olan yazılar modüler editorial şablonla, boş olanlar
 * mevcut markdown akışıyla render edilir. Markdown yolu bozulmadan korunur.
 */
const blocks = article?.blocks ?? [];
const isEditorial = blocks.length > 0;

const { Content } = await render(post);

const minutes = readingTime(isEditorial ? blocksText(blocks) : (post.body ?? ''));

/** İçindekiler girdileri bölüm bloklarından türetilir — elle liste tutulmaz. */
const tocItems = blocks
  .filter((block): block is Extract<typeof block, { type: 'section' }> => block.type === 'section')
  .map((block) => ({ id: block.id, label: block.heading }));

/** SSS yapısal verisi yalnız sayfada GERÇEKTEN görünen sorulardan üretilir. */
const faqItems = blocks.flatMap((block) => (block.type === 'faq' ? block.items : []));

/*
 * İlgili yazılar: editörün seçimi önce gelir, eksik kalan yer aynı kategoriden
 * (sonra blogun geri kalanından) en yeni yazılarla tamamlanır. Böylece `related`
 * alanı boş bırakılan yazılar da blog ağına bağlanır — seçim mantığı ve gerekçesi
 * için bkz. `src/lib/related-posts.ts`.
 */
const sameLocalePosts = await getCollection(
  'posts',
  (entry) => entry.data.status === 'published' && entry.id.startsWith(`${locale}/`),
);
const relatedPosts = pickRelatedPosts({
  current: post,
  all: sameLocalePosts,
  keys: article?.related ?? [],
  count: RELATED_COUNT,
});

/* Kategori merkezi yalnızca eşiği geçen kategoriler için üretilir; yoksa bağlantı kurulmaz. */
const categoryHref = hasCategoryPage(sameLocalePosts, locale, category) ? categoryPath(locale, category) : undefined;

const coverImage: ImageMetadata | undefined =
  cover && typeof cover === 'object' && 'src' in cover ? (cover as ImageMetadata) : undefined;

const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';
const pageUrl = canonicalUrl(Astro.url.pathname, site);
const updated = article?.updated;

const extraSchema = [
  blogPostingSchema({
    headline: title,
    description: excerpt,
    url: pageUrl,
    datePublished: isoDate(date),
    dateModified: updated ? isoDate(updated) : undefined,
    author,
    locale,
    imageUrl: coverImage ? new URL(coverImage.src, site).toString() : undefined,
  }),
  breadcrumbSchema([
    { label: t('nav.home', locale), url: new URL(localizedPath('home', locale), site).toString() },
    { label: t('nav.blog', locale), url: new URL(localizedPath('blog', locale), site).toString() },
    /* Kategori yalnızca kendi sayfasını hak ediyorsa hedef alır; almazsa
       `breadcrumbSchema` hedefsiz ara kırıntıyı zaten düşürür. */
    { label: category, url: categoryHref ? new URL(categoryHref, site).toString() : undefined },
    { label: title },
  ]),
  ...(faqItems.length ? [faqPageSchema(faqItems)] : []),
];
---

<BaseLayout
  title={seo?.title ?? `${title} | Pixelon Blog`}
  description={seo?.description ?? excerpt}
  ogType="article"
  {locale}
  {alternates}
  ogImage={coverImage?.src}
  {extraSchema}
>
  <article class="post">
    {/* Referans: başlık bloğu koyu, makale gövdesi BEYAZ banttır. */}
    <header class="post__head">
      <div class="container post__inner">
        <nav class="post__crumbs" aria-label={t('nav.breadcrumb', locale)}>
          <a href={localizedPath('home', locale)}>{t('nav.home', locale)}</a>
          <span aria-hidden="true">/</span>
          <a href={localizedPath('blog', locale)}>{t('nav.blog', locale)}</a>
          <span aria-hidden="true">/</span>
          {/* Kategori merkezi varsa bağlantı; yoksa düz metin — kırık link üretilmez. */}
          {categoryHref ? <a href={categoryHref}>{category}</a> : <span>{category}</span>}
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        <p class="post__chip">{category}</p>
        <h1 class="post__title">{title}</h1>
        <p class="lead post__excerpt">{excerpt}</p>

        <div class="post__meta">
          <span class="post__meta-item">
            <svg
              class="post__meta-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="3.5"></circle>
              <path d="M5 19.5c1.4-3.1 4-4.5 7-4.5s5.6 1.4 7 4.5" stroke-linecap="round"></path>
            </svg>
            {author}
          </span>
          <span class="post__meta-item">
            <svg
              class="post__meta-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect>
              <path d="M3.5 9.5h17M8 3.5v3M16 3.5v3" stroke-linecap="round"></path>
            </svg>
            {updated && `${t('blog.updated', locale)} `}
            <time datetime={isoDate(updated ?? date)}>{formatDate(updated ?? date, locale)}</time>
          </span>
          <span class="post__meta-item">
            <svg
              class="post__meta-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="8.5"></circle>
              <path d="M12 7.5V12l3 2" stroke-linecap="round"></path>
            </svg>
            {minutes}
            {t('blog.readingTime', locale)}
          </span>
        </div>
      </div>
    </header>

    <div class="post__article">
      {/* Kapak LCP adayıdır: lazy DEĞİL, öncelikli ve ölçüleri sabit (CLS yok). */}
      {
        coverImage && (
          <div class:list={['container', isEditorial ? 'post__wide' : 'post__inner']}>
            <div class="post__cover">
              <Picture
                src={coverImage}
                alt={post.data.coverAlt ?? title}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[640, 1024, 1440, 1920]}
                sizes="(max-width: 720px) 100vw, (max-width: 1180px) 92vw, 1080px"
                quality={74}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        )
      }

      {
        isEditorial ? (
          <div class="container">
            <div class="post__grid">
              <BlogQuickAnswer
                quickAnswer={article?.quickAnswer}
                tocHeading={article?.tocHeading ?? t('blog.toc', locale)}
                items={tocItems}
              />

              <ArticleBlocks {blocks} />

              <RelatedArticles heading={t('blog.related', locale)} posts={relatedPosts} {locale} />

              <p class="post__back-row">
                <a href={localizedPath('blog', locale)} class="btn btn--outline">
                  {t('cta.allPosts', locale)}
                </a>
              </p>
            </div>
          </div>
        ) : (
          <div class="container post__inner">
            <div class="post__body">
              <Content />
            </div>

            {/* Klasik şablonda da ilgili yazılar basılır — aksi halde bu yazılar
                blog ağına hiç bağlanmıyor, karşılığında bağlantı da almıyordu. */}
            <RelatedArticles heading={t('blog.related', locale)} posts={relatedPosts} {locale} />

            <a href={localizedPath('blog', locale)} class="btn btn--outline post__back">
              {t('cta.allPosts', locale)}
            </a>
          </div>
        )
      }
    </div>

    {
      /* Referans: makalenin ardından koyu, ortalanmış uygulama CTA'sı gelir.
        Editorial modda dönüşüm bloğu içerikten (`cta` bloğu) geldiği için bu
        sabit bant gösterilmez — aynı sayfada iki CTA yığını olmaz. */
    }
    <section class="post__cta" hidden={isEditorial}>
      <div class="container post__cta-inner">
        <h2 class="post__cta-heading">{t('blog.applyHeading', locale)}</h2>
        <div class="post__cta-actions">
          <CtaButton
            label={t('cta.whatsapp', locale)}
            href="https://wa.me/905065229034"
            variant="primary"
            icon="whatsapp"
            external
          />
          <CtaButton label={t('cta.quoteFormal', locale)} href={localizedPath('contact', locale)} variant="outline" />
          <CtaButton
            label={t('blog.exploreServices', locale)}
            href={localizedPath('services', locale)}
            variant="link"
          />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post__head {
    padding: clamp(40px, 5vw, 64px) 0 clamp(40px, 5vw, 56px);
  }

  /* Referans: makale gövdesi beyaz bant içinde akar. */
  .post__article {
    background: var(--bg-light);
    color: var(--text-on-light);
    padding: clamp(48px, 6vw, 72px) 0 clamp(72px, 9vw, 110px);
  }

  .post__inner {
    max-width: 820px;
  }

  /* Kapak, editorial modda okuma kolonundan geniş medya hattını kullanır. */
  .post__wide {
    max-width: calc(1080px + var(--gutter) * 2);
  }

  /*
   * Editorial ızgara: metin blokları ideal okuma genişliğinde (≈72ch) kalır,
   * görsel / tablo / kart / süreç blokları "wide" hattına taşar. Böylece uzun
   * satır oluşmadan geniş alan kullanılır ve sağda ölü boşluk kalmaz.
   */
  .post__grid {
    --reading: 720px;
    --wide: 1080px;
    --bleed: calc((var(--wide) - var(--reading)) / 2);

    display: grid;
    /*
     * Metin hattının alt sınırı `min(100%, --reading)`: yer daraldığında önce
     * kenar (bleed) kolonları sıfıra iner, okuma kolonu gereksiz daralmaz.
     * Böylece ayrı bir kırılım noktasına gerek kalmaz.
     */
    grid-template-columns:
      [wide-start] minmax(0, var(--bleed))
      [text-start] minmax(min(100%, var(--reading)), var(--reading)) [text-end]
      minmax(0, var(--bleed)) [wide-end];
    justify-content: center;
  }

  .post__grid > :global(*) {
    grid-column: text;
    min-width: 0;
  }

  /* Geniş hatta taşan bloklar (bileşen kök sınıflarıyla hedeflenir). */
  .post__grid > :global(.ai),
  .post__grid > :global(.ac),
  .post__grid > :global(.at),
  .post__grid > :global(.ap),
  .post__grid > :global(.ag),
  .post__grid > :global(.ah),
  .post__grid > :global(.ax),
  .post__grid > :global(.ra),
  .post__grid > :global(.bq) {
    grid-column: wide;
  }

  .post__back-row {
    margin: clamp(40px, 5vw, 64px) 0 0;
  }

  .post__crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    /* Bağlantılara dikey padding eklendi; alt boşluk ondan düşüldü. */
    margin-bottom: 11px;
  }

  .post__crumbs a {
    /* Dokunma hedefi 24 px'e tamamlanır (WCAG 2.5.8); satır yüksekliği 17 px kalıyordu.
       Dolgu eklenince satır 8 px büyüdüğü için alt boşluk aynı kadar kısıldı.
       `min-width` kısa etiketler için: "SEO" kırıntısı 23,98 px kalıyordu. */
    padding-block: 4px;
    min-width: 24px;
    color: var(--text-faint);
    text-decoration: none;
    /* Dokunma hedefi: 13px metin tek başına ~17px yükseklik veriyordu. */
    padding-block: 5px;
    transition: color var(--t-base);
  }

  .post__crumbs a:hover {
    color: var(--accent);
  }

  .post__crumbs [aria-current] {
    color: var(--text-soft);
  }

  /* Referans: blog başlığı 44px'e kadar, 1.2 satır yüksekliğinde. */
  .post__title {
    margin: 22px 0 0;
    font: 600 clamp(28px, 4vw, 44px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .post__excerpt {
    margin-top: 20px;
  }

  /* Kategori rozeti: lime ince çerçeve, koyu zeminde lime metin (kontrast yeterli). */
  .post__chip {
    display: inline-block;
    margin: 0;
    padding: 6px 14px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    font: 600 var(--fs-eyebrow) var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-top: 24px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
    font: 500 13.5px var(--font-display);
    color: var(--text-faint);
  }

  .post__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .post__meta-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  /*
   * Sticky header çıpa hedeflerini örtüyordu; kaydırma bu kadar erken durur.
   * `scroll-behavior` global olarak tanımlıysa yumuşak kaydırma oradan gelir.
   */
  .post__grid :global([id]) {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .post__cover {
    margin-top: 0;
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .post__cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Referans: makale metni 18px/1.75 ve koyu renklidir (beyaz bant üstünde). */
  .post__body {
    margin-top: 36px;
    font-size: 18px;
    line-height: 1.75;
    color: rgba(10, 10, 10, 0.8);
  }

  .post__cover + .post__body {
    margin-top: 40px;
  }

  .post__body :global(h2) {
    margin: 44px 0 16px;
    font: 600 clamp(22px, 2.4vw, 28px) / 1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-on-light);
  }

  .post__body :global(h3) {
    margin: 32px 0 12px;
    font: 600 19px var(--font-display);
    color: var(--text-on-light);
  }

  .post__body :global(p) {
    margin: 0 0 20px;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0 0 22px;
    padding-left: 22px;
  }

  .post__body :global(li) {
    margin-bottom: 10px;
  }

  .post__body :global(strong) {
    color: var(--text-on-light);
  }

  .post__body :global(a) {
    color: var(--text-on-light);
  }

  .post__body :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--accent);
    font-size: 17px;
    color: rgba(10, 10, 10, 0.75);
  }

  /*
   * Sveltia'nın markdown serileştiricisi, alıntı içindeki boş `>` ayırıcı satırını
   * kaydederken `> >` yapıyor; bu da not kutusunun içine BOŞ bir iç içe alıntı
   * bloğu basıyor. Tasarım dilinde iç içe alıntı hiç kullanılmadığı için, içerik
   * tekrar CMS'ten kaydedilip yeniden bozulsa bile görünmesin diye gizleniyor.
   */
  .post__body :global(blockquote blockquote) {
    display: none;
  }

  .post__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-media);
  }

  /*
   * Markdown gövdeli yazılardaki tablolar. Blok şemalı yazılar tabloyu `ArticleTable`
   * ile çizer; düz markdown gövdesi ise doğrudan `<table>` üretiyor ve HİÇ stili yoktu.
   * Kural `LegalPage.astro` ile aynı: `display: block` tabloyu kendi kaydırma kutusuna
   * çevirir, böylece taşma sayfaya değil tablonun içinde kalır.
   */
  .post__body :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
    margin: 0 0 24px;
    font-size: 14px;
  }

  .post__body :global(table:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .post__body :global(thead),
  .post__body :global(tbody) {
    min-width: 32rem;
  }

  .post__body :global(th),
  .post__body :global(td) {
    border: 1px solid rgba(10, 10, 10, 0.15);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }

  .post__body :global(th) {
    font: 600 13px var(--font-display);
    background: var(--bg-tint);
    color: var(--text-on-light);
  }

  .post__back {
    margin-top: 44px;
    border-color: rgba(10, 10, 10, 0.25);
    color: var(--text-on-light);
  }

  .post__back:hover {
    border-color: var(--text-on-light);
    color: var(--text-on-light);
  }

  /* --- Makale sonu koyu CTA bandı --- */
  .post__cta {
    padding: clamp(64px, 8vw, 100px) 0;
  }

  .post__cta-inner {
    max-width: 820px;
    text-align: center;
  }

  .post__cta-heading {
    margin: 0;
    font: 600 clamp(26px, 3.4vw, 38px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .post__cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }

  .post__cta-actions :global(.btn) {
    font-size: 15px;
    padding: 16px 28px;
  }

  @media (max-width: 720px) {
    .post__cta-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
