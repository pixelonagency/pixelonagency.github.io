---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from './CtaButton.astro';
import { formatDate, isoDate, readingTime } from '../lib/format';
import { localizedPath, type Locale } from '../lib/i18n';
import { t } from '../lib/ui';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { post, locale, alternates } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, category, date, author, cover, seo } = post.data;

const minutes = readingTime(post.body ?? '');

const coverImage: ImageMetadata | undefined =
  cover && typeof cover === 'object' && 'src' in cover ? (cover as ImageMetadata) : undefined;
---

<BaseLayout
  title={seo?.title ?? `${title} | Pixelon Blog`}
  description={seo?.description ?? excerpt}
  ogType="article"
  {locale}
  {alternates}
>
  <article class="post">
    {/* Referans: başlık bloğu koyu, makale gövdesi BEYAZ banttır. */}
    <header class="post__head">
      <div class="container post__inner">
        <nav class="post__crumbs" aria-label={t('nav.breadcrumb', locale)}>
          <a href={localizedPath('home', locale)}>{t('nav.home', locale)}</a>
          <span aria-hidden="true">/</span>
          <a href={localizedPath('blog', locale)}>{t('nav.blog', locale)}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        <p class="eyebrow">{category}</p>
        <h1 class="post__title">{title}</h1>
        <p class="lead post__excerpt">{excerpt}</p>

        <div class="post__meta">
          <span>{author}</span>
          <span aria-hidden="true">•</span>
          <time datetime={isoDate(date)}>{formatDate(date, locale)}</time>
          <span aria-hidden="true">•</span>
          <span>{minutes} {t('blog.readingTime', locale)}</span>
        </div>
      </div>
    </header>

    <div class="post__article">
      <div class="container post__inner">
        {
          coverImage && (
            <div class="post__cover">
              <Image src={coverImage} alt={title} width={1200} height={675} />
            </div>
          )
        }

        <div class="post__body">
          <Content />
        </div>

        <a href={localizedPath('blog', locale)} class="btn btn--outline post__back">{t('cta.allPosts', locale)}</a>
      </div>
    </div>

    {/* Referans: makalenin ardından koyu, ortalanmış uygulama CTA'sı gelir. */}
    <section class="post__cta">
      <div class="container post__cta-inner">
        <h2 class="post__cta-heading">{t('blog.applyHeading', locale)}</h2>
        <div class="post__cta-actions">
          <CtaButton
            label={t('cta.whatsapp', locale)}
            href="https://wa.me/905065229034"
            variant="primary"
            icon="whatsapp"
            external
          />
          <CtaButton label={t('cta.quoteFormal', locale)} href={localizedPath('contact', locale)} variant="outline" />
          <CtaButton
            label={t('blog.exploreServices', locale)}
            href={localizedPath('services', locale)}
            variant="link"
          />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post__head {
    padding: clamp(40px, 5vw, 64px) 0 clamp(40px, 5vw, 56px);
  }

  /* Referans: makale gövdesi beyaz bant içinde akar. */
  .post__article {
    background: var(--bg-light);
    color: var(--text-on-light);
    padding: clamp(48px, 6vw, 72px) 0 clamp(72px, 9vw, 110px);
  }

  .post__inner {
    max-width: 820px;
  }

  .post__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    margin-bottom: 24px;
  }

  .post__crumbs a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--t-base);
  }

  .post__crumbs a:hover {
    color: var(--accent);
  }

  .post__crumbs [aria-current] {
    color: var(--text-soft);
  }

  /* Referans: blog başlığı 44px'e kadar, 1.2 satır yüksekliğinde. */
  .post__title {
    margin: 22px 0 0;
    font: 600 clamp(28px, 4vw, 44px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .post__excerpt {
    margin-top: 20px;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
    font: 500 13.5px var(--font-display);
    color: var(--text-faint);
  }

  .post__cover {
    margin-top: 0;
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .post__cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Referans: makale metni 18px/1.75 ve koyu renklidir (beyaz bant üstünde). */
  .post__body {
    margin-top: 36px;
    font-size: 18px;
    line-height: 1.75;
    color: rgba(10, 10, 10, 0.8);
  }

  .post__cover + .post__body {
    margin-top: 40px;
  }

  .post__body :global(h2) {
    margin: 44px 0 16px;
    font: 600 clamp(22px, 2.4vw, 28px) / 1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-on-light);
  }

  .post__body :global(h3) {
    margin: 32px 0 12px;
    font: 600 19px var(--font-display);
    color: var(--text-on-light);
  }

  .post__body :global(p) {
    margin: 0 0 20px;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0 0 22px;
    padding-left: 22px;
  }

  .post__body :global(li) {
    margin-bottom: 10px;
  }

  .post__body :global(strong) {
    color: var(--text-on-light);
  }

  .post__body :global(a) {
    color: var(--text-on-light);
  }

  .post__body :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--accent);
    font-size: 17px;
    color: rgba(10, 10, 10, 0.75);
  }

  /*
   * Sveltia'nın markdown serileştiricisi, alıntı içindeki boş `>` ayırıcı satırını
   * kaydederken `> >` yapıyor; bu da not kutusunun içine BOŞ bir iç içe alıntı
   * bloğu basıyor. Tasarım dilinde iç içe alıntı hiç kullanılmadığı için, içerik
   * tekrar CMS'ten kaydedilip yeniden bozulsa bile görünmesin diye gizleniyor.
   */
  .post__body :global(blockquote blockquote) {
    display: none;
  }

  .post__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-media);
  }

  .post__back {
    margin-top: 44px;
    border-color: rgba(10, 10, 10, 0.25);
    color: var(--text-on-light);
  }

  .post__back:hover {
    border-color: var(--text-on-light);
    color: var(--text-on-light);
  }

  /* --- Makale sonu koyu CTA bandı --- */
  .post__cta {
    padding: clamp(64px, 8vw, 100px) 0;
  }

  .post__cta-inner {
    max-width: 820px;
    text-align: center;
  }

  .post__cta-heading {
    margin: 0;
    font: 600 clamp(26px, 3.4vw, 38px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .post__cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }

  .post__cta-actions :global(.btn) {
    font-size: 15px;
    padding: 16px 28px;
  }

  @media (max-width: 720px) {
    .post__cta-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
