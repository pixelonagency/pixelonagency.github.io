---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatTurkishDate, isoDate, readingTime } from '../lib/format';
import { localizedPath, type Locale } from '../lib/i18n';
import { t } from '../lib/ui';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { post, locale, alternates } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, category, date, author, cover, seo } = post.data;

const minutes = readingTime(post.body ?? '');

const coverImage: ImageMetadata | undefined =
  cover && typeof cover === 'object' && 'src' in cover ? (cover as ImageMetadata) : undefined;
---

<BaseLayout title={seo?.title ?? `${title} | Pixelon Blog`} description={seo?.description ?? excerpt} ogType="article">
  <article class="post">
    <div class="container post__inner">
      <nav class="post__crumbs" aria-label="Site haritası">
        <a href="/">Ana Sayfa</a>
        <span aria-hidden="true">/</span>
        <a href="/blog">Blog</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>

      <p class="eyebrow">{category}</p>
      <h1 class="h1 post__title">{title}</h1>
      <p class="lead post__excerpt">{excerpt}</p>

      <div class="post__meta">
        <span>{author}</span>
        <span aria-hidden="true">•</span>
        <time datetime={isoDate(date)}>{formatTurkishDate(date)}</time>
        <span aria-hidden="true">•</span>
        <span>{minutes} dk okuma</span>
      </div>

      {
        coverImage && (
          <div class="post__cover">
            <Image src={coverImage} alt={title} width={1200} height={675} />
          </div>
        )
      }

      <div class="post__body">
        <Content />
      </div>

      <a href="/blog" class="btn btn--outline post__back">← Tüm Yazılar</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: clamp(48px, 6vw, 84px) 0 clamp(60px, 7vw, 96px);
  }

  .post__inner {
    max-width: 820px;
  }

  .post__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    margin-bottom: 24px;
  }

  .post__crumbs a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--t-base);
  }

  .post__crumbs a:hover {
    color: var(--accent);
  }

  .post__crumbs [aria-current] {
    color: var(--text-soft);
  }

  .post__title {
    font-size: clamp(30px, 4vw, 50px);
  }

  .post__excerpt {
    margin-top: 20px;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
    font: 500 13.5px var(--font-display);
    color: var(--text-faint);
  }

  .post__cover {
    margin-top: 32px;
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .post__cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .post__body {
    margin-top: 36px;
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .post__body :global(h2) {
    margin: 44px 0 16px;
    font: 600 clamp(23px, 2.6vw, 30px) var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .post__body :global(h3) {
    margin: 32px 0 12px;
    font: 600 19px var(--font-display);
    color: var(--text);
  }

  .post__body :global(p) {
    margin: 0 0 20px;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0 0 22px;
    padding-left: 22px;
  }

  .post__body :global(li) {
    margin-bottom: 10px;
  }

  .post__body :global(strong) {
    color: var(--text);
  }

  .post__body :global(a) {
    color: var(--accent);
  }

  .post__body :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--accent);
    font-size: 17px;
    color: var(--text-soft);
  }

  /*
   * Sveltia'nın markdown serileştiricisi, alıntı içindeki boş `>` ayırıcı satırını
   * kaydederken `> >` yapıyor; bu da not kutusunun içine BOŞ bir iç içe alıntı
   * bloğu basıyor. Tasarım dilinde iç içe alıntı hiç kullanılmadığı için, içerik
   * tekrar CMS'ten kaydedilip yeniden bozulsa bile görünmesin diye gizleniyor.
   */
  .post__body :global(blockquote blockquote) {
    display: none;
  }

  .post__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-media);
  }

  .post__back {
    margin-top: 44px;
  }
</style>
