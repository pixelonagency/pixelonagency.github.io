---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import logo from '../assets/logo/pixelon-logo.webp';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../lib/i18n';
import { menuServices } from '../lib/nav';
import { serviceHref, t } from '../lib/ui';
import { telHref } from '../lib/whatsapp';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const settingsEntry =
  (await getEntry('settings', `${locale}/site`)) ?? (await getEntry('settings', `${DEFAULT_LOCALE}/site`));
if (!settingsEntry) throw new Error(`src/content/settings/${DEFAULT_LOCALE}/site.yml bulunamadı.`);
const settings = settingsEntry.data;

const allServices = await getCollection('services');
const inLocale = allServices.filter((entry) => entry.id.startsWith(`${locale}/`));
const scoped = inLocale.length > 0 ? inLocale : allServices.filter((e) => e.id.startsWith(`${DEFAULT_LOCALE}/`));
/* Header ile aynı liste: `menu: false` işaretli hizmetler footer'da da görünmez. */
const serviceLinks = menuServices(scoped).map((entry) => ({
  label: entry.data.navLabel,
  href: serviceHref(entry.id.split('/').slice(1).join('/'), locale),
}));

const corporateLinks = [
  { label: t('nav.about', locale), href: localizedPath('about', locale) },
  { label: t('nav.projects', locale), href: localizedPath('projects', locale) },
  { label: t('nav.references', locale), href: `${localizedPath('projects', locale)}#referanslar` },
  { label: t('nav.careers', locale), href: localizedPath('careers', locale) },
  { label: t('nav.contact', locale), href: localizedPath('contact', locale) },
  { label: t('nav.blog', locale), href: localizedPath('blog', locale) },
  /*
   * Web sitesi açılış sayfası hiçbir gezinme öğesinde yer almıyordu ve yalnız
   * sitemap üzerinden erişilebiliyordu (Semrush: "orphaned sitemap page").
   * Footer her sayfada olduğu için sayfa hem tarama derinliğinde öne çıkar hem de
   * site içi bağlantı değeri alır.
   */
  { label: t('nav.website', locale), href: localizedPath('website', locale) },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Image src={logo} alt={t('brand.logoAltShort', locale)} height={32} densities={[1, 2]} />
        <p class="site-footer__intro">{settings.footerIntro}</p>
        <div class="site-footer__social">
          {
            /*
             * Görünen kısaltma ("IG") aria-hidden; erişilebilir ad tam marka adından
             * ("Instagram") gelir. aria-label ile kısaltmayı çakıştırmak, görünen etiket
             * ile erişilebilir adın uyuşmaması sorununu doğuruyordu.
             */
            settings.social.map((item) => (
              <a href={item.url} class="site-footer__social-link" rel="noopener noreferrer" target="_blank">
                <span aria-hidden="true">{item.short ?? item.label.slice(0, 2).toUpperCase()}</span>
                <span class="visually-hidden">{item.label}</span>
              </a>
            ))
          }
        </div>
        <a href={localizedPath('analysis', locale)} class="site-footer__cta">{t('nav.analysis', locale)}</a>
      </div>

      <div>
        <h2 class="site-footer__heading">{t('footer.corporate', locale)}</h2>
        <div class="site-footer__links">
          {corporateLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>

      <div>
        <h2 class="site-footer__heading">{t('footer.services', locale)}</h2>
        <div class="site-footer__links">
          {serviceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>

      <div>
        <h2 class="site-footer__heading">{t('footer.contact', locale)}</h2>
        <address class="site-footer__contact">
          <a href={`mailto:${settings.email}`}>{settings.email}</a>
          <a href={telHref(settings.phone)}>{settings.phone}</a>
          <span>{settings.address}</span>
        </address>
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__legal">
        {settings.legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        {/* Klaro consent modalını yeniden açar — yeni sayfaya gitmez. */}
        <button type="button" class="site-footer__consent" data-cookie-prefs>
          {t('footer.cookiePrefs', locale)}
        </button>
      </div>
      <div class="site-footer__copy">{settings.copyright}</div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-footer);
    border-top: 1px solid var(--border-faint);
    padding: clamp(56px, 7vw, 88px) var(--gutter) 32px;
  }

  .site-footer__inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--gap-section);
  }

  .site-footer__brand {
    grid-column: span 1;
    min-width: 260px;
  }

  .site-footer__intro {
    margin: 20px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.55);
    max-width: 320px;
  }

  .site-footer__social {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--text);
    text-decoration: none;
    font: 600 12px var(--font-display);
    transition:
      border-color var(--t-slow),
      color var(--t-slow);
  }

  .site-footer__social-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .site-footer__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    background: var(--accent);
    color: var(--text-on-light);
    font: 600 13.5px var(--font-display);
    padding: 11px 20px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background var(--t-slow);
  }

  .site-footer__cta:hover {
    background: var(--text);
    color: var(--text-on-light);
  }

  .site-footer__heading {
    font: 600 13px var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    /* Bağlantılara dikey padding eklendi; satır aralığı ondan düşüldü ki
       liste ritmi aynı kalsın. */
    gap: 1px;
  }

  .site-footer__links a,
  .site-footer__contact a,
  .site-footer__contact span {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 14px;
    transition: color var(--t-base);
  }

  /* Dokunma hedefi: 14px metin tek başına ~16px yükseklik veriyordu
     (WCAG 2.2 AA asgari 24px). */
  .site-footer__links a {
    display: block;
    padding-block: 5px;
  }

  .site-footer__links a:hover,
  .site-footer__contact a:hover {
    color: var(--accent);
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    /* Bağlantılara dikey padding eklendi; aralık ondan düşüldü. */
    gap: 4px;
    font-size: 14px;
    font-style: normal;
  }

  /* Dokunma hedefi: 14px metin tek başına ~16px yükseklik veriyordu. */
  .site-footer__contact a {
    display: inline-block;
    padding-block: 5px;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 26px;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  /* Çerez Tercihleri butonu yasal linklerle aynı dilde görünür. */
  .site-footer__consent {
    background: none;
    border: none;
    /* Dokunma hedefi: 12px metin ~13px yükseklik veriyordu. */
    padding: 6px 0;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    /* 0.45 alfa #050505 üzerinde 4.49:1 veriyordu — WCAG AA eşiği 4.5. 0.50 → 5.30:1. */
    color: rgba(255, 255, 255, 0.5);
    transition: color var(--t-base);
  }

  .site-footer__consent:hover,
  .site-footer__consent:focus-visible {
    color: var(--accent);
  }

  .site-footer__legal a {
    color: var(--text-faint);
    text-decoration: none;
    font-size: 12px;
    /* Dokunma hedefi: consent butonuyla aynı yükseklik. */
    padding-block: 6px;
    transition: color var(--t-base);
  }

  .site-footer__legal a:hover {
    color: var(--accent);
  }

  .site-footer__copy {
    color: var(--text-faint);
    font-size: 12px;
  }

  /* Dokunmatik hedef: 29px'lik metin bağlantısı parmakla isabetli
     tıklanamıyordu. Apple HIG ve WCAG 2.5.5 en az 44px öneriyor; dikey
     dolgu yalnız dokunmatik girdide artırılır, masaüstü tipografisi
     değişmez. Aynı kalıp `.pb-filter` için zaten kullanılıyordu. */
  @media (pointer: coarse) {
    .site-footer__consent {
      min-height: 44px;
      padding-block: 11px;
    }
  }
</style>
