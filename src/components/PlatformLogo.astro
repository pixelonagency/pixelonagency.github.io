---
/**
 * Reklam platformlarının marka işaretleri.
 *
 * Yol verisi Simple Icons'tan (CC0-1.0) alınmış, tek renk `currentColor` ile
 * basılır — böylece kart durumuna göre renk değiştirebilir. Bir ikon kütüphanesi
 * BAĞIMLILIĞI eklenmedi; yalnız yedi marka işaretinin yolu buraya gömüldü
 * (CLAUDE.md: "gerekirse minimal inline SVG").
 *
 * Markalar üçüncü taraf tescilli işaretlerdir; burada yalnız "bu platformlarda
 * reklam yönetiyoruz" demek için, tanımlayıcı kullanım kapsamında geçer.
 */
export type PlatformName = 'google' | 'instagram' | 'facebook' | 'tiktok' | 'yandex' | 'linkedin' | 'snapchat';

/** Marka öz rengi — kart üzerine gelindiğinde logo bu renge geçer. */
export const PLATFORM_COLORS: Record<PlatformName, string> = {
  google: '#4285F4',
  instagram: '#E4405F',
  facebook: '#0866FF',
  tiktok: '#25F4EE',
  yandex: '#FC3F1D',
  linkedin: '#0A66C2',
  snapchat: '#FFFC00',
};

/** Erişilebilir ad — logo tek başına anlam taşımaz. */
const PLATFORM_LABELS: Record<PlatformName, string> = {
  google: 'Google Ads',
  instagram: 'Instagram',
  facebook: 'Facebook',
  tiktok: 'TikTok',
  yandex: 'Yandex',
  linkedin: 'LinkedIn',
  snapchat: 'Snapchat',
};

interface Props {
  name: PlatformName;
}

const { name }: Props = Astro.props;
