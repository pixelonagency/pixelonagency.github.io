---
import { Image } from 'astro:assets';
import type { PageSection } from '../../content/page-schema';

type Showreel = Extract<PageSection, { type: 'showreel' }>;

interface Props {
  section: Showreel;
}

const { section } = Astro.props;
/*
 * Kesintisiz döngü: liste iki kez basılır ve şerit tam yarısı kadar kaydırılır
 * (@keyframes marquee -> translateX(-50%)). İkinci kopya ekran okuyucudan
 * gizlidir, yoksa her marka iki kez okunur.
 */
const COPIES = [0, 1];
const variant = section.variant ?? 'wide';

/*
 * Poster yolu. `image` alanı Astro'nun görsel hattından geçtiği için nesne
 * döner; ham string olarak bırakılırsa poster boş kalır.
 */
const posterSrc = (image: unknown): string | undefined => {
  if (typeof image === 'string') return image;
  if (image && typeof image === 'object' && 'src' in image) return String((image as { src: unknown }).src);
  return undefined;
};

/*
 * Videolar sayfa açılışında DEĞİL, şerit görünür olunca yükleniyor ve
 * oynuyor. Bant iki kopya basıldığı için ekranda on altı video var; hepsini
 * peşinen indirip aynı anda çözmek mobilde sayfayı kilitliyordu. Bölüm
 * görüş alanından çıkınca hepsi duruyor. Hareket kapalıysa hiç oynatılmaz.
 */
const REEL_VIDEO_SCRIPT = `
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root) return;
  const videos = root.querySelectorAll('video[data-reel-video]');
  if (!videos.length) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  let loaded = false;
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        if (!loaded) {
          loaded = true;
          videos.forEach((v) => { v.src = v.dataset.src; v.load(); });
        }
        videos.forEach((v) => v.play().catch(() => {}));
      } else {
        videos.forEach((v) => v.pause());
      }
    }
  }, { rootMargin: '200px' });
  io.observe(root);
})();
`;
---

<section class:list={['reel', `reel--${variant}`]} aria-label={section.heading ?? 'Tasarladığımız web siteleri'}>
  {
    (section.eyebrow || section.heading) && (
      <div class="reel__head">
        {section.eyebrow && <p class="reel__eyebrow">{section.eyebrow}</p>}
        {section.heading && <h2 class="reel__heading">{section.heading}</h2>}
      </div>
    )
  }

  <div class="reel__viewport">
    <div class="reel__track">
      {
        COPIES.map((copy) => (
          <ul class="reel__group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {section.items.map((item) => (
              <li class="reel__item">
                <a class="reel__link" href={item.href} tabindex={copy === 1 ? -1 : undefined}>
                  {item.video ? (
                    /*
                     * Sessiz, döngülü ve satır içi oynayan kısa önizleme. Tam
                     * video vaka sayfasında; buradaki yalnız 5 saniyelik kesit.
                     * `preload="none"` — bant boyunca sekiz video var, hepsi
                     * peşinen indirilirse sayfa açılışını yer.
                     */
                    <video
                      class="reel__shot"
                      data-reel-video
                      data-src={item.video}
                      poster={posterSrc(item.image)}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                      tabindex="-1"
                    />
                  ) : (
                    <Image
                      class="reel__shot"
                      src={item.image as never}
                      alt={item.alt ?? `${item.label} web sitesi`}
                      widths={[520, 1040]}
                      sizes="(max-width: 720px) 78vw, 520px"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span class="reel__label">
                    {item.label}
                    <span class="reel__arrow" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
{section.items.some((item) => item.video) && <script is:inline set:html={REEL_VIDEO_SCRIPT} data-reel-video-boot />}

<style>
  .reel {
    padding: clamp(38px, 5vw, 64px) 0 clamp(30px, 4vw, 48px);
    background: var(--bg);
    overflow: hidden;
  }

  .reel__head {
    max-width: var(--container);
    margin: 0 auto clamp(24px, 3vw, 36px);
    padding: 0 clamp(20px, 6vw, 80px);
  }

  .reel__eyebrow {
    margin: 0 0 10px;
    font: 600 12px var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .reel__heading {
    margin: 0;
    font: 600 clamp(24px, 3vw, 36px) / 1.14 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }

  /* Kenarlarda yumuşak kesme — şerit ekrandan çıkarken sertçe kopmasın. */
  .reel__viewport {
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 6%, black 94%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 6%, black 94%, transparent 100%);
  }

  .reel__track {
    display: flex;
    width: max-content;
    animation: marquee 58s linear infinite;
  }

  .reel:hover .reel__track,
  .reel:focus-within .reel__track {
    animation-play-state: paused;
  }

  .reel__group {
    display: flex;
    flex-shrink: 0;
    align-items: flex-start;
    gap: clamp(18px, 2.4vw, 34px);
    padding: 0 clamp(9px, 1.2vw, 17px) 0 0;
    margin: 0;
    list-style: none;
  }

  .reel__item {
    flex: 0 0 auto;
    width: clamp(280px, 34vw, 520px);
  }

  .reel__link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /*
   * Mockup'lar saydam PNG/WebP — kutu, çerçeve veya zemin VERİLMEZ, yoksa
   * dizüstü silüetinin etrafında beyaz bir dikdörtgen belirir.
   */
  .reel__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .reel__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding-left: 4px;
    font: 600 15px var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-muted);
    transition: color 0.3s;
  }

  .reel__arrow {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  .reel__link:hover,
  .reel__link:focus-visible {
    transform: translateY(-8px);
  }

  .reel__link:hover .reel__label,
  .reel__link:focus-visible .reel__label {
    color: var(--text);
  }

  .reel__link:hover .reel__arrow,
  .reel__link:focus-visible .reel__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .reel__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 6px;
  }

  /*
   * Hareket kapalıyken bant kendi kendine akmaz; kullanıcı yatay olarak
   * kaydırır. İkinci kopya gizlenir, yoksa liste iki kez görünür.
   */
  @media (prefers-reduced-motion: reduce) {
    .reel__viewport {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .reel__track {
      animation: none;
    }

    .reel__group[aria-hidden='true'] {
      display: none;
    }
  }

  /* Kart genişliği varyanta göre: mockup geniş, sosyal ızgara kare, reel dar. */
  .reel--square .reel__item {
    width: clamp(230px, 24vw, 360px);
  }

  .reel--reel .reel__item {
    width: clamp(160px, 17vw, 250px);
  }

  .reel--reel .reel__shot,
  .reel--square .reel__shot {
    border-radius: 14px;
  }

  /*
   * Kare varyantta kaynak görsellerin oranı değişken (0,60 ile 1,95 arası).
   * Serbest bırakılınca kartlar farklı yüksekliklerde kalıp şerit dalgalanıyor;
   * oran sabitlenip merkezden kırpılıyor.
   */
  .reel--square .reel__shot {
    aspect-ratio: 6 / 5;
    object-fit: cover;
  }

  /* Videolar tek tip yükseklikte dursun diye oran sabitleniyor. */
  .reel--reel .reel__shot {
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }

  /*
   * Ardışık iki şerit tek blok gibi okunmalı. Varsayılan dolgu üst üste
   * gelince aralarında 112px ölü boşluk kalıyordu.
   */
  .reel + .reel {
    padding-top: clamp(10px, 1.4vw, 18px);
  }
</style>
