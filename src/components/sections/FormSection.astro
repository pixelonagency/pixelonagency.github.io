---
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import SectionHead from '../SectionHead.astro';
import ContactFormFields from './ContactFormFields.astro';
import Section from './Section.astro';

type Form = Extract<PageSection, { type: 'form' }>;

interface Props {
  section: Form;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

  <ContactFormFields
    formId={section.formId}
    heading={section.heading}
    submitLabel={section.submitLabel}
    successHeading={section.successHeading}
    successBody={section.successBody}
    successNote={section.successNote}
    successCtas={section.successCtas}
    errorHeading={section.errorHeading}
    errorBody={section.errorBody}
    {locale}
  />
</Section>
