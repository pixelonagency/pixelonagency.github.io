---
import type { PageSection } from '../../content/page-schema';
import ContactIcon from '../ContactIcon.astro';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type ContactInfo = Extract<PageSection, { type: 'contactInfo' }>;

interface Props {
  section: ContactInfo;
}

const { section } = Astro.props;

/*
 * `value` alanının ilk satırı kanalın kendisidir (numara, adres, şehir), varsa
 * kalan satırlar açıklamadır. İkisi ayrı tipografiyle basılır; içerik tarafında
 * ikinci bir alan tutulmuyor çünkü kısa kullanımlarda (Biz Kimiz, Hizmetlerimiz)
 * değer tek satır ve açıklama hiç yok.
 */
const splitValue = (value: string): { head: string; body: string | undefined } => {
  const [head = '', ...rest] = value.split('\n');
  const body = rest.join(' ').trim();
  return { head: head.trim(), body: body.length > 0 ? body : undefined };
};

const items = section.items.map((item) => ({ ...item, ...splitValue(item.value) }));
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

  <dl class="contact-info">
    {
      items.map((item, index) => (
        <div class="contact-info__item" data-reveal data-reveal-index={index}>
          {item.icon && (
            <span class="contact-info__icon" aria-hidden="true">
              <ContactIcon name={item.icon} />
            </span>
          )}
          <div class="contact-info__text">
            <dt class="contact-info__label">{item.label}</dt>
            <dd class="contact-info__value">
              {/*
               * Bağlantı, kartın tamamını kaplayan yayılmış bir tıklama alanıdır
               * (::after). Böylece kartın her yeri tıklanabilir ama erişilebilirlik
               * ağacında tek bir bağlantı görünür.
               */}
              {item.href ? (
                <a class="contact-info__link" href={item.href}>
                  {item.head}
                </a>
              ) : (
                item.head
              )}
              {item.body && <span class="contact-info__body">{item.body}</span>}
            </dd>
          </div>
          {item.href && (
            <span class="contact-info__arrow" aria-hidden="true">
              →
            </span>
          )}
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--gap-card);
    margin: 0;
  }

  .contact-info__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 26px;
    transition:
      border-color var(--t-slow),
      background var(--t-slow),
      transform var(--t-slow);
  }

  .contact-info__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 10px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    transition: background var(--t-base);
  }

  /* İkonsuz maddede metin sütunu ilk hücreye kayar — boş bir kutu bırakılmaz. */
  .contact-info__item:not(:has(.contact-info__icon)) .contact-info__text {
    grid-column: 1 / 3;
  }

  .contact-info__label {
    margin: 0;
    font: 600 var(--fs-eyebrow) var(--font-display);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  .contact-info__value {
    margin: 10px 0 0;
    font: 600 var(--fs-lead) / 1.35 var(--font-display);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .contact-info__body {
    display: block;
    margin-top: 10px;
    font: 400 14.5px / 1.6 var(--font-body);
    letter-spacing: 0;
    color: var(--text-muted);
  }

  .contact-info__link {
    /* Dokunma hedefi 24 px (WCAG 2.5.8) — bağımsız bir hedef, cümle içi değil. */
    display: inline-block;
    padding-block: 2px;
    color: inherit;
    text-decoration: none;
    transition: color var(--t-base);
  }

  /* Yayılmış tıklama alanı — kartın tamamı bağlantı gibi davranır. */
  .contact-info__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .contact-info__arrow {
    align-self: center;
    font-size: 18px;
    line-height: 1;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--t-base),
      transform var(--t-base);
  }

  .contact-info__item:hover,
  .contact-info__item:focus-within {
    border-color: var(--accent);
    transform: translateY(-6px);
  }

  .contact-info__item:hover .contact-info__arrow,
  .contact-info__item:focus-within .contact-info__arrow {
    opacity: 1;
    transform: none;
  }

  .contact-info__item:hover .contact-info__icon {
    background: rgb(207 255 0 / 16%);
  }

  /*
   * Dört veya daha fazla kanal varsa ilki tam genişlikte bir panele dönüşür:
   * birincil kanal (WhatsApp/telefon) diğerleriyle aynı boyutta durunca sayfada
   * hangisinden yazılacağı hiç belli olmuyordu. Üç ve daha az maddede tek sıra
   * kalır, bu yüzden kural `:has()` ile madde sayısına bağlanmıştır.
   */
  .contact-info:has(.contact-info__item:nth-child(4)) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .contact-info:has(.contact-info__item:nth-child(4)) .contact-info__item:first-child {
    grid-column: 1 / -1;
    align-items: center;
    gap: 24px;
    padding: 30px 32px;
    background: rgb(207 255 0 / 5%);
    border-color: rgb(207 255 0 / 26%);
  }

  .contact-info:has(.contact-info__item:nth-child(4)) .contact-info__item:first-child .contact-info__icon {
    width: 58px;
    height: 58px;
    padding: 13px;
    border-radius: 16px;
  }

  .contact-info:has(.contact-info__item:nth-child(4)) .contact-info__item:first-child .contact-info__value {
    font-size: clamp(22px, 2.4vw, 30px);
  }

  .contact-info:has(.contact-info__item:nth-child(4)) .contact-info__item:first-child .contact-info__body {
    max-width: 62ch;
  }

  /* Açık zeminli varyant */
  :global(.section--light) .contact-info__item {
    border-color: var(--border-on-light);
  }

  :global(.section--light) .contact-info__item:hover,
  :global(.section--light) .contact-info__item:focus-within {
    border-color: var(--text-on-light);
  }

  :global(.section--light) .contact-info__label {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .contact-info__value {
    color: var(--text-on-light);
  }

  :global(.section--light) .contact-info__body {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .contact-info__icon {
    background: rgb(10 10 10 / 6%);
    color: var(--text-on-light);
  }

  :global(.section--light) .contact-info__item:hover .contact-info__icon {
    background: rgb(10 10 10 / 10%);
  }

  :global(.section--light) .contact-info__arrow {
    color: var(--text-on-light);
  }

  :global(.section--light) .contact-info__link:hover {
    color: var(--text-muted-on-light);
  }

  @media (max-width: 900px) {
    .contact-info,
    .contact-info:has(.contact-info__item:nth-child(4)) {
      grid-template-columns: 1fr;
    }

    /*
     * Tek sütunda birincil kartın metni uzayınca ortalanmış ikon kartın
     * ortasında havada kalıyor; üste hizalanıyor.
     */
    .contact-info:has(.contact-info__item:nth-child(4)) .contact-info__item:first-child {
      align-items: start;
      padding: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-info__item,
    .contact-info__arrow,
    .contact-info__icon {
      transition: none;
    }

    .contact-info__item:hover,
    .contact-info__item:focus-within {
      transform: none;
    }
  }

  /*
   * Referans (Biz Kimiz / kapanış): CTA bloğunu hemen izleyen iletişim bilgisi kart
   * ızgarası DEĞİL, üst çizgili ortalanmış tek satırdır — aynı bloğun devamı gibi.
   * Bu görünüm yalnızca bitişiklikte devreye girer; bağımsız kullanımlar kart kalır.
   */
  :global(.section:has(.cta-box) + .section) .contact-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px 32px;
    max-width: 900px;
    margin: 0 auto;
    border-top: 1px solid var(--border);
    padding-top: 28px;
  }

  :global(.section:has(.cta-box) + .section) .contact-info__item {
    display: block;
    border: none;
    border-radius: 0;
    padding: 0;
    text-align: center;
  }

  /* Sıkışık satır varyantında ikon ve ok basılmaz — satır tek satır kalmalı. */
  :global(.section:has(.cta-box) + .section) .contact-info__icon,
  :global(.section:has(.cta-box) + .section) .contact-info__arrow {
    display: none;
  }

  :global(.section:has(.cta-box) + .section) .contact-info__item:hover,
  :global(.section:has(.cta-box) + .section) .contact-info__item:focus-within {
    border-color: transparent;
    transform: none;
  }

  :global(.section:has(.cta-box) + .section) .contact-info__label {
    font: 600 12px var(--font-display);
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.45);
  }

  :global(.section:has(.cta-box) + .section) .contact-info__value {
    margin-top: 8px;
    font: 600 18px var(--font-display);
  }
</style>
