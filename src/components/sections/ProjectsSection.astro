---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../lib/i18n';
import { ALL_CATEGORY, buildCategoryFilters, sortProjects } from '../../lib/projects';
import { slugify } from '../../lib/slug';
import { t } from '../../lib/ui';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';
import ProjectsBoard from './ProjectsBoard.astro';

type Projects = Extract<PageSection, { type: 'projects' }>;

interface Props {
  section: Projects;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

/**
 * Girdi kimliği `<locale>/<slug>`. Bu dilde proje yoksa varsayılan dildekiler gösterilir —
 * aksi halde İngilizce sayfada her proje iki kez (TR + EN) listelenirdi.
 */
const all = await getCollection('projects');
const inLocale = all.filter((entry) => entry.id.startsWith(`${locale}/`));
const entries = inLocale.length > 0 ? inLocale : all.filter((entry) => entry.id.startsWith(`${DEFAULT_LOCALE}/`));
/*
 * Slug ve `detail` varlığı veriyle birlikte taşınır: kart, case study sayfası
 * olan projelerde ona bağlanır (board görünümünün zaten yaptığı şey). Olmayanda
 * bağlantı basılmaz — kırık link üretilmez.
 */
const withMeta = entries.map((entry) => ({
  ...entry.data,
  slug: entry.id.split('/').slice(1).join('/'),
  hasDetail: Boolean(entry.data.detail),
}));
const sorted = sortProjects(withMeta);

/*
 * `slugs` verilmişse yalnızca o projeler, VERİLEN SIRAYLA basılır. Hizmet
 * sayfaları bunu kullanır: reklam sayfasında yalnızca reklam işi yapılan
 * vakalar çıkmalı. Eşleşmeyen slug sessizce düşer — silinmiş bir proje
 * sayfayı kırmaz.
 */
const bySlug = new Map(withMeta.map((project) => [project.slug, project]));
const picked = section.slugs?.length
  ? section.slugs.map((slug) => bySlug.get(slug)).filter((p): p is NonNullable<typeof p> => Boolean(p))
  : sorted;
const limited = section.limit ? picked.slice(0, section.limit) : picked;

// `cover` şemada çözümleyici fonksiyonla tanımlandığı için tipi genişler —
// <Image /> için tekrar daraltıyoruz.
const projects = limited.map((project) => ({
  ...project,
  cover: project.cover as ImageMetadata | undefined,
}));

// Filtre etiketleri projelerin kendi `categoryLabel` alanından toplanır;
// "hepsi" sözde kategorisinin etiketi ise arayüz sözlüğünden gelir.
const labels: Record<string, string> = { [ALL_CATEGORY]: t('projects.all', locale) };
for (const project of projects) {
  if (project.categoryLabel) labels[project.category] ??= project.categoryLabel;
}

const filters = section.showFilters ? buildCategoryFilters(projects, labels) : [];
const showCta = Boolean(section.ctaLabel && section.ctaHref);

/*
 * Listeleme modunda (showFilters) referans tasarım öne çıkan projeyi ızgaranın
 * üstünde lime çerçeveli bir vitrin kartında gösterir; ızgara kalan projeleri basar.
 */
const spotlight = section.showFilters ? projects.find((project) => project.featured) : undefined;
const gridProjects = spotlight ? projects.filter((project) => project !== spotlight) : projects;

/* Koyu bölümlerde kartlar açık (dolgusuz); açık bölümlerde koyu dolgulu (ana sayfa). */
const openCards = section.background === 'dark';

// Aynı sayfada birden fazla proje bölümü olabilir — id'ler bölüme özel olmalı.
const uid = slugify(section.anchor ?? section.heading) || 'projeler';
const panelId = `${uid}-panel`;
const tabId = (slug: string) => `${uid}-tab-${slug}`;
---

{section.kind === 'board' && <ProjectsBoard {section} {locale} />}
{
  section.kind !== 'board' && projects.length > 0 && (
    <Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
      {/* Referans: başlık solda, bölüm bağlantısı sağda — taban çizgisine hizalı. */}
      <div class="projects__head">
        <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />
        {showCta && (
          <a class="btn btn--outline projects__head-cta" href={section.ctaHref}>
            {section.ctaLabel}
          </a>
        )}
      </div>

      <div class="projects" data-projects>
        {filters.length > 0 && (
          <div class="projects__filterbar">
            <div class="projects__filters" role="tablist" aria-label={t('projects.categories', locale)}>
              {filters.map((filter) => {
                const selected = filter.slug === ALL_CATEGORY;
                return (
                  <button
                    type="button"
                    role="tab"
                    id={tabId(filter.slug)}
                    class="projects__pill"
                    data-filter={filter.slug}
                    aria-selected={selected ? 'true' : 'false'}
                    aria-controls={panelId}
                    tabindex={selected ? 0 : -1}
                  >
                    <span>{filter.label}</span>
                    <span class="projects__count">{filter.count}</span>
                  </button>
                );
              })}
            </div>
          </div>
        )}

        {spotlight && (
          <article class="projects__spot" data-reveal aria-labelledby={`${uid}-spot-title`}>
            <div class="projects__spot-media">
              {spotlight.cover ? (
                <Image
                  src={spotlight.cover}
                  alt={spotlight.title}
                  loading="lazy"
                  decoding="async"
                  class="projects__image"
                />
              ) : (
                <div class="projects__placeholder" aria-hidden="true">
                  <span>{spotlight.client}</span>
                </div>
              )}
            </div>
            <div>
              {spotlight.categoryLabel && <p class="projects__spot-tag">{spotlight.categoryLabel}</p>}
              <h3 class="projects__spot-title" id={`${uid}-spot-title`}>
                {spotlight.title}
              </h3>
              <p class="projects__spot-excerpt">{spotlight.excerpt}</p>
              {spotlight.tags.length > 0 && (
                <div class="projects__spot-pills">
                  {spotlight.tags.map((tag) => (
                    <span class="projects__spot-pill">{tag}</span>
                  ))}
                </div>
              )}
              {spotlight.url && (
                <a class="projects__link" href={spotlight.url} target="_blank" rel="noopener noreferrer">
                  {t('projects.view', locale)} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        )}

        <div
          class="projects__grid"
          style={section.columns ? `--cols: ${section.columns}` : undefined}
          id={panelId}
          role={filters.length > 0 ? 'tabpanel' : undefined}
          aria-labelledby={filters.length > 0 ? tabId(ALL_CATEGORY) : undefined}
          tabindex={filters.length > 0 ? 0 : undefined}
        >
          {gridProjects.map((project, index) => (
            <article
              class:list={['projects__card', openCards && 'projects__card--open']}
              data-category={project.category}
              data-reveal
              data-reveal-index={index}
              aria-labelledby={`${uid}-title-${index}`}
            >
              <div class="projects__media">
                {project.cover ? (
                  <Image
                    src={project.cover}
                    alt={project.title}
                    loading="lazy"
                    decoding="async"
                    class="projects__image"
                  />
                ) : (
                  <div class="projects__placeholder" aria-hidden="true">
                    <span>{project.client}</span>
                  </div>
                )}
              </div>

              <div class="projects__body">
                {project.categoryLabel &&
                  (openCards ? (
                    <p class="projects__cat">{project.categoryLabel}</p>
                  ) : (
                    <div class="projects__tags">
                      {project.categoryLabel.split('·').map((tag) => (
                        <span class="projects__tag">{tag.trim()}</span>
                      ))}
                    </div>
                  ))}
                <h3 class="projects__title" id={`${uid}-title-${index}`}>
                  {project.title}
                </h3>
                <p class="projects__excerpt">{project.excerpt}</p>
                {openCards && project.tags.length > 0 && (
                  <div class="projects__minis">
                    {project.tags.slice(0, 4).map((tag) => (
                      <span class="projects__mini">{tag}</span>
                    ))}
                  </div>
                )}
                {project.hasDetail ? (
                  <a class="projects__link" href={localizedPath('projects', locale, project.slug)}>
                    {t('projects.view', locale)} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  project.url && (
                    <a class="projects__link" href={project.url} target="_blank" rel="noopener noreferrer">
                      {t('projects.view', locale)} <span aria-hidden="true">→</span>
                    </a>
                  )
                )}
              </div>
            </article>
          ))}
        </div>

        <p class="projects__empty" data-empty role="status" hidden>
          {t('projects.empty', locale)}
        </p>
      </div>
    </Section>
  )
}

<style>
  /* --- Filtre çubuğu --- */
  .projects__filterbar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .projects__filters {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-header);
    backdrop-filter: blur(10px);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .projects__filters::-webkit-scrollbar {
    display: none;
  }

  .projects__pill {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-soft);
    font: 600 var(--fs-small) var(--font-display);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background var(--t-base),
      border-color var(--t-base),
      color var(--t-base);
  }

  .projects__pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .projects__pill[aria-selected='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text-on-light);
  }

  .projects__count {
    font-size: 11px;
    line-height: 1;
    padding: 3px 7px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .projects__pill[aria-selected='true'] .projects__count {
    background: rgb(0 0 0 / 0.14);
    color: var(--text-on-light);
  }

  .projects__grid:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  /* --- Başlık satırı: solda başlık, sağda outline bağlantı (referans düzeni) --- */
  .projects__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }

  .projects__head :global(.section-head) {
    max-width: 760px;
    margin-bottom: 0;
  }

  .projects__head + .projects {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .projects__head-cta {
    flex-shrink: 0;
    font-size: 15px;
    padding: 15px 28px;
  }

  :global(.section--light) .projects__head-cta {
    border-color: rgba(10, 10, 10, 0.25);
    color: var(--text-on-light);
  }

  /* --- Öne çıkan proje vitrini (listeleme sayfası) --- */
  .projects__spot {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    border: 1px solid rgba(207, 255, 0, 0.35);
    border-radius: 24px;
    padding: clamp(24px, 3vw, 40px);
    background: radial-gradient(ellipse 70% 90% at 0% 0%, rgba(207, 255, 0, 0.06), transparent 60%);
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .projects__spot-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 16px;
  }

  .projects__spot-media :global(.projects__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .projects__spot-tag {
    margin: 0;
    font: 600 12px var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .projects__spot-title {
    margin: 16px 0 0;
    font: 600 clamp(24px, 2.6vw, 34px) / 1.2 var(--font-display);
    color: var(--text);
  }

  .projects__spot-excerpt {
    margin: 18px 0 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .projects__spot-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .projects__spot-pill {
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--text-soft);
    font: 600 12px var(--font-display);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
  }

  .projects__spot > div > .projects__link {
    margin-top: 22px;
  }

  @media (max-width: 860px) {
    .projects__spot {
      grid-template-columns: 1fr;
    }
  }

  /* --- Izgara --- */
  /*
   * Varsayılan `auto-fit`: kart sayısı kadar sütun açılır. `--cols` verilirse
   * sütun sayısı sabitlenir — az sayıda vakayı geniş göstermek için (2×2).
   */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, auto-fit), minmax(300px, 1fr));
    gap: 28px;
  }

  /* Referans (listeleme): koyu zeminde kartlar dolgusuz ve çerçevesizdir. */
  .projects__card--open {
    background: transparent;
    border-radius: 0;
    overflow: visible;
  }

  :global(.section--dark) .projects__card--open {
    border: none;
  }

  .projects__card--open .projects__media {
    border-radius: 14px;
    height: auto;
    aspect-ratio: 16 / 11;
  }

  .projects__card--open .projects__body {
    padding: 22px 4px 4px;
    gap: 10px;
  }

  .projects__cat {
    margin: 0;
    font: 600 12px var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .projects__card--open .projects__title {
    font-size: 20px;
  }

  .projects__minis {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .projects__mini {
    font: 500 11.5px var(--font-display);
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 5px 11px;
    border-radius: var(--radius-pill);
  }

  /* Referans: kartlar beyaz zemin üstünde DOLGULU koyu bloklar — çerçevesiz, r20. */
  .projects__card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-radius: 20px;
    overflow: hidden;
    transition: transform var(--t-slow);
  }

  .projects__card[hidden] {
    display: none;
  }

  .projects__card:hover {
    transform: translateY(-6px);
  }

  /* Koyu bölümlerde kartın zeminden ayrışması için ince çerçeve. */
  :global(.section--dark) .projects__card {
    border: 1px solid var(--border-faint);
  }

  .projects__media {
    position: relative;
    height: 280px;
    overflow: hidden;
  }

  .projects__media :global(.projects__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }

  .projects__card:hover .projects__media :global(.projects__image) {
    transform: scale(1.05);
  }

  .projects__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    background: var(--accent-soft);
    color: var(--accent);
    font: 600 var(--fs-body) var(--font-display);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .projects__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
    padding: 28px;
  }

  .projects__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .projects__tag {
    /* 11px mobilde okunaklılık alt sınırının altındaydı (min 12px). */
    font: 500 12px var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(207, 255, 0, 0.35);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
  }

  .projects__title {
    margin: 0;
    font: 600 22px var(--font-display);
    color: var(--text);
    text-wrap: balance;
  }

  .projects__excerpt {
    flex: 1;
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
  }

  .projects__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font: 600 14px var(--font-display);
    text-decoration: none;
    transition: gap var(--t-slow);
  }

  .projects__link:hover {
    gap: 14px;
    color: var(--accent);
  }

  .projects__empty {
    margin: 32px 0 0;
    font-size: var(--fs-lead);
    color: var(--text-muted);
  }

  /* --- Açık zeminli varyant --- */
  :global(.section--light) .projects__filters {
    background: var(--bg-light);
    border-color: var(--border-on-light);
  }

  :global(.section--light) .projects__pill {
    border-color: var(--border-on-light);
    color: var(--text-on-light);
  }

  :global(.section--light) .projects__pill:hover {
    border-color: var(--text-on-light);
    color: var(--text-on-light);
  }

  :global(.section--light) .projects__count {
    background: rgb(10 10 10 / 0.08);
    color: var(--text-on-light);
  }

  :global(.section--light) .projects__empty {
    color: var(--text-muted-on-light);
  }

  @media (max-width: 720px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }

    .projects__head-cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Kategori filtresi: eşleşmeyen kartlar `hidden` ile hem görsel hem erişilebilirlik
  // ağacından çıkarılır. Durum URL'de saklanmaz.
  const ALL_CATEGORY = 'tumu';

  for (const root of document.querySelectorAll<HTMLElement>('[data-projects]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    if (tabs.length === 0) continue;

    const cards = [...root.querySelectorAll<HTMLElement>('[data-category]')];
    const panel = root.querySelector<HTMLElement>('.projects__grid');
    const empty = root.querySelector<HTMLElement>('[data-empty]');

    const select = (slug: string, moveFocus = false) => {
      let visible = 0;

      for (const card of cards) {
        const matches = slug === ALL_CATEGORY || card.dataset.category === slug;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      for (const tab of tabs) {
        const isSelected = tab.dataset.filter === slug;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        if (isSelected) {
          if (panel && tab.id) panel.setAttribute('aria-labelledby', tab.id);
          if (moveFocus) tab.focus();
          tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      }

      if (empty) empty.hidden = visible > 0;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.filter ?? ALL_CATEGORY));

      tab.addEventListener('keydown', (event: KeyboardEvent) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        let next = -1;

        if (step !== 0) next = (index + step + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;

        event.preventDefault();
        select(tabs[next]?.dataset.filter ?? ALL_CATEGORY, true);
      });
    });
  }
</script>
