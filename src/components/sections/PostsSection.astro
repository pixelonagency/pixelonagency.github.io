---
import type { ImageMetadata } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Posts = Extract<PageSection, { type: 'posts' }>;
type PostEntry = CollectionEntry<'posts'>;

interface Props {
  section: Posts;
  locale?: Locale;
  /**
   * Hazır yazı listesi. Verilirse koleksiyon HİÇ okunmaz ve sıralama olduğu gibi
   * korunur — kategori sayfası gibi kendi süzgecini uygulayan çağıranlar için.
   * Verilmezse bölüm eskisi gibi tüm yayınlanmış yazıları kendisi toplar.
   */
  entries?: PostEntry[];
}

const { section, locale = DEFAULT_LOCALE, entries: provided } = Astro.props;

const slugOf = (id: string) => id.split('/').slice(1).join('/');

// Yalnızca yayınlanmış yazılar; en yeniden en eskiye.
// Girdi kimliği `<locale>/<slug>`; bu dilde yazı yoksa varsayılan dildekiler listelenir.
const collected = provided ?? (await collect());

async function collect(): Promise<PostEntry[]> {
  const all = await getCollection('posts', ({ data }) => data.status === 'published');
  const inLocale = all.filter((entry) => entry.id.startsWith(`${locale}/`));
  const scoped = inLocale.length > 0 ? inLocale : all.filter((entry) => entry.id.startsWith(`${DEFAULT_LOCALE}/`));

  return [...scoped].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
}

const posts = section.limit ? collected.slice(0, section.limit) : collected;

const hasCta = Boolean(section.ctaLabel && section.ctaHref);

/** Kapak alanı opsiyonel; kapağı olmayan yazı kartı görselsiz akar. */
const coverOf = (value: unknown): ImageMetadata | undefined =>
  value && typeof value === 'object' && 'src' in (value as Record<string, unknown>)
    ? (value as ImageMetadata)
    : undefined;
---

{
  posts.length > 0 && (
    <Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
      {/* Referans: başlık solda, "Tüm Yazıları İnceleyin →" düz bağlantısı sağ altta hizalı. */}
      <div class="posts__head">
        <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />
        {hasCta && (
          <a class="posts__head-link" href={section.ctaHref}>
            {section.ctaLabel} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>

      <ul class="posts" role="list">
        {posts.map((post, index) => {
          const cover = coverOf(post.data.cover);
          return (
            <li class="posts__cell">
              <a
                class="posts__item"
                href={localizedPath('blog', locale, slugOf(post.id))}
                data-reveal
                data-reveal-index={index}
              >
                {cover && (
                  <span class="posts__media">
                    <Picture
                      src={cover}
                      alt={post.data.coverAlt ?? post.data.title}
                      formats={['avif']}
                      fallbackFormat="webp"
                      widths={[320, 480, 720]}
                      sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 33vw"
                      quality={70}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}
                {/* Metin sarmalayıcı: ilk kart yatay düzene geçtiğinde görselin
                    yanında tek blok olarak durabilmesi için gerekli. */}
                <span class="posts__body">
                  <span class="posts__category">{post.data.category}</span>
                  <h3 class="posts__title">{post.data.title}</h3>
                  <p class="posts__excerpt">{post.data.excerpt}</p>
                  <span class="posts__read">
                    {t('blog.readPost', locale)} <span aria-hidden="true">→</span>
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </Section>
  )
}

<style>
  /* Referans: bu bölümün başlığı bir kademe küçüktür (max 46px). */
  .posts__head :global(.section-head .h2) {
    font-size: clamp(30px, 3.6vw, 46px);
  }

  .posts__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }

  .posts__head :global(.section-head) {
    margin-bottom: 0;
  }

  .posts__head + .posts {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .posts__head-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    /* Dokunma hedefi: 15px metin ~20px yükseklik veriyordu. */
    padding-block: 5px;
    color: var(--text);
    font: 600 15px var(--font-display);
    text-decoration: none;
    transition: gap var(--t-slow);
  }

  .posts__head-link:hover {
    gap: 14px;
  }

  :global(.section--light) .posts__head-link {
    color: var(--text-on-light);
  }

  /*
   * İlk yazı öne çıkar: tam genişlikte, görseli solda duran yatay bir kart olur;
   * kalanlar altında eşit sütunlara dizilir. Eşit üç kutu bölümü sıradan bir
   * kart ızgarasına çeviriyordu, oysa blog vitrininde bir "manşet" olmalı.
   */
  .posts {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap-card);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts__cell {
    grid-column: span 2;
  }

  .posts__cell:first-child {
    grid-column: 1 / -1;
  }

  /* Üç yazıda kalan ikisi yarımşar sütun kaplar, yoksa sıra yarım kalır. */
  .posts:has(.posts__cell:nth-child(3)):not(:has(.posts__cell:nth-child(4))) .posts__cell:not(:first-child) {
    grid-column: span 3;
  }

  .posts__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media (min-width: 861px) {
    .posts__cell:first-child .posts__item {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }

    .posts__cell:first-child .posts__media {
      flex: 0 0 46%;
      margin: 0;
      border-radius: 0;
    }

    .posts__cell:first-child .posts__media :global(img) {
      height: 100%;
      aspect-ratio: auto;
      min-height: 320px;
    }

    .posts__cell:first-child .posts__body {
      justify-content: center;
      padding: clamp(28px, 3vw, 42px);
    }

    .posts__cell:first-child .posts__title {
      font-size: clamp(24px, 2.4vw, 34px);
    }
  }

  .posts__cell {
    display: flex;
  }

  /* Referans: kartlar krem dolgulu (#f5f5ef) ve çerçevesizdir; koyu zeminde çerçeveli kalır. */
  .posts__item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--t-slow),
      transform var(--t-slow);
  }

  /* Kapak kartın üst kenarına yaslanır: kart dolgusu negatif marjla iptal edilir.
     Sabit 16/9 oranı, kaynak oranı ne olursa olsun kartları aynı hizada tutar. */
  .posts__media {
    display: block;
    margin: -30px -30px 4px;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    overflow: hidden;
    background: rgb(255 255 255 / 4%);
  }

  .posts__media :global(img) {
    display: block;
    width: 100%;
    /* `height: auto` şart: Astro `height` özniteliği yazıyor ve o kalırsa
       yükseklik kesin sayılıp `aspect-ratio` yok sayılıyor. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease-out);
  }

  .posts__item:hover .posts__media :global(img) {
    transform: scale(1.03);
  }

  .posts__item:hover {
    border-color: var(--accent);
    transform: translateY(-6px);
  }

  :global(.section--light) .posts__item {
    background: var(--bg-tint);
    border-color: transparent;
  }

  :global(.section--light) .posts__item:hover {
    border-color: var(--border-on-light);
  }

  .posts__category {
    /* 11px mobilde okunaklılık alt sınırının altındaydı (min 12px). */
    font: 600 12px var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .posts__title {
    margin: 0;
    font: 600 20px / 1.3 var(--font-display);
    color: var(--text);
  }

  .posts__excerpt {
    flex: 1;
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .posts__read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 14px var(--font-display);
    color: var(--text);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .posts__category {
    color: rgba(10, 10, 10, 0.5);
  }

  :global(.section--light) .posts__title,
  :global(.section--light) .posts__read {
    color: var(--text-on-light);
  }

  :global(.section--light) .posts__excerpt {
    color: rgba(10, 10, 10, 0.65);
  }

  @media (max-width: 720px) {
    .posts {
      grid-template-columns: 1fr;
    }

    .posts__cell,
    .posts__cell:first-child,
    .posts:has(.posts__cell:nth-child(3)):not(:has(.posts__cell:nth-child(4))) .posts__cell:not(:first-child) {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .posts__item,
    .posts__media :global(img) {
      transition: none;
    }

    .posts__item:hover {
      transform: none;
    }

    .posts__item:hover .posts__media :global(img) {
      transform: none;
    }
  }

  /* Dokunmatik hedef: 29px'lik metin bağlantısı parmakla isabetli
     tıklanamıyordu. Apple HIG ve WCAG 2.5.5 en az 44px öneriyor; dikey
     dolgu yalnız dokunmatik girdide artırılır, masaüstü tipografisi
     değişmez. Aynı kalıp `.pb-filter` için zaten kullanılıyordu. */
  @media (pointer: coarse) {
    .posts__head-link {
      min-height: 44px;
      padding-block: 11px;
    }
  }
</style>
