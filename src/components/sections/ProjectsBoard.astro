---
/**
 * Proje vitrini — "board" görünümü (projeler sayfasının tam sayfa gövdesi).
 *
 * Yerleşim, sahibin verdiği wireframe'i izler (Desktop/Projelerimiz.png):
 *   kompakt hero (eyebrow + H1 + kısa metin + rozet satırı)
 *   → filtre pill'leri (aktif = lime)
 *   → 1. satır: yan yana İKİ büyük kart (7/5)
 *   → devamı: 3 kolonlu eşit kartlar.
 * Kart, kapak kompozisyonunun ÜZERİNE yazan overlay düzenidir: marka adı +
 * hizmet çipleri üstte, yıl + kısa açıklama altta (okunabilirlik için scrim).
 *
 * Portfolyonun temel birimi MARKA'dır: bir müşteriye verilen tüm hizmetler tek
 * case study kartında toplanır; filtreler çoklu üyelikle çalışır ve proje asla
 * çoğaltılmaz (bkz. src/lib/projects.ts → deriveServices).
 *
 * Kart, projenin case study içeriği (detail) varsa /projelerimiz/<slug>
 * detayına bağlanır; içerik girilmemiş projeler kırık link yayınlamamak
 * adına <article> olarak kalır.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../lib/i18n';
import { mediaUrl } from '../../lib/media';
import { breadcrumbSchema, toJsonLd } from '../../lib/schema';
import { t } from '../../lib/ui';
import {
  ALL_SERVICE_LABEL,
  deriveServices,
  SERVICE_KEYS,
  SERVICE_LABELS,
  sortProjects,
  type ServiceKey,
} from '../../lib/projects';

type ProjectsSectionData = Extract<PageSection, { type: 'projects' }>;

interface Props {
  section: ProjectsSectionData;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

const all = await getCollection('projects');
const inLocale = all.filter((entry) => entry.id.startsWith(`${locale}/`));
const entries = inLocale.length > 0 ? inLocale : all.filter((entry) => entry.id.startsWith(`${DEFAULT_LOCALE}/`));

const projects = sortProjects(
  entries.map((entry) => ({
    slug: entry.id.split('/').slice(1).join('/').replace(/\.md$/, ''),
    hasDetail: Boolean(entry.data.detail),
    title: entry.data.title,
    category: entry.data.category,
    client: entry.data.client,
    excerpt: entry.data.excerpt,
    cover: entry.data.cover as ImageMetadata | undefined,
    featured: entry.data.featured,
    order: entry.data.order,
    year: entry.data.year,
    services: deriveServices(entry.data.tags, entry.data.category),
  })),
).slice(0, section.limit ?? undefined);

/* Kart çipleri: en fazla 3 hizmet + kalan sayısı. */
const chipsFor = (keys: readonly ServiceKey[]): string[] => {
  const labels = keys.map((key) => SERVICE_LABELS[key][locale]);
  return labels.length <= 3 ? labels : [...labels.slice(0, 3), `+${labels.length - 3}`];
};

const filters: Array<{ key: ServiceKey | 'all'; label: string }> = [
  { key: 'all', label: ALL_SERVICE_LABEL[locale] },
  ...SERVICE_KEYS.map((key) => ({ key, label: SERVICE_LABELS[key][locale] })),
];

const viewLabel = section.ctaLabel ?? (locale === 'tr' ? 'Projeyi İncele' : 'View Project');
const emptyLabel =
  locale === 'tr'
    ? 'Bu kategoride yakında yeni projeler yayınlanacak.'
    : 'New projects in this category are coming soon.';

/* Görünen breadcrumb ile birebir aynı BreadcrumbList JSON-LD'si (HeroSection deseni). */
const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';
const breadcrumbJsonLd = toJsonLd([
  breadcrumbSchema([
    {
      label: locale === 'tr' ? 'Ana Sayfa' : 'Home',
      url: new URL(localizedPath('home', locale), site).toString(),
    },
    { label: section.heading },
  ]),
]);

/*
 * Board hero'sunun arka plan videosu. HeroSection ile aynı desen: viewport'a
 * göre TEK varyant indirilir (masaüstü varlığı mobile inmez), reduced-motion'da
 * video hiç yüklenmez ve poster kalır.
 */
const BOARD_VIDEO_SCRIPT = `
(() => {
  const video = document.currentScript.previousElementSibling.querySelector('.pb-hero__video');
  if (!video) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const d = video.dataset;
  const mobile = matchMedia('(max-width: 768px)').matches;
  const poster = mobile ? d.mPoster : d.dPoster;
  const webm = mobile ? d.mWebm : d.dWebm;
  const mp4 = mobile ? d.mMp4 : d.dMp4;
  if (poster) video.poster = poster;
  if (webm) { const s = document.createElement('source'); s.src = webm; s.type = 'video/webm'; video.appendChild(s); }
  if (mp4) { const s = document.createElement('source'); s.src = mp4; s.type = 'video/mp4'; video.appendChild(s); }
  video.load();
  const start = () => video.play().catch(() => {});
  video.readyState >= 3 ? start() : video.addEventListener('canplay', start, { once: true });
})();
`;
---

<section class:list={['section', 'pb-section']} id={section.anchor}>
  {
    section.video && (
      <>
        <div class="pb-hero__bg" aria-hidden="true">
          <video
            class="pb-hero__video"
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            data-d-mp4={mediaUrl(section.video.desktopMp4)}
            data-d-webm={mediaUrl(section.video.desktopWebm)}
            data-d-poster={mediaUrl(section.video.desktopPoster)}
            data-m-mp4={mediaUrl(section.video.mobileMp4)}
            data-m-webm={mediaUrl(section.video.mobileWebm)}
            data-m-poster={mediaUrl(section.video.mobilePoster)}
          />
          <span class="pb-hero__scrim" />
        </div>
        {/*
        Script arka plan bloğunun HEMEN ARDINDA ve KOŞULUN İÇİNDE durmalı — HeroSection
        ile birebir aynı desen. `document.currentScript.previousElementSibling` ile
        videoyu buluyor, yani bir önceki kardeşinin `.pb-hero__bg` olmasına bağımlı.
        Koşulun dışındayken videosuz sayfalarda — `/en/projects/`, içerikte video tanımlı
        değil — kardeş bulunamıyor ve script "Cannot read properties of null (reading
        'querySelector')" ile düşüyordu (1 Eyl 2026, dört genişlikte de).
      */}
        <script is:inline set:html={BOARD_VIDEO_SCRIPT} data-board-video />
      </>
    )
  }
  <div class="container">
    {/* ---------------------------------------------------------- HERO ---- */}
    <header class="pb-hero" data-reveal>
      <nav class="pb-crumbs" aria-label={t('nav.breadcrumb', locale)}>
        <a href={localizedPath('home', locale)}>{locale === 'tr' ? 'Ana Sayfa' : 'Home'}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{section.heading}</span>
      </nav>
      <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />
      {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
      <h1 class="h1 pb-hero__title">{section.heading}</h1>
      {section.lead && <p class="lead pb-hero__lead">{section.lead}</p>}
    </header>

    {/* -------------------------------------------------------- FILTER --- */}
    {
      section.showFilters && (
        <div
          class="pb-filters"
          role="group"
          aria-label={locale === 'tr' ? 'Projeleri filtrele' : 'Filter projects'}
          data-reveal
          data-reveal-index="1"
        >
          {filters.map((filter, index) => (
            <button
              type="button"
              class="pb-filter"
              data-filter={filter.key}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {filter.label}
            </button>
          ))}
        </div>
      )
    }

    {/* --------------------------------------------------------- BOARD --- */}
    {
      /*
       * Izgara BİLEREK scroll-reveal kullanmıyor. `data-reveal` tüm tahtaya tek parça
       * konunca gözlemcinin %12 eşiği "tahtanın %12'si görünsün" demek oluyordu; tahta
       * çok uzun olduğu için kartlar ancak bir ekran boyu kaydırdıktan sonra beliriyor,
       * sayfa ilk açılışta boş görünüyordu. Bunun yerine hero ile aynı anda, yükleme
       * animasyonuyla geliyor.
       */
    }
    <div class="pb-board pb-board--enter">
      {
        projects.map((project, index) => {
          const Tag = project.hasDetail ? 'a' : 'article';
          return (
            <Tag
              class="pb-card"
              data-services={project.services.join(' ')}
              {...(project.hasDetail ? { href: localizedPath('projects', locale, project.slug) } : {})}
            >
              {project.cover && (
                <Image
                  class="pb-card__img"
                  src={project.cover}
                  alt={project.title}
                  widths={[480, 800, 1200, 1600]}
                  quality={70}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
              )}
              <span class="pb-card__scrim" aria-hidden="true" />

              {/* Marka adı alt blokta: kapak görselleri sol üst köşede markanın
                  kendi logosunu taşıyor, başlık orada üstüne biniyordu. */}
              <span class="pb-card__bottom">
                <h2 class="pb-card__brand">{project.client}</h2>
                {project.year && <span class="pb-card__year">{project.year}</span>}
                <span class="pb-card__chips" role="list">
                  {chipsFor(project.services).map((chip) => (
                    <span role="listitem">{chip}</span>
                  ))}
                </span>
                <span class="pb-card__excerpt">{project.excerpt}</span>
              </span>

              {project.hasDetail && (
                <span class="pb-card__cta" aria-hidden="true">
                  {viewLabel}
                  <span class="pb-card__cta-arrow">→</span>
                </span>
              )}

              {project.hasDetail && (
                <span class="pb-card__corner" aria-hidden="true">
                  ↗
                </span>
              )}
            </Tag>
          );
        })
      }
      <p class="pb-empty body-text" hidden>{emptyLabel}</p>
    </div>
  </div>
</section>

<script>
  /* Filtre: çoklu üyelik, çoğaltma yok; fade + yeniden akış. */
  const board = document.querySelector<HTMLElement>('.pb-board');
  if (board) {
    const filters = document.querySelectorAll<HTMLButtonElement>('.pb-filter');
    const cards = [...board.querySelectorAll<HTMLElement>('.pb-card')];
    const empty = board.querySelector<HTMLElement>('.pb-empty');

    for (const button of filters) {
      button.addEventListener('click', () => {
        const key = button.dataset.filter ?? 'all';
        for (const other of filters) other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
        let visible = 0;
        for (const card of cards) {
          const show = key === 'all' || (card.dataset.services ?? '').split(' ').includes(key);
          card.classList.toggle('is-leaving', !show);
          if (show) {
            card.hidden = false;
            visible++;
            card.classList.remove('is-entering');
            void card.offsetWidth;
            card.classList.add('is-entering');
          } else {
            window.setTimeout(() => {
              if (card.classList.contains('is-leaving')) card.hidden = true;
            }, 220);
          }
        }
        if (empty) empty.hidden = visible > 0;
      });
    }
  }
</script>

<style>
  .pb-section {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(40px, 6vh, 72px));
  }

  /* Ana sayfa hero'suyla aynı zemin dili: lime parıltı + ince ızgara dokusu. */
  .pb-section::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: min(720px, 78vh);
    background-image:
      radial-gradient(ellipse 60% 50% at 75% 20%, rgb(207 255 0 / 10%), transparent 65%),
      linear-gradient(rgb(255 255 255 / 4.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4.5%) 1px, transparent 1px);
    background-size:
      100% 100%,
      72px 72px,
      72px 72px;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent);
    mask-image: linear-gradient(180deg, #000 55%, transparent);
    pointer-events: none;
  }

  .pb-section > .container {
    position: relative;
  }

  .pb-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    /* Dikey padding satır yüksekliğini büyüttüğü için margin ondan düşülür. */
    margin-bottom: 15px;
  }

  .pb-crumbs a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--t-slow);
    /* Dokunma hedefi: 13px metin tek başına ~17px yükseklik veriyordu. */
    padding-block: 7px;
  }

  .pb-crumbs a:hover {
    color: var(--accent);
  }

  .pb-crumbs [aria-current] {
    color: var(--text-soft);
  }

  /* -------------------------------------------------------------- hero --- */
  .pb-hero {
    max-width: 640px;
  }

  .pb-hero__title {
    margin-top: 14px;
  }

  .pb-hero__lead {
    margin-top: 14px;
  }

  /* ------------------------------------------------------------ filter --- */
  .pb-filters {
    position: sticky;
    top: calc(var(--header-h) + 8px);
    z-index: 5;
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 14px clamp(12px, 1.4vw, 18px);
    margin: clamp(24px, 4vh, 40px) 0 clamp(20px, 3vh, 32px);
    /*
     * Çubuk YAPIŞKAN: kaydırınca başlığın altına yapışır ve kartlar arkasından
     * geçer. Düz siyah zemin okunurluğu çözüyordu ama hero'da videonun üstünü
     * kapatıp konteyner genişliğinde sert bir bant bırakıyordu.
     *
     * Yerine saydam + arka plan bulanıklığı: video görünür kalıyor, kartlar
     * arkasından geçerken pill'ler yine okunuyor.
     */
    background: rgb(10 10 10 / 42%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: var(--radius-pill);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  /* Bulanıklık desteklenmiyorsa okunurluk için zemin koyulaştırılır. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .pb-filters {
      background: rgb(10 10 10 / 88%);
    }
  }

  .pb-filters::-webkit-scrollbar {
    display: none;
  }

  .pb-filter {
    flex: 0 0 auto;
    min-height: 40px;
    padding: 9px 20px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-soft);
    font: 500 var(--fs-small) var(--font-body);
    cursor: pointer;
    transition:
      background var(--t-slow),
      color var(--t-slow),
      border-color var(--t-slow);
  }

  .pb-filter:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .pb-filter[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text-on-light);
    font-weight: 600;
  }

  .pb-filter:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ------------------------------------------------------------- board --- */
  /* Hero ve filtrelerden hemen sonra, sayfa açılırken bir kez oynar. */
  .pb-board--enter {
    animation: fadeUp 0.8s var(--ease-out) 0.12s both;
  }

  .pb-board {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap-card);
  }

  /* Tek ritim: tüm kartlar eşit genişlikte ikili düzen. */
  .pb-card {
    grid-column: span 6;
  }

  .pb-card {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Tek metin bloğu var ve dibe yaslanır (üst blok kaldırıldı). */
    justify-content: flex-end;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    text-decoration: none;
    padding: clamp(18px, 2vw, 26px) clamp(18px, 2vw, 26px) 20px;
    aspect-ratio: 4 / 3;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .pb-card.is-leaving {
    opacity: 0;
    transform: scale(0.985);
    pointer-events: none;
  }

  .pb-card.is-entering {
    animation: pb-enter 0.32s ease;
  }

  @keyframes pb-enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .pb-card :global(.pb-card__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Okunabilirlik: her kapak üzerinde tutarlı üst+alt scrim. */
  .pb-card__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.72) 0%, rgba(10, 10, 10, 0.25) 26%, rgba(10, 10, 10, 0) 42%),
      linear-gradient(0deg, rgba(10, 10, 10, 0.92) 0%, rgba(10, 10, 10, 0.55) 38%, rgba(10, 10, 10, 0) 68%);
    transition: opacity 0.35s ease;
  }

  .pb-card__bottom {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Alt blok görselin en dibinden (20px) başlar; hover'da CTA'ya yer açmak
     için yukarı kayar. */
  .pb-card__bottom {
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .pb-card__brand {
    font: 600 clamp(20px, 2.2vw, 30px) var(--font-display);
    letter-spacing: -0.01em;
    text-shadow: 0 2px 16px rgba(10, 10, 10, 0.65);
  }

  .pb-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pb-card__chips span {
    /* Kartlar tek ritimde genişledi; 10px mobilde okunaklılık sınırının
       altında kalıyordu (min 12px). */
    font: 600 12px var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    background: rgba(10, 10, 10, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    padding: 5px 11px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .pb-card__year {
    font: 500 var(--fs-small) var(--font-body);
    color: rgba(255, 255, 255, 0.75);
  }

  .pb-card__excerpt {
    font: 400 var(--fs-body) var(--font-body);
    color: #fff;
    text-shadow: 0 1px 10px rgba(10, 10, 10, 0.7);
    line-height: 1.5;
    max-width: 46ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Hover'da beliren lime CTA (wireframe'deki "Projeyi İncele" pill'i). */
  .pb-card__cta {
    position: absolute;
    left: clamp(18px, 2vw, 26px);
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--text-on-light);
    font: 600 var(--fs-small) var(--font-display);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .pb-card__cta-arrow {
    display: inline-flex;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--text-on-light);
    color: var(--accent);
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .pb-card__corner {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 600 16px var(--font-display);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease,
      color 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pb-card:hover :global(.pb-card__img) {
      transform: scale(1.03);
    }

    .pb-card:hover .pb-card__cta {
      opacity: 1;
      transform: translateY(0);
    }

    /* Açıklama+çipler, beliren CTA ile çakışmasın diye yukarı süzülür
       (yalnız detay bağlantılı kartlarda — CTA'sız kartta kayma olmaz). */
    .pb-card:has(.pb-card__cta):hover .pb-card__bottom {
      transform: translateY(-56px);
    }

    .pb-card:hover .pb-card__corner {
      opacity: 1;
      transform: translateY(0);
      background: var(--accent);
      border-color: var(--accent);
      color: var(--text-on-light);
    }
  }

  /* Dokunmatikte CTA akış içinde ve hep görünür — bilgi hover'a hapsolmaz. */
  @media (hover: none) {
    .pb-card {
      justify-content: flex-start;
    }
    .pb-card__bottom {
      margin-top: auto;
    }
    .pb-card__cta {
      position: static;
      align-self: flex-start;
      margin-top: 12px;
      opacity: 1;
      transform: none;
    }
  }

  a.pb-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  a.pb-card:focus-visible .pb-card__cta {
    opacity: 1;
    transform: translateY(0);
  }

  .pb-empty {
    grid-column: span 12;
    text-align: center;
    padding: 56px 0;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-card :global(.pb-card__img),
    .pb-card__cta,
    .pb-card__corner,
    .pb-card__bottom {
      transition: none;
    }
    .pb-card.is-entering {
      animation: none;
    }
  }

  /* -------------------------------------------------------- responsive --- */
  @media (max-width: 640px) {
    .pb-card {
      grid-column: span 12;

      /* Sabit 4/3 + overflow:hidden dar ekranda içeriği (çip + açıklama +
         CTA) kırpıyordu; oranı min-height taklit eder (kart genişliği ≈
