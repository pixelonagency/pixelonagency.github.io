---
import type { PageSection } from '../../content/page-schema';
import PrincipleIcon from '../PrincipleIcon.astro';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Principles = Extract<PageSection, { type: 'principles' }>;

interface Props {
  section: Principles;
}

const { section } = Astro.props;
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

  <ul class="prin" role="list">
    {
      section.items.map((item, index) => (
        <li class="prin__card" data-reveal data-reveal-index={index}>
          {/*
            Zemin ayrı bir katman: kart üzerine gelindiğinde alttan yukarı
            açılarak lime'a dönüyor. Doğrudan background geçişi yerine katman
            kullanılıyor ki hareketin bir YÖNÜ olsun.
          */}
          <span class="prin__fill" aria-hidden="true" />

          <span class="prin__icon">
            <PrincipleIcon name={item.icon} />
          </span>

          <div class="prin__body">
            <h3 class="prin__title">{item.title}</h3>
            <p class="prin__text">{item.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .prin {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .prin__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 20px;
    overflow: hidden;
    padding: 32px 28px;
    border: 1px solid var(--border-on-light);
    border-radius: var(--radius-card);
    background: var(--bg-tint);
    transition:
      transform var(--t-base),
      border-color var(--t-base);
  }

  .prin__card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
  }

  /* Lime zemin alttan yukarı açılır — hareketin yönü "yükseliyor" der. */
  .prin__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.34s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .prin__card:hover .prin__fill {
    transform: scaleY(1);
  }

  /*
   * İkon lime çerçeveli bir rozetin içinde durur: kart üzerine gelinmeden de
   * bölümde marka rengi vardır. Hover'da kart lime'a döndüğünde rozet tersine
   * çevrilir (koyu zemin, lime ikon) — böylece her iki durumda da kontrast
   * korunur ve rozet yüzeye gömülmez.
   */
  .prin__icon {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--text-on-light);
    transition:
      background var(--t-base),
      border-color var(--t-base),
      color var(--t-base);
  }

  .prin__card:hover .prin__icon {
    border-color: var(--bg);
    background: var(--bg);
    color: var(--accent);
  }

  .prin__icon :global(svg) {
    display: block;
    width: 30px;
    height: 30px;
  }

  /*
   * İkon üzerine gelindiğinde kendini çizer. Tüm yollar `pathLength="1"` ile
   * normalize edildiği için tek kural hepsinde aynı hızda çalışır.
   */
  .prin__icon :global(svg *) {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .prin__card:hover .prin__icon :global(svg *) {
    animation: prin-draw 0.7s cubic-bezier(0.65, 0, 0.35, 1);
  }

  @keyframes prin-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .prin__body {
    position: relative;
  }

  .prin__title {
    margin: 0 0 10px;
    font: 600 clamp(17px, 1.4vw, 20px) / 1.3 var(--font-display);
    color: var(--text-on-light);
  }

  .prin__text {
    margin: 0;
    font: 400 15px/1.65 var(--font-body);
    color: var(--text-muted-on-light);
    transition: color var(--t-base);
  }

  /* Lime zeminde gövde metni koyulaşır — krem tonunda okunmaz olurdu. */
  .prin__card:hover .prin__text {
    color: rgb(10 10 10 / 0.78);
  }

  /* Koyu zeminli bölümde kart tonları döner; lime dolgu aynı kalır. */
  :global(.section--dark) .prin__card {
    border-color: var(--border);
    background: transparent;
  }

  :global(.section--dark) .prin__title {
    color: var(--text);
  }

  :global(.section--dark) .prin__icon {
    color: var(--accent);
  }

  :global(.section--dark) .prin__text {
    color: var(--text-muted);
  }

  :global(.section--dark) .prin__card:hover .prin__title {
    color: var(--text-on-light);
  }

  @media (max-width: 1020px) {
    .prin {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .prin {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .prin__card {
      flex-direction: row;
      align-items: flex-start;
      gap: 18px;
      padding: 22px;
    }

    .prin__icon {
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
    }

    .prin__icon :global(svg) {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prin__card,
    .prin__fill,
    .prin__icon,
    .prin__text {
      transition: none;
    }

    .prin__card:hover {
      transform: none;
    }

    .prin__card:hover .prin__icon :global(svg *) {
      animation: none;
    }
  }
</style>
