---
import { getCollection, getEntry } from 'astro:content';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { formMessages, t } from '../../lib/ui';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import CtaButton from '../CtaButton.astro';
import FormField from './FormField.astro';

/**
 * Proje talep formu: alanlar, doğrulama, gönderim ve başarı/hata panelleri.
 *
 * `FormSection.astro` (bağımsız form bölümü) ve `ContactSection.astro` (ana sayfadaki
 * birleşik iletişim bloğu) aynı, zaten test edilmiş formu buradan kullanır — mantık
 * tek yerde yaşar, iki farklı görsel çerçeveye yerleştirilebilir.
 */

interface CtaItem {
  label: string;
  href: string;
  variant: 'primary' | 'outline' | 'link';
  icon?: 'whatsapp' | 'phone' | 'arrow' | undefined;
  external: boolean;
}

interface Props {
  formId: 'contact' | 'analysis';
  /** Form elemanının `aria-label`'ı için — çevreleyen bölümün başlığı. */
  heading: string;
  submitLabel?: string | undefined;
  successHeading?: string | undefined;
  successBody?: string | undefined;
  successNote?: string | undefined;
  successCtas?: readonly CtaItem[];
  errorHeading?: string | undefined;
  errorBody?: string | undefined;
  locale?: Locale;
}

const {
  formId,
  heading,
  submitLabel: submitLabelProp,
  successHeading: successHeadingProp,
  successBody: successBodyProp,
  successNote,
  successCtas = [],
  errorHeading: errorHeadingProp,
  errorBody: errorBodyProp,
  locale = DEFAULT_LOCALE,
}: Props = Astro.props;

/*
 * Konu / hizmet seçenekleri içerikten üretilir — hiçbir hizmet adı gömülü değildir.
 * Girdi kimliği `<locale>/<slug>`; bu dilde hizmet yoksa varsayılan dildekiler listelenir
 * (aksi halde İngilizce formda Türkçe hizmet adları da görünürdü).
 */
const allServices = await getCollection('services');
const inLocale = allServices.filter((entry) => entry.id.startsWith(`${locale}/`));
const services = inLocale.length > 0 ? inLocale : allServices.filter((e) => e.id.startsWith(`${DEFAULT_LOCALE}/`));
const serviceTitles = [...services].sort((a, b) => a.data.order - b.data.order).map((entry) => entry.data.title);

/* Referans tasarımdaki isteğe bağlı bütçe aralıkları — doğrulamaya girmez, e-postayla iletilir. */
const BUDGET_OPTIONS: Record<Locale, string[]> = {
  tr: ['50.000 TL altı', '50.000 – 150.000 TL', '150.000 – 500.000 TL', '500.000 TL üzeri', 'Henüz belirlemedim'],
  en: ['Under 50,000 TRY', '50,000 – 150,000 TRY', '150,000 – 500,000 TRY', 'Over 500,000 TRY', 'Not decided yet'],
};
const budgetOptions = BUDGET_OPTIONS[locale];

/**
 * Gönderim Web3Forms üzerinden yapılır: sabit uç nokta + gövdede `access_key`.
 *
 * Anahtar build sırasında HTML'e gömülür — Web3Forms'un tasarımı bunu gerektirir ve
 * anahtar "gizli" değildir (yalnızca ilişkili e-posta adresine gönderim yapılmasına izin
 * verir). Yine de depoya yazılmasın diye ortam değişkeninden okunur.
 */
const WEB3FORMS_ENDPOINT = 'https://api.web3forms.com/submit';

/*
 * `PUBLIC_` ön eki bilinçlidir: değer istemciye ulaşan HTML'e gömüldüğü için Vite'ın
 * "public" sınıfına girer ve yalnızca bu ön ekle hem `astro dev` hem `astro build`
 * içinde tutarlı biçimde okunabilir. Ön ek ayrıca "bu değer gizli değildir" sinyalidir.
 * CI'da repository secret'ı bu isme eşlenir (bkz. .github/workflows/deploy.yml).
 */
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

const settingsEntry = await getEntry('settings', `${locale}/site`);
const fallbackSettings = await getEntry('settings', `${DEFAULT_LOCALE}/site`);
const whatsapp = (settingsEntry ?? fallbackSettings)?.data.whatsapp;
const whatsappUrl = whatsapp ? buildWhatsAppUrl(whatsapp.number, whatsapp.defaultMessage) : '';

const isAnalysis = formId === 'analysis';
const submitLabel = submitLabelProp ?? t(isAnalysis ? 'form.submit.analysis' : 'form.submit.contact', locale);

// Web3Forms `subject` alanını e-postanın konu satırı olarak kullanır.
const mailSubject = t(isAnalysis ? 'form.subject.analysis' : 'form.subject.contact', locale);

const successHeading = successHeadingProp ?? t('form.successHeading', locale);
const successBody = successBodyProp ?? t('form.successBody', locale);
const errorHeading = errorHeadingProp ?? t('form.errorHeading', locale);
const errorBody = errorBodyProp ?? t('form.errorBody', locale);

const consentText = t(isAnalysis ? 'form.consent.analysis' : 'form.consent.contact', locale);
const privacyNote = t(isAnalysis ? 'form.privacy.analysis' : 'form.privacy.contact', locale);

/*
 * Doğrulama tarayıcıda çalışır ve hata metinleri sayfanın dilinde olmalıdır. Sözlüğü
 * istemciye taşımak yerine yalnızca bu formun ihtiyaç duyduğu metinler `data-messages`
 * ile gömülür; aşağıdaki script onu okuyup `validate*Form`'a geçirir.
 */
const messagesJson = JSON.stringify(formMessages(locale));
---

{/* Gönderim başarısızsa formun üstünde beliren uyarı. */}
<div class="form-alert" data-form-error={formId} role="alert" hidden>
  <p class="form-alert__title">{errorHeading}</p>
  <p class="form-alert__body">{errorBody}</p>
  {
    whatsappUrl && (
      <CtaButton label={t('cta.whatsapp', locale)} href={whatsappUrl} variant="outline" icon="whatsapp" external />
    )
  }
</div>

{/* Gönderim başarılıysa formun yerini alan panel. */}
<div class="form-success" data-form-success={formId} role="status" hidden tabindex="-1">
  <span class="form-success__mark" aria-hidden="true">✓</span>
  <p class="form-success__title">{successHeading}</p>
  <p class="form-success__body">{successBody}</p>
  {successNote && <p class="form-success__note">{successNote}</p>}
  {
    successCtas.length > 0 && (
      <div class="form-success__ctas">
        {successCtas.map((item) => (
          <CtaButton
            label={item.label}
            href={item.href}
            variant={item.variant}
            icon={item.icon}
            external={item.external}
          />
        ))}
      </div>
    )
  }
</div>

<form
  class="form"
  method="POST"
  action={WEB3FORMS_ENDPOINT}
  novalidate
  aria-label={heading}
  data-form={formId}
  data-endpoint={WEB3FORMS_ENDPOINT}
  data-busy-label={t('form.sending', locale)}
  data-messages={messagesJson}
  data-reveal
  data-reveal-index="0"
>
  {/* Web3Forms zorunlu alanları — gövdeyle birlikte gönderilir. */}
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={mailSubject} />
  <input type="hidden" name="from_name" value={t('form.fromName', locale)} />

  {/* Bal küpü: Web3Forms'un sunucu tarafında denetlediği alan adı. */}
  <label class="visually-hidden" aria-hidden="true">
    {t('form.honeypot', locale)}
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
  </label>

  <div class="form__grid">
    <FormField
      name="name"
      label={t('form.field.name', locale)}
      required
      placeholder={t('form.placeholder.name', locale)}
      {locale}
    />
    <FormField
      name="email"
      label={t('form.field.email', locale)}
      type="email"
      required
      placeholder={t('form.placeholder.email', locale)}
      {locale}
    />

    {
      isAnalysis ? (
        <>
          <FormField
            name="phone"
            label={t('form.field.phone', locale)}
            type="tel"
            required
            placeholder={t('form.placeholder.phone', locale)}
            {locale}
          />
          <FormField
            name="company"
            label={t('form.field.company', locale)}
            required
            placeholder={t('form.placeholder.company', locale)}
            {locale}
          />
          <div class="form__span">
            <FormField
              name="website"
              label={t('form.field.website', locale)}
              type="url"
              placeholder={t('form.placeholder.website', locale)}
              {locale}
            />
          </div>
        </>
      ) : (
        <>
          <FormField
            name="phone"
            label={t('form.field.phone', locale)}
            type="tel"
            placeholder={t('form.placeholder.phone', locale)}
            {locale}
          />
          {/* `subject` adı Web3Forms'ta e-posta konusuna ayrılmıştır — bu yüzden `service`. */}
          <FormField
            name="service"
            label={t('form.field.service', locale)}
            type="select"
            options={serviceTitles}
            placeholder={t('form.placeholder.service', locale)}
            {locale}
          />
          <div class="form__span">
            <FormField
              name="budget"
              label={t('form.field.budget', locale)}
              type="select"
              options={budgetOptions}
              placeholder={t('form.placeholder.budget', locale)}
              {locale}
            />
          </div>
          <div class="form__span">
            <FormField
              name="message"
              label={t('form.field.message', locale)}
              type="textarea"
              required
              rows={6}
              placeholder={t('form.placeholder.message', locale)}
              {locale}
            />
          </div>
        </>
      )
    }
  </div>

  {
    isAnalysis && (
      <fieldset class="checks" data-error-target="services">
        <legend class="checks__legend">
          {t('form.checksLegend', locale)}
          <span class="checks__required" aria-hidden="true">
            *
          </span>
          <span class="visually-hidden">{t('form.required', locale)}</span>
        </legend>
        <div class="checks__grid">
          {serviceTitles.map((title) => (
            <label class="checks__item">
              <input type="checkbox" name="services" value={title} />
              <span>{title}</span>
            </label>
          ))}
        </div>
        <p class="field__error" id="err-services" data-error-for="services" aria-live="polite" />
      </fieldset>
    )
  }

  <div class="consent">
    <label class="consent__label" for="f-consent">
      <input type="checkbox" id="f-consent" name="consent" value="1" aria-required="true" data-error-target="consent" />
      <span>{consentText}</span>
    </label>
    <p class="field__error" id="err-consent" data-error-for="consent" aria-live="polite"></p>
  </div>

  <div class="form__actions">
    <button type="submit" class="btn btn--primary form__submit" data-submit>{submitLabel}</button>
    {!accessKey && <p class="form__note form__note--warn">{t('form.missingKey', locale)}</p>}
    <p class="form__note">{privacyNote}</p>
  </div>
</form>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 880px;
  }

  .form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .form__span {
    grid-column: 1 / -1;
  }

  /* --- Hizmet seçim kutuları --- */
  .checks {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 22px 24px 24px;
    transition: border-color var(--t-base);
  }

  .checks[aria-invalid='true'] {
    border-color: var(--danger);
  }

  .checks__legend {
    padding: 0 6px;
    font: 600 var(--fs-small) var(--font-display);
    letter-spacing: 0.01em;
    color: var(--text-soft);
  }

  .checks__required {
    color: var(--accent);
    margin-left: 4px;
  }

  .checks__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
    margin-top: 14px;
  }

  .checks__item,
  .consent__label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text-muted);
    cursor: pointer;
  }

  .consent__label {
    font-size: var(--fs-small);
    line-height: 1.65;
    max-width: 720px;
  }

  .checks__item input,
  .consent__label input {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin: 2px 0 0;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .consent__label input[aria-invalid='true'] {
    outline: 2px solid var(--danger);
    outline-offset: 2px;
  }

  .consent {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* --- Hata metni (grup alanları) --- */
  .field__error {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--danger);
  }

  .field__error:empty {
    display: none;
  }

  /* Not: `[hidden]` gizlemesi global.css'te site geneline sabitlenmiştir. */

  /* --- Gönderim sonrası paneller --- */
  .form-alert {
    border: 1px solid rgb(226 60 60 / 40%);
    border-radius: var(--radius-input);
    padding: 16px 18px;
    margin-bottom: 22px;
    max-width: 880px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .form-alert__title {
    margin: 0;
    font: 600 15px var(--font-display);
    color: var(--danger);
  }

  .form-alert__body {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 620px;
  }

  .form-success {
    border: 1px solid var(--border);
    border-radius: var(--radius-feature);
    padding: clamp(32px, 4vw, 48px);
    max-width: 880px;
    text-align: center;
    background-image: radial-gradient(ellipse 70% 80% at 50% 0%, var(--accent-soft), transparent 65%);
  }

  .form-success:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .form-success__mark {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--text-on-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin: 0 auto 20px;
  }

  .form-success__title {
    margin: 0 0 10px;
    font: 600 clamp(21px, 2.4vw, 26px) var(--font-display);
    color: var(--text);
  }

  .form-success__body,
  .form-success__note {
    margin: 0 auto;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
  }

  .form-success__note {
    margin-top: 10px;
  }

  .form-success__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 26px;
  }

  :global(.section--light) .form-alert {
    background: #fff;
  }

  :global(.section--light) .form-alert__body,
  :global(.section--light) .form-success__body,
  :global(.section--light) .form-success__note {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .form-success {
    border-color: var(--border-on-light);
  }

  :global(.section--light) .form-success__title {
    color: var(--text-on-light);
  }

  @media (max-width: 720px) {
    .form-success__ctas :global(.btn) {
      width: 100%;
    }
  }

  /* --- Aksiyonlar --- */
  .form__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .form__submit {
    align-self: flex-start;
  }

  .form__note {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--text-faint);
    max-width: 620px;
  }

  .form__note--warn {
    color: var(--text-muted);
  }

  /* --- Açık zeminli varyant --- */
  :global(.section--light) .checks {
    border-color: var(--border-on-light);
  }

  :global(.section--light) .checks__legend {
    color: var(--text-on-light);
  }

  :global(.section--light) .checks__required {
    color: var(--text-on-light);
  }

  :global(.section--light) .checks__item,
  :global(.section--light) .consent__label {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .form__note {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .form__submit {
    background: var(--text-on-light);
    color: var(--accent);
    border-color: var(--text-on-light);
  }

  :global(.section--light) .form__submit:hover {
    background: var(--bg-footer);
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .form__grid,
    .checks__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Doğrulama mantığı src/lib/forms.ts içinde yaşar ve birim testleriyle korunur —
  // burada yalnızca DOM'dan değer toplanır ve dönen hatalar arayüze yazılır.
  import { validateAnalysisForm, validateContactForm, type FormMessages } from '../../lib/forms';

  type FieldName = keyof FormMessages;
  type FormKind = 'contact' | 'analysis';

  const FIELDS: Record<FormKind, FieldName[]> = {
    contact: ['name', 'email', 'phone', 'message', 'consent'],
    analysis: ['name', 'email', 'phone', 'company', 'website', 'services', 'consent'],
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-form]')) {
    const kind: FormKind = form.dataset.form === 'analysis' ? 'analysis' : 'contact';
    const endpoint = form.dataset.endpoint ?? '';
    const fields = FIELDS[kind];

    /*
     * Hata metinleri sayfanın dilinde build sırasında gömülür (bkz. frontmatter).
     * Öznitelik bozuksa doğrulama yine çalışsın diye Türkçe varsayılanlara düşülür.
     */
    let messages: FormMessages | undefined;
    try {
      messages = JSON.parse(form.dataset.messages ?? '') as FormMessages;
    } catch {
      messages = undefined;
    }

    const controlOf = (name: string) => form.querySelector<HTMLElement>(`[data-error-target="${name}"]`);
    const errorBoxOf = (name: string) => form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

    const textValue = (name: string): string => {
      const element = form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        `[name="${name}"]`,
      );
      return element ? element.value.trim() : '';
    };

    const isChecked = (name: string): boolean => {
      const element = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
      return element ? element.checked : false;
    };

    const checkedValues = (name: string): string[] =>
      [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((element) => element.value);

    const clearError = (name: string): void => {
      const box = errorBoxOf(name);
      if (box) box.textContent = '';

      const control = controlOf(name);
      if (!control) return;
      control.removeAttribute('aria-invalid');
      control.removeAttribute('aria-describedby');
    };

    const showError = (name: string, message: string): void => {
      const box = errorBoxOf(name);
      if (box) box.textContent = message;

      const control = controlOf(name);
      if (!control) return;
      control.setAttribute('aria-invalid', 'true');
      control.setAttribute('aria-describedby', `err-${name}`);
    };

    // Onay kutusu grubunda odak <fieldset>'e değil ilk kutuya verilir.
    const focusTargetOf = (name: string): HTMLElement | null => {
      const control = controlOf(name);
      if (control instanceof HTMLFieldSetElement) return control.querySelector<HTMLInputElement>('input');
      return control;
    };

    // Alan düzeltilir düzeltilmez o alanın hatası kaybolur.
    const handleEdit = (event: Event): void => {
      const target = event.target;
      const isControl =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement;
      if (isControl && target.name) clearError(target.name);
    };

    form.addEventListener('input', handleEdit);
    form.addEventListener('change', handleEdit);

    const formId = form.dataset.form ?? '';
    const successPanel = document.querySelector<HTMLElement>(`[data-form-success="${formId}"]`);
    const errorPanel = document.querySelector<HTMLElement>(`[data-form-error="${formId}"]`);
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
    const accessKey = form.querySelector<HTMLInputElement>('input[name="access_key"]')?.value ?? '';

    // Gönderim Web3Forms'a AJAX ile gider; sayfa yenilenmez, sonuç yerinde gösterilir.
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      for (const name of fields) clearError(name);
      if (errorPanel) errorPanel.hidden = true;

      // Bal küpü işaretliyse bot demektir: sessizce iptal.
      const botcheck = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      if (botcheck?.checked) return;

      const result =
        kind === 'analysis'
          ? validateAnalysisForm(
              {
                name: textValue('name'),
                email: textValue('email'),
                phone: textValue('phone'),
                company: textValue('company'),
                website: textValue('website'),
                services: checkedValues('services'),
                consent: isChecked('consent'),
              },
              messages,
            )
          : validateContactForm(
              {
                name: textValue('name'),
                email: textValue('email'),
                phone: textValue('phone'),
                service: textValue('service'),
                message: textValue('message'),
                consent: isChecked('consent'),
              },
              messages,
            );

      if (!result.valid) {
        let firstInvalid: HTMLElement | null = null;
        for (const name of fields) {
          const message = result.errors[name];
          if (!message) continue;
          showError(name, message);
          if (!firstInvalid) firstInvalid = focusTargetOf(name);
        }
        firstInvalid?.focus();
        return;
      }

      // Anahtar yoksa gidilecek bir yer yok — hata panelini göster, veriyi kaybetme.
      if (!accessKey) {
        if (errorPanel) errorPanel.hidden = false;
        errorPanel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const busyLabel = form.dataset.busyLabel ?? '…';
      const originalLabel = submitButton?.textContent ?? '';
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = busyLabel;
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const payload = (await response.json().catch(() => ({}))) as { success?: boolean };

        if (!response.ok || payload.success !== true) throw new Error('web3forms rejected the submission');

        form.hidden = true;
        if (successPanel) {
          successPanel.hidden = false;
          successPanel.focus();
          successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch {
        if (errorPanel) {
          errorPanel.hidden = false;
          errorPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel;
        }
      }
    });
  }
</script>
