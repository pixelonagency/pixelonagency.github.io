---
import { Image } from 'astro:assets';
import mapImage from '../../assets/images/worldmap-dotted.webp';
import type { PageSection } from '../../content/page-schema';
import { parseHighlights } from '../../lib/highlight';
import { placePins } from '../../lib/map-pins';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type WorldMap = Extract<PageSection, { type: 'worldMap' }>;

interface Props {
  section: WorldMap;
}

const { section } = Astro.props;
const closingSegments = section.closingLine ? parseHighlights(section.closingLine) : [];

/*
 * Koordinatı olan ülkeler pine dönüşür; olmayanlar yalnız çip listesinde kalır.
 * Pinler dekoratiftir (aria-hidden) — ülke adlarını yukarıdaki çip listesi zaten
 * okunabilir biçimde veriyor, pinleri de duyurmak aynı listeyi iki kez okuturdu.
 */
const pins = placePins(section.countries);
/* Vurgulu pin (Türkiye) sürekli açık durur; diğerleri sırayla belirip söner. */
const PIN_STAGGER_S = 0.3;
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas} class="worldmap-section">
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} align="center" />

  <div class="worldmap" role="group" tabindex="0">
    <div class="worldmap__track">
      {
        [0, 1].map((copy) => (
          <ul class="worldmap__group" aria-hidden={copy === 1}>
            {section.countries.map((country, index) => (
              <li
                class:list={['worldmap__pill', country.highlighted && 'worldmap__pill--active']}
                style={`animation-duration:${3 + (index % 5) * 0.15}s; animation-delay:${(index % 5) * 0.3}s`}
              >
                <span class="worldmap__flag" aria-hidden="true">
                  {country.flag}
                </span>{' '}
                {country.label}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <figure class="worldmap__figure" data-reveal data-reveal-index={1}>
    <div class="worldmap__canvas">
      <Image src={mapImage} alt={section.mapImageAlt ?? ''} class="worldmap__image" width={1400} />
      {
        pins.length > 0 && (
          <div class="worldmap__pins" aria-hidden="true">
            {pins.map((pin) => (
              <span
                class:list={['worldmap__pin', pin.highlighted && 'worldmap__pin--home']}
                style={`left:${pin.left}%; top:${pin.top}%; --pin-delay:${(pin.order * PIN_STAGGER_S).toFixed(2)}s`}
              >
                <span class="worldmap__pin-ring" />
                <span class="worldmap__pin-dot" />
                {pin.highlighted && <span class="worldmap__pin-label">{pin.label}</span>}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </figure>

  {
    section.closingLine && (
      <p class="lead worldmap__closing">
        {closingSegments.map((segment) =>
          segment.accent ? <span class="worldmap__accent">{segment.text}</span> : segment.text,
        )}
      </p>
    )
  }
</Section>

<style>
  .worldmap {
    overflow: hidden;
    padding: 8px 0 clamp(28px, 4vw, 44px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .worldmap__track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }

  .worldmap:hover .worldmap__track,
  .worldmap:focus-within .worldmap__track {
    animation-play-state: paused;
  }

  .worldmap__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
    padding: 0 14px 0 0;
    margin: 0;
    list-style: none;
  }

  /* Referans: bu bölümün başlığı bir kademe büyüktür. */
  :global(.worldmap-section .section-head .h2) {
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.08;
  }

  /* Referans: iri çipler — 16px yazı, 14×26 dolgu, 24px bayrak. */
  .worldmap__pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill);
    padding: 14px 26px;
    font: 500 16px var(--font-display);
    color: rgba(255, 255, 255, 0.85);
    animation-name: floaty;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .worldmap__flag {
    font-size: 24px;
    line-height: 1;
  }

  .worldmap__pill--active {
    border-color: rgba(207, 255, 0, 0.55);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .worldmap__figure {
    margin: 44px auto 0;
    max-width: 1100px;
  }

  .worldmap__canvas {
    position: relative;
  }

  .worldmap__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
   * Yeni harita zaten koyu doğuyor (siyah okyanus, gri nokta ızgarası), bu yüzden
   * koyu bölümde HİÇBİR filtre uygulanmaz. Ters çevirme yalnızca açık zeminde
   * gerekir — önceki harita bunun tersiydi ve filtre koşulu da terstir.
   */
  :global(.section--light) .worldmap__image {
    filter: invert(1) hue-rotate(180deg) saturate(1.2) brightness(0.98);
  }

  /* --- Pinler ------------------------------------------------------------- */

  .worldmap__pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .worldmap__pin {
    position: absolute;
    width: 0;
    height: 0;
    /* Sırayla belirir: her pin kendi gecikmesiyle aynı 8sn'lik döngüyü koşar. */
    animation: pin-cycle 8s var(--pin-delay, 0s) ease-out infinite both;
  }

  .worldmap__pin-dot,
  .worldmap__pin-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .worldmap__pin-dot {
    width: 9px;
    height: 9px;
    background: var(--accent);
    box-shadow: 0 0 10px 2px rgb(207 255 0 / 55%);
  }

  .worldmap__pin-ring {
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--accent);
    opacity: 0;
    animation: pin-ripple 2.6s var(--pin-delay, 0s) ease-out infinite;
  }

  /* Ana pazar sabit durur — sönmez, sadece nabız atar. */
  .worldmap__pin--home {
    animation: none;
    opacity: 1;
  }

  .worldmap__pin--home .worldmap__pin-dot {
    width: 13px;
    height: 13px;
    box-shadow:
      0 0 0 4px rgb(207 255 0 / 18%),
      0 0 16px 4px rgb(207 255 0 / 55%);
  }

  .worldmap__pin--home .worldmap__pin-ring {
    animation-delay: 0s;
  }

  .worldmap__pin-label {
    position: absolute;
    left: 16px;
    top: -9px;
    white-space: nowrap;
    font: 600 13px var(--font-display);
    letter-spacing: 0.02em;
    color: var(--accent);
    text-shadow: 0 1px 6px rgb(0 0 0 / 85%);
  }

  :global(.section--light) .worldmap__pin-label {
    color: var(--text-on-light);
    text-shadow: 0 1px 6px rgb(255 255 255 / 85%);
  }

  @keyframes pin-cycle {
    0%,
    2% {
      opacity: 0;
      transform: scale(0.2);
    }
    5% {
      opacity: 1;
      transform: scale(1.45);
    }
    9%,
    74% {
      opacity: 1;
      transform: scale(1);
    }
    86%,
    100% {
      opacity: 0;
      transform: scale(0.75);
    }
  }

  @keyframes pin-ripple {
    0% {
      opacity: 0.7;
      width: 9px;
      height: 9px;
    }
    70%,
    100% {
      opacity: 0;
      width: 46px;
      height: 46px;
    }
  }

  @media (max-width: 720px) {
    .worldmap__pin-dot {
      width: 7px;
      height: 7px;
    }

    .worldmap__pin-label {
      font-size: 11px;
      left: 13px;
    }
  }

  /* Referans: kapanış cümlesi manifesto gibi büyük ve beyazdır. */
  .worldmap__closing {
    margin: 48px auto 0;
    max-width: 720px;
    text-align: center;
    font: 500 clamp(20px, 2.2vw, 28px) / 1.4 var(--font-display);
    color: var(--text);
  }

  .worldmap__accent {
    color: var(--accent);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .worldmap__pill {
    border-color: var(--border-on-light);
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .worldmap__pill--active {
    border-color: var(--text-on-light);
    background: color-mix(in srgb, var(--text-on-light) 6%, transparent);
    color: var(--text-on-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .worldmap {
      overflow-x: auto;
      overflow-y: hidden;
    }

    .worldmap__track {
      animation: none;
    }

    .worldmap__pill {
      animation: none;
    }

    /* Hareket kapalıyken pinler sırayla belirmez — hepsi sabit görünür kalır. */
    .worldmap__pin {
      animation: none;
      opacity: 1;
    }

    .worldmap__pin-ring {
      animation: none;
      opacity: 0;
    }
  }
</style>
