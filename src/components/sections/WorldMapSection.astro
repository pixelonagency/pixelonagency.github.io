---
import { Image } from 'astro:assets';
import mapImage from '../../assets/images/mappixelonworld.webp';
import type { PageSection } from '../../content/page-schema';
import { parseHighlights } from '../../lib/highlight';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type WorldMap = Extract<PageSection, { type: 'worldMap' }>;

interface Props {
  section: WorldMap;
}

const { section } = Astro.props;
const closingSegments = section.closingLine ? parseHighlights(section.closingLine) : [];
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas} class="worldmap-section">
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} align="center" />

  <div class="worldmap" role="group" tabindex="0">
    <div class="worldmap__track">
      {
        [0, 1].map((copy) => (
          <ul class="worldmap__group" aria-hidden={copy === 1}>
            {section.countries.map((country, index) => (
              <li
                class:list={['worldmap__pill', country.highlighted && 'worldmap__pill--active']}
                style={`animation-duration:${3 + (index % 5) * 0.15}s; animation-delay:${(index % 5) * 0.3}s`}
              >
                <span class="worldmap__flag" aria-hidden="true">
                  {country.flag}
                </span>{' '}
                {country.label}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <figure class="worldmap__figure" data-reveal data-reveal-index={1}>
    <Image src={mapImage} alt={section.mapImageAlt ?? ''} class="worldmap__image" width={1200} />
  </figure>

  {
    section.closingLine && (
      <p class="lead worldmap__closing">
        {closingSegments.map((segment) =>
          segment.accent ? <span class="worldmap__accent">{segment.text}</span> : segment.text,
        )}
      </p>
    )
  }
</Section>

<style>
  .worldmap {
    overflow: hidden;
    padding: 8px 0 clamp(28px, 4vw, 44px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .worldmap__track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }

  .worldmap:hover .worldmap__track,
  .worldmap:focus-within .worldmap__track {
    animation-play-state: paused;
  }

  .worldmap__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
    padding: 0 14px 0 0;
    margin: 0;
    list-style: none;
  }

  /* Referans: bu bölümün başlığı bir kademe büyüktür. */
  :global(.worldmap-section .section-head .h2) {
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.08;
  }

  /* Referans: iri çipler — 16px yazı, 14×26 dolgu, 24px bayrak. */
  .worldmap__pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill);
    padding: 14px 26px;
    font: 500 16px var(--font-display);
    color: rgba(255, 255, 255, 0.85);
    animation-name: floaty;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .worldmap__flag {
    font-size: 24px;
    line-height: 1;
  }

  .worldmap__pill--active {
    border-color: rgba(207, 255, 0, 0.55);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .worldmap__figure {
    margin: 44px auto 0;
    max-width: 1100px;
  }

  .worldmap__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
   * Kaynak harita koyu çizgilidir; ters çevirme YALNIZCA koyu zeminde gerekir.
   * Filtre koşulsuz uygulandığında açık zeminli bölümde harita beyaza dönüp
   * görünmez oluyordu — yerinde kocaman boş bir alan kalıyordu.
   */
  :global(.section--dark) .worldmap__image {
    filter: invert(1) hue-rotate(180deg) saturate(1.4) brightness(1.05);
  }

  /* Referans: kapanış cümlesi manifesto gibi büyük ve beyazdır. */
  .worldmap__closing {
    margin: 48px auto 0;
    max-width: 720px;
    text-align: center;
    font: 500 clamp(20px, 2.2vw, 28px) / 1.4 var(--font-display);
    color: var(--text);
  }

  .worldmap__accent {
    color: var(--accent);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .worldmap__pill {
    border-color: var(--border-on-light);
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .worldmap__pill--active {
    border-color: var(--text-on-light);
    background: color-mix(in srgb, var(--text-on-light) 6%, transparent);
    color: var(--text-on-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .worldmap {
      overflow-x: auto;
      overflow-y: hidden;
    }

    .worldmap__track {
      animation: none;
    }

    .worldmap__pill {
      animation: none;
    }
  }
</style>
