---
import { Image } from 'astro:assets';
import mapImage from '../../assets/images/mappixelonworld.webp';
import type { PageSection } from '../../content/page-schema';
import { parseHighlights } from '../../lib/highlight';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type WorldMap = Extract<PageSection, { type: 'worldMap' }>;

interface Props {
  section: WorldMap;
}

const { section } = Astro.props;
const closingSegments = section.closingLine ? parseHighlights(section.closingLine) : [];
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} align="center" />

  <div class="worldmap" role="group" tabindex="0">
    <div class="worldmap__track">
      {
        [0, 1].map((copy) => (
          <ul class="worldmap__group" aria-hidden={copy === 1}>
            {section.countries.map((country, index) => (
              <li
                class:list={['worldmap__pill', country.highlighted && 'worldmap__pill--active']}
                style={`animation-duration:${3 + (index % 5) * 0.15}s; animation-delay:${(index % 5) * 0.3}s`}
              >
                <span aria-hidden="true">{country.flag}</span> {country.label}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <figure class="worldmap__figure" data-reveal data-reveal-index={1}>
    <Image src={mapImage} alt={section.mapImageAlt ?? ''} class="worldmap__image" width={1200} />
  </figure>

  {
    section.closingLine && (
      <p class="lead worldmap__closing">
        {closingSegments.map((segment) =>
          segment.accent ? <span class="worldmap__accent">{segment.text}</span> : segment.text,
        )}
      </p>
    )
  }
</Section>

<style>
  .worldmap {
    overflow: hidden;
    padding: 8px 0 clamp(28px, 4vw, 44px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .worldmap__track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }

  .worldmap:hover .worldmap__track,
  .worldmap:focus-within .worldmap__track {
    animation-play-state: paused;
  }

  .worldmap__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
    padding: 0 14px 0 0;
    margin: 0;
    list-style: none;
  }

  .worldmap__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 10px 18px;
    font: 600 var(--fs-small) var(--font-display);
    color: var(--text-muted);
    animation-name: floaty;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .worldmap__pill--active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--text);
  }

  .worldmap__figure {
    margin: clamp(24px, 3vw, 40px) auto 0;
    max-width: 760px;
  }

  .worldmap__image {
    display: block;
    width: 100%;
    height: auto;
    filter: invert(1) hue-rotate(180deg) saturate(1.4) brightness(1.05);
  }

  .worldmap__closing {
    margin: clamp(24px, 3vw, 40px) auto 0;
    max-width: 620px;
    text-align: center;
  }

  .worldmap__accent {
    color: var(--accent);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .worldmap__pill {
    border-color: var(--border-on-light);
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .worldmap__pill--active {
    border-color: var(--text-on-light);
    background: color-mix(in srgb, var(--text-on-light) 6%, transparent);
    color: var(--text-on-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .worldmap {
      overflow-x: auto;
      overflow-y: hidden;
    }

    .worldmap__track {
      animation: none;
    }

    .worldmap__pill {
      animation: none;
    }
  }
</style>
