---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';
import CtaButton from '../CtaButton.astro';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Projects = Extract<PageSection, { type: 'projects' }>;

interface Props {
  section: Projects;
  locale?: Locale;
  projects: {
    title: string;
    slug: string;
    hasDetail: boolean;
    client: string;
    excerpt: string;
    category: string;
    categoryLabel?: string | undefined;
    cover?: ImageMetadata | undefined;
  }[];
}

const { section, locale = DEFAULT_LOCALE, projects } = Astro.props;
const detailHref = (slug: string) => `/${locale === DEFAULT_LOCALE ? 'projelerimiz' : 'en/projects'}/${slug}/`;

/*
 * Kaydırma yerel `scroll-snap` ile yapılır: kütüphane yok, JavaScript yalnızca
 * okları çalıştırır. Klavye ve dokunmatik kaydırma tarayıcının kendi davranışıdır,
 * bu yüzden script yüklenmese bile şerit gezilebilir kalır.
 */
const SLIDER_SCRIPT = `
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root) return;
  const track = root.querySelector('[data-slider-track]');
  const prev = root.querySelector('[data-slider-prev]');
  const next = root.querySelector('[data-slider-next]');
  if (!track || !prev || !next) return;

  const step = () => {
    const card = track.querySelector('[data-slider-card]');
    if (!card) return track.clientWidth;
    const gap = parseFloat(getComputedStyle(track).columnGap || '0');
    return card.getBoundingClientRect().width + gap;
  };

  const sync = () => {
    const max = track.scrollWidth - track.clientWidth - 2;
    prev.disabled = track.scrollLeft <= 2;
    next.disabled = track.scrollLeft >= max;
  };

  prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  track.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', sync);
  sync();
})();
`;
---

<Section anchor={section.anchor} background={section.background} class="pslider-section">
  <div class="pslider__head">
    <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

    {/* Oklar başlığın sağında durur — şeridin üstünde ayrı bir satır açmaz. */}
    <div class="pslider__nav">
      <button type="button" class="pslider__arrow" data-slider-prev aria-label={t('slider.prev', locale)}>
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" class="pslider__arrow" data-slider-next aria-label={t('slider.next', locale)}>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <ul class="pslider__track" data-slider-track>
    {
      projects.map((project, index) => {
        const Tag = project.hasDetail ? 'a' : 'article';
        return (
          <li class="pslider__card" data-slider-card>
            <Tag class="pslider__link" href={project.hasDetail ? detailHref(project.slug) : undefined}>
              <div class="pslider__media">
                {project.cover && (
                  <Image
                    src={project.cover}
                    alt={`${project.client} — ${project.title}`}
                    widths={[520, 1040]}
                    sizes="(max-width: 720px) 84vw, 520px"
                    loading={index < 2 ? 'eager' : 'lazy'}
                  />
                )}
                <span class="pslider__tag">{project.categoryLabel ?? project.category}</span>
              </div>

              <div class="pslider__body">
                <p class="pslider__client">{project.client}</p>
                <h3 class="pslider__title">{project.title}</h3>
                <p class="pslider__text">{project.excerpt}</p>
                {project.hasDetail && (
                  <span class="pslider__more">
                    {t('projects.view', locale)}
                    <span aria-hidden="true">→</span>
                  </span>
                )}
              </div>
            </Tag>
          </li>
        );
      })
    }
  </ul>
  <script is:inline set:html={SLIDER_SCRIPT} data-projects-slider />

  {
    section.ctaLabel && section.ctaHref && (
      <div class="pslider__cta">
        <CtaButton label={section.ctaLabel} href={section.ctaHref} variant="outline" />
      </div>
    )
  }
</Section>

<style>
  .pslider__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }

  .pslider__head :global(.section-head) {
    margin-bottom: 0;
  }

  .pslider__nav {
    display: flex;
    gap: 10px;
    flex: 0 0 auto;
  }

  .pslider__arrow {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    font-size: 17px;
    cursor: pointer;
    transition:
      border-color var(--t-base),
      background var(--t-base),
      opacity var(--t-base);
  }

  .pslider__arrow:hover:not(:disabled) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .pslider__arrow:disabled {
    opacity: 0.32;
    cursor: default;
  }

  /*
   * Şerit kapsayıcıyı SAĞA doğru taşar: kartlar ekran kenarına kadar uzanıp
   * kesilir, böylece devamı olduğu görülür. Sol kenar boşluğu hizada kalır.
   */
  .pslider__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(280px, 30vw, 440px);
    column-gap: clamp(16px, 2vw, 28px);
    margin: clamp(32px, 4vw, 48px) calc((100vw - min(100vw, var(--container))) / -2 - clamp(20px, 6vw, 80px)) 0 0;
    padding: 4px clamp(20px, 6vw, 80px) 26px 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .pslider__track::-webkit-scrollbar {
    display: none;
  }

  .pslider__card {
    scroll-snap-align: start;
  }

  .pslider__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .pslider__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: rgb(255 255 255 / 4%);
  }

  .pslider__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pslider__tag {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(10 10 10 / 62%);
    backdrop-filter: blur(8px);
    font: 600 11.5px var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .pslider__body {
    padding: 18px 2px 0;
  }

  .pslider__client {
    margin: 0 0 6px;
    font: 600 12px var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pslider__title {
    margin: 0;
    font: 600 clamp(19px, 1.8vw, 24px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }

  .pslider__text {
    margin: 10px 0 0;
    font: 400 14.5px / 1.6 var(--font-body);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pslider__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font: 600 14px var(--font-display);
    color: var(--accent);
  }

  .pslider__link:hover .pslider__media :global(img) {
    transform: scale(1.05);
  }

  .pslider__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 3vw, 36px);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .pslider__arrow {
    border-color: var(--border-on-light);
    color: var(--text-on-light);
  }

  :global(.section--light) .pslider__arrow:hover:not(:disabled) {
    border-color: var(--text-on-light);
    background: rgb(10 10 10 / 5%);
  }

  :global(.section--light) .pslider__title {
    color: var(--text-on-light);
  }

  :global(.section--light) .pslider__text {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .pslider__client,
  :global(.section--light) .pslider__more {
    color: var(--text-on-light);
  }

  :global(.section--light) .pslider__media {
    background: rgb(10 10 10 / 5%);
  }

  @media (max-width: 720px) {
    .pslider__head {
      flex-direction: column;
      align-items: start;
      gap: 20px;
    }

    .pslider__track {
      grid-auto-columns: 82vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pslider__track {
      scroll-behavior: auto;
    }

    .pslider__media :global(img) {
      transition: none;
    }
  }
</style>
