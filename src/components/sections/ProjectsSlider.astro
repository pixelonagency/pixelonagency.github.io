---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';
import CtaButton from '../CtaButton.astro';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Projects = Extract<PageSection, { type: 'projects' }>;

interface Props {
  section: Projects;
  locale?: Locale;
  projects: {
    title: string;
    slug: string;
    hasDetail: boolean;
    client: string;
    excerpt: string;
    category: string;
    categoryLabel?: string | undefined;
    cover?: ImageMetadata | undefined;
  }[];
}

const { section, locale = DEFAULT_LOCALE, projects } = Astro.props;
const detailHref = (slug: string) => `/${locale === DEFAULT_LOCALE ? 'projelerimiz' : 'en/projects'}/${slug}/`;

/*
 * Kesintisiz döngü: liste iki kez basılır ve şerit tam yarısı kadar kaydırılır
 * (@keyframes pslide -> translateX(-50%)). İkinci kopya ekran okuyucudan gizlenir
 * ve odak alamaz, yoksa her proje iki kez okunur ve sekmeyle iki kez gezilir.
 * Hız kart sayısıyla ölçeklenir: kart başına ~7 saniye, böylece az projede şerit
 * fırlamaz, çok projede sürünmez.
 */
const COPIES = [0, 1];
const duration = Math.max(28, projects.length * 7);
---

<Section anchor={section.anchor} background={section.background} class="pslider-section">
  <div class="pslider__head">
    <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />
  </div>

  <div class="pslider__viewport">
    <div class="pslider__track" style={`--pslide-duration: ${duration}s`}>
      {
        COPIES.map((copy) => (
          <ul class="pslider__group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {projects.map((project, index) => {
              const Tag = project.hasDetail ? 'a' : 'article';
              return (
                <li class="pslider__card">
                  <Tag
                    class="pslider__link"
                    href={project.hasDetail ? detailHref(project.slug) : undefined}
                    tabindex={copy === 1 ? -1 : undefined}
                  >
                    <div class="pslider__media">
                      {project.cover && (
                        <Image
                          src={project.cover}
                          alt={`${project.client} — ${project.title}`}
                          widths={[520, 1040]}
                          sizes="(max-width: 720px) 84vw, 520px"
                          loading={copy === 0 && index < 2 ? 'eager' : 'lazy'}
                        />
                      )}
                      <span class="pslider__tag">{project.categoryLabel ?? project.category}</span>
                    </div>

                    <div class="pslider__body">
                      <p class="pslider__client">{project.client}</p>
                      <h3 class="pslider__title">{project.title}</h3>
                      <p class="pslider__text">{project.excerpt}</p>
                      {project.hasDetail && (
                        <span class="pslider__more">
                          {t('projects.view', locale)}
                          <span aria-hidden="true">→</span>
                        </span>
                      )}
                    </div>
                  </Tag>
                </li>
              );
            })}
          </ul>
        ))
      }
    </div>
  </div>
  {
    section.ctaLabel && section.ctaHref && (
      <div class="pslider__cta">
        <CtaButton label={section.ctaLabel} href={section.ctaHref} variant="outline" />
      </div>
    )
  }
</Section>

<style>
  .pslider__head {
    display: block;
  }

  .pslider__head :global(.section-head) {
    margin-bottom: 0;
  }

  /*
   * Şerit kendi kendine akar ve başa döner. Bant, kapsayıcının iki yanına taşar:
   * kartlar ekran kenarında kesilir, böylece devamı olduğu görülür.
   */
  .pslider__viewport {
    margin: clamp(32px, 4vw, 48px) calc(50% - 50vw) 0;
    padding: 4px 0 6px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 5%, black 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 5%, black 95%, transparent 100%);
  }

  .pslider__track {
    display: flex;
    width: max-content;
    animation: pslide var(--pslide-duration, 56s) linear infinite;
  }

  .pslider-section:hover .pslider__track,
  .pslider-section:focus-within .pslider__track {
    animation-play-state: paused;
  }

  .pslider__group {
    display: flex;
    flex-shrink: 0;
    align-items: stretch;
    gap: clamp(16px, 2vw, 28px);
    padding: 0 clamp(8px, 1vw, 14px) 0 0;
    margin: 0;
    list-style: none;
  }

  .pslider__card {
    flex: 0 0 auto;
    width: clamp(280px, 30vw, 440px);
  }

  @keyframes pslide {
    to {
      transform: translateX(-50%);
    }
  }

  .pslider__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .pslider__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: rgb(255 255 255 / 4%);
  }

  .pslider__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pslider__tag {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(10 10 10 / 62%);
    backdrop-filter: blur(8px);
    font: 600 11.5px var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .pslider__body {
    padding: 18px 2px 0;
  }

  .pslider__client {
    margin: 0 0 6px;
    font: 600 12px var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pslider__title {
    margin: 0;
    font: 600 clamp(19px, 1.8vw, 24px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }

  .pslider__text {
    margin: 10px 0 0;
    font: 400 14.5px / 1.6 var(--font-body);
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pslider__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font: 600 14px var(--font-display);
    color: var(--accent);
  }

  .pslider__link:hover .pslider__media :global(img) {
    transform: scale(1.05);
  }

  .pslider__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 3vw, 36px);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .pslider__title {
    color: var(--text-on-light);
  }

  :global(.section--light) .pslider__text {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .pslider__client,
  :global(.section--light) .pslider__more {
    color: var(--text-on-light);
  }

  :global(.section--light) .pslider__media {
    background: rgb(10 10 10 / 5%);
  }

  @media (max-width: 720px) {
    .pslider__head {
      flex-direction: column;
      align-items: start;
      gap: 20px;
    }

    .pslider__card {
      width: 78vw;
    }
  }

  /*
   * Hareket kapalıyken şerit kendi kendine akmaz; kullanıcı yatay olarak kaydırır.
   * İkinci kopya gizlenir, yoksa her proje iki kez görünür.
   */
  @media (prefers-reduced-motion: reduce) {
    .pslider__viewport {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .pslider__track {
      animation: none;
    }

    .pslider__group[aria-hidden='true'] {
      display: none;
    }

    .pslider__media :global(img) {
      transition: none;
    }
  }
</style>
