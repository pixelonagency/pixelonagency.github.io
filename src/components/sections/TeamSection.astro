---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Team = Extract<PageSection, { type: 'team' }>;

interface Props {
  section: Team;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

const entries = await getCollection('team');

// `image()` çözümleyicisi şemada `ZodTypeAny` olarak tiplendiği için (bkz. content/schemas.ts)
// fotoğraf alanı `unknown` gelir — <Image /> için ImageMetadata'ya daraltıyoruz.
const team = [...entries]
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    name: entry.data.name,
    role: entry.data.role,
    photo: entry.data.photo as ImageMetadata | undefined,
  }));

/**
 * Fotoğrafı olmayan üyeler için baş harflerden monogram — "Fatih Demir" → "FD".
 *
 * Büyük harfe çevirme dile duyarlıdır: `tr-TR` "i" harfini "İ" yapar, bu da İngilizce
 * bir isimde ("Ian") yanlış olur. Bu yüzden sayfanın dili kullanılır.
 */
const CASE_TAGS: Record<Locale, string> = { tr: 'tr-TR', en: 'en-GB' };

function initials(name: string): string {
  const words = name.trim().split(/\s+/).filter(Boolean);
  const letters =
    words.length > 1 ? `${words[0]?.[0] ?? ''}${words[words.length - 1]?.[0] ?? ''}` : (words[0] ?? '').slice(0, 2);
  return letters.toLocaleUpperCase(CASE_TAGS[locale]);
}
---

{
  team.length > 0 && (
    <Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
      <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

      <ul class="team" role="list">
        {team.map((member, index) => (
          <li class="team__item" data-reveal data-reveal-index={index}>
            <div class="team__media">
              {member.photo ? (
                <Image class="team__photo" src={member.photo} alt={member.name} width={320} height={320} />
              ) : (
                <span class="team__monogram" aria-hidden="true">
                  {initials(member.name)}
                </span>
              )}
            </div>
            <h3 class="h3 team__name">{member.name}</h3>
            <p class="team__role">{member.role}</p>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--gap-section) var(--gap-card);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__media {
    aspect-ratio: 1 / 1;
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--t-slow);
  }

  .team__item:hover .team__media {
    border-color: var(--accent);
  }

  .team__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team__monogram {
    font: 600 clamp(34px, 5vw, 52px) / 1 var(--font-display);
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .team__name {
    margin-top: 18px;
  }

  .team__role {
    margin: 6px 0 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .team__media {
    border-color: var(--border-on-light);
  }

  :global(.section--light) .team__role {
    color: var(--text-muted-on-light);
  }

  @media (max-width: 720px) {
    .team {
      grid-template-columns: 1fr;
      max-width: 320px;
    }
  }
</style>
