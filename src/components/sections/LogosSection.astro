---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Logos = Extract<PageSection, { type: 'logos' }>;

interface Props {
  section: Logos;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

const references = await getCollection('references');

// `image()` çözümleyicisi şema tarafında `ZodTypeAny` ile tiplendiği için
// derleyiciye logonun bir ImageMetadata olduğu burada bildirilir.
const logos = [...references]
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ name: entry.data.name, logo: entry.data.logo as ImageMetadata }));

// Koleksiyon boşsa bölüm hiç basılmaz — boş bir şerit build'i kırmasın.
const hasLogos = logos.length > 0;

/*
 * Referans tasarımda bu bölümün başlığı iki sütundur: solda eyebrow + başlık,
 * sağda tanıtım paragrafı ve DÜZ metin ok bağlantısı (outline buton değil).
 * Bu yüzden `ctas` Section'a devredilmez; ilk CTA sağ sütunda link olarak basılır.
 */
const headLink = section.ctas[0];
const stripArrow = (label: string) => label.replace(/\s*→\s*$/, '');
---

{
  hasLogos && (
    <Section anchor={section.anchor} background={section.background} class="logos-section">
      <div class="logos-head">
        <div>
          <SectionHead eyebrow={section.eyebrow} heading={section.heading} />
        </div>
        <div class="logos-head__right">
          {section.lead && <p class="lead">{section.lead}</p>}
          {headLink && (
            <a class="logos-head__link" href={headLink.href}>
              {stripArrow(headLink.label)} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>

      <div
        class="logos"
        role="group"
        aria-label={t('logos.groupLabel', locale)}
        tabindex="0"
        data-reveal
        data-reveal-index={1}
      >
        <div class="logos__track">
          <ul class="logos__group">
            {logos.map((ref) => (
              <li class="logos__item">
                <Image
                  class="logos__logo"
                  src={ref.logo}
                  alt={`${ref.name} ${t('logos.altSuffix', locale)}`}
                  height={44}
                  densities={[1, 2]}
                />
              </li>
            ))}
          </ul>

          {/* Sonsuz akış için ikinci kopya — ekran okuyucudan gizli. */}
          <ul class="logos__group" aria-hidden="true">
            {logos.map((ref) => (
              <li class="logos__item">
                <Image class="logos__logo" src={ref.logo} alt="" height={44} densities={[1, 2]} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Section>
  )
}

<style>
  /* Referans: bu bölümün başlığı bir kademe küçüktür (max 48px). */
  .logos-head :global(.section-head .h2) {
    font-size: clamp(30px, 3.6vw, 48px);
  }

  .logos-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }

  .logos-head :global(.section-head) {
    margin-bottom: 0;
  }

  .logos-head__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    color: var(--text);
    font: 600 15px var(--font-display);
    text-decoration: none;
    transition: gap var(--t-slow);
  }

  .logos-head__link:hover {
    gap: 14px;
  }

  :global(.section--light) .logos-head__link {
    color: var(--text-on-light);
  }

  .logos {
    --logo-gap: clamp(48px, 6vw, 80px);

    overflow: hidden;
    margin-top: clamp(28px, 4vw, 44px);
    padding: 34px 0;
    /* Şerit kenarları zemine karışır. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .logos__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  /* Okunabilirlik: fare üzerindeyken veya klavye odağındayken akış durur. */
  .logos:hover .logos__track,
  .logos:focus-within .logos__track {
    animation-play-state: paused;
  }

  .logos__group {
    display: flex;
    align-items: center;
    /* Sondaki boşluk da gruba dahil — böylece -50% kaydırma dikişsiz olur. */
    gap: var(--logo-gap);
    padding: 0 var(--logo-gap) 0 0;
    margin: 0;
    list-style: none;
  }

  .logos__item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* <Image /> bileşen olduğu için basılan <img> :global ile hedeflenir. */
  .logos__item :global(img) {
    height: 44px;
    width: auto;
    transition: filter var(--t-slow);
  }

  /* Logo varlıkları beyaz tonlu — beyaz zeminde okunmaları için koyulaştırılır. */
  :global(.section--light) .logos__item :global(img) {
    filter: grayscale(1) brightness(0.45);
  }

  :global(.section--light) .logos__item :global(img):hover {
    filter: grayscale(0) brightness(1);
  }

  /* Hareket azaltma: akış durur, şerit elle kaydırılır. */
  @media (prefers-reduced-motion: reduce) {
    .logos {
      overflow-x: auto;
      overflow-y: hidden;
    }

    .logos__track {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .logos {
      --logo-gap: 40px;

      padding: 24px 0;
    }

    .logos__item :global(img) {
      height: 32px;
    }
  }
</style>
