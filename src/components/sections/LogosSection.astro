---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Logos = Extract<PageSection, { type: 'logos' }>;

interface Props {
  section: Logos;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

const references = await getCollection('references');
const sorted = [...references].sort((a, b) => a.data.order - b.data.order);

/*
 * İki görünüm, iki varlık kümesi: marquee beyaz tonlu `logo` alanını, duvar tek
 * renk `mark` maskesini basar. Alanı boş olan girdi ilgili görünümde yer almaz.
 */
const isWall = section.kind === 'wall';

// `image()` çözümleyicisi şema tarafında `ZodTypeAny` ile tiplendiği için
// derleyiciye görselin bir ImageMetadata olduğu burada bildirilir.
const logos = sorted
  .filter((entry) => Boolean(entry.data.logo))
  .map((entry) => ({ name: entry.data.name, logo: entry.data.logo as ImageMetadata }));

const marks = sorted
  .filter((entry) => Boolean(entry.data.mark))
  .map((entry) => ({ name: entry.data.name, mark: entry.data.mark as ImageMetadata }));

// Koleksiyon boşsa bölüm hiç basılmaz — boş bir şerit/duvar build'i kırmasın.
const hasLogos = isWall ? marks.length > 0 : logos.length > 0;

/*
 * Referans tasarımda bu bölümün başlığı iki sütundur: solda eyebrow + başlık,
 * sağda tanıtım paragrafı ve DÜZ metin ok bağlantısı (outline buton değil).
 * Bu yüzden `ctas` Section'a devredilmez; ilk CTA sağ sütunda link olarak basılır.
 */
const headLink = section.ctas[0];
const stripArrow = (label: string) => label.replace(/\s*→\s*$/, '');
---

{
  hasLogos && (
    <Section anchor={section.anchor} background={section.background} class="logos-section">
      <div class="logos-head">
        <div>
          <SectionHead eyebrow={section.eyebrow} heading={section.heading} />
        </div>
        <div class="logos-head__right">
          {section.lead && <p class="lead">{section.lead}</p>}
          {headLink && (
            <a class="logos-head__link" href={headLink.href}>
              {stripArrow(headLink.label)} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>

      {isWall && (
        <ul class="logo-wall" data-reveal data-reveal-index={1}>
          {marks.map((ref) => (
            <li class="logo-wall__item">
              {/*
               * Logo bir <img> değil, maskelenmiş bir yüzeydir: renk CSS'ten gelir,
               * böylece marka renkleri ne olursa olsun duvardaki her logo AYNI renktir.
               * Erişilebilirlik için görsel rolü ve marka adı elle verilir.
               */}
              <span
                class="logo-wall__mark"
                style={`--mark: url(${ref.mark.src})`}
                role="img"
                aria-label={`${ref.name} ${t('logos.altSuffix', locale)}`}
              />
            </li>
          ))}
        </ul>
      )}

      {!isWall && (
        <div
          class="logos"
          role="group"
          aria-label={t('logos.groupLabel', locale)}
          tabindex="0"
          data-reveal
          data-reveal-index={1}
        >
          <div class="logos__track">
            <ul class="logos__group">
              {logos.map((ref) => (
                <li class="logos__item">
                  <Image
                    class="logos__logo"
                    src={ref.logo}
                    alt={`${ref.name} ${t('logos.altSuffix', locale)}`}
                    height={44}
                    densities={[1, 2]}
                  />
                </li>
              ))}
            </ul>

            {/* Sonsuz akış için ikinci kopya — ekran okuyucudan gizli. */}
            <ul class="logos__group" aria-hidden="true">
              {logos.map((ref) => (
                <li class="logos__item">
                  <Image class="logos__logo" src={ref.logo} alt="" height={44} densities={[1, 2]} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </Section>
  )
}

<style>
  /*
   * --- Duvar: tek renk logo ızgarası ---
   * Hücreler arasındaki saç teli çizgiler hücrelerin KENDİ kenarlıklarıdır; ızgaranın
   * sağ/alt dışına taşan fazlalık negatif kenar boşluğuyla kırpılır, böylece dışta
   * çerçeve kalmaz ve son sıra eksik olsa bile ızgara açık uçlu görünür.
   */
  .logo-wall {
    display: grid;
    /*
     * Sütun sayısı BİLEREK sabit: `auto-fill` 5 sütun ürettiğinde 26 logonun son
     * sırasında tek başına bir logo kalıyor. 4 / 3 / 2 sütunda kalan hep 2'dir.
     */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(32px, 4.5vw, 52px) -1px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .logo-wall__item {
    display: grid;
    place-items: center;
    padding: clamp(24px, 2.8vw, 38px) clamp(16px, 2vw, 26px);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--t-slow);
  }

  /*
   * Maske tuvali 880×340 üretilir (bkz. scripts/logos/build-marks.mjs) ve her logo o
   * tuvalde optik olarak dengelenmiş boyuttadır. Oran burada birebir korunmalıdır,
   * yoksa `contain` yeniden ölçekler ve dengeleme bozulur.
   */
  .logo-wall__mark {
    display: block;
    width: 100%;
    max-width: 190px;
    aspect-ratio: 44 / 17;
    background-color: rgb(255 255 255 / 76%);
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
    transition: background-color var(--t-slow);
  }

  @media (hover: hover) {
    .logo-wall__item:hover {
      background-color: rgb(207 255 0 / 5%);
    }

    .logo-wall__item:hover .logo-wall__mark {
      background-color: #fff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-wall__item,
    .logo-wall__mark {
      transition: none;
    }
  }

  @media (max-width: 1020px) {
    .logo-wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .logo-wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .logo-wall__mark {
      max-width: 138px;
    }
  }

  /* Referans: bu bölümün başlığı bir kademe küçüktür (max 48px). */
  .logos-head :global(.section-head .h2) {
    font-size: clamp(30px, 3.6vw, 48px);
  }

  .logos-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }

  .logos-head :global(.section-head) {
    margin-bottom: 0;
  }

  .logos-head__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    /* Dokunma hedefi: 15px metin ~20px yükseklik veriyordu; padding
       eklendi, üst boşluk ondan düşüldü. */
    margin-top: 13px;
    padding-block: 5px;
    color: var(--text);
    font: 600 15px var(--font-display);
    text-decoration: none;
    transition: gap var(--t-slow);
  }

  .logos-head__link:hover {
    gap: 14px;
  }

  :global(.section--light) .logos-head__link {
    color: var(--text-on-light);
  }

  .logos {
    --logo-gap: clamp(48px, 6vw, 80px);

    overflow: hidden;
    margin-top: clamp(28px, 4vw, 44px);
    padding: 34px 0;
    /* Şerit kenarları zemine karışır. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .logos__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  /* Okunabilirlik: fare üzerindeyken veya klavye odağındayken akış durur. */
  .logos:hover .logos__track,
  .logos:focus-within .logos__track {
    animation-play-state: paused;
  }

  .logos__group {
    display: flex;
    align-items: center;
    /* Sondaki boşluk da gruba dahil — böylece -50% kaydırma dikişsiz olur. */
    gap: var(--logo-gap);
    padding: 0 var(--logo-gap) 0 0;
    margin: 0;
    list-style: none;
  }

  .logos__item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* <Image /> bileşen olduğu için basılan <img> :global ile hedeflenir. */
  .logos__item :global(img) {
    height: 44px;
    width: auto;
    transition: filter var(--t-slow);
  }

  /* Logo varlıkları beyaz tonlu — beyaz zeminde okunmaları için koyulaştırılır. */
  :global(.section--light) .logos__item :global(img) {
    filter: grayscale(1) brightness(0.45);
  }

  :global(.section--light) .logos__item :global(img):hover {
    filter: grayscale(0) brightness(1);
  }

  /* Hareket azaltma: akış durur, şerit elle kaydırılır. */
  @media (prefers-reduced-motion: reduce) {
    .logos {
      overflow-x: auto;
      overflow-y: hidden;
    }

    .logos__track {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .logos {
      --logo-gap: 40px;

      padding: 24px 0;
    }

    .logos__item :global(img) {
      height: 32px;
    }
  }

  /* Dokunmatik hedef: 29px'lik metin bağlantısı parmakla isabetli
     tıklanamıyordu. Apple HIG ve WCAG 2.5.5 en az 44px öneriyor; dikey
     dolgu yalnız dokunmatik girdide artırılır, masaüstü tipografisi
     değişmez. Aynı kalıp `.pb-filter` için zaten kullanılıyordu. */
  @media (pointer: coarse) {
    .logos-head__link {
      min-height: 44px;
      padding-block: 11px;
    }
  }
</style>
