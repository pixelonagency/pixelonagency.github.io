---
import type { PageSection } from '../../content/page-schema';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Stats = Extract<PageSection, { type: 'stats' }>;

interface Props {
  section: Stats;
}

const { section } = Astro.props;

/*
 * Rakamlar yalnız sayaç olarak durunca hepsi aynı ağırlıkta okunuyordu. Her
 * değer en büyüğe oranlanıp altına bir lime dolgu çizgisi basılıyor: 15 yıl ile
 * 500 fikir arasındaki fark artık görülüyor, yalnız okunmuyor. Oran sıfıra
 * bölünmesin diye en büyük değer 1'in altına düşemez.
 */
const maxValue = Math.max(1, ...section.items.map((item) => item.value));
const fillOf = (value: number) => Math.round(Math.max(6, (value / maxValue) * 100));
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas} class="section-stats">
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

  <dl class="stats">
    {
      section.items.map((item, index) => (
        <div class="stats__item" style={`--fill: ${fillOf(item.value)}%`} data-reveal data-reveal-index={index}>
          {/* Gerçek değer HTML'de basılır (SEO/GEO: tarayıcılar JS olmadan okur);
              sayaç animasyonu görünürken 0'dan yeniden sayar. */}
          <dt class="stats__value">
            {item.prefix}
            <span data-counter data-counter-to={item.value}>
              {item.value}
            </span>
            {item.suffix}
          </dt>
          <span class="stats__bar" aria-hidden="true" />
          <dd class="stats__label">
            <span class="stats__label-text">{item.label}</span>
            {item.description && <span class="stats__description">{item.description}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  /* İnce çizgi ayraçlı kutu: dış kenarlık + 1px boşluk (zemin rengiyle) hücreler arası
     hairline oluşturuyor — referans tasarımdaki teknik. */
  .stats {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    /* Referans: bu ızgaranın köşe yarıçapı 20px (feature'daki 24 değil). */
    border-radius: 20px;
    overflow: hidden;
    margin: clamp(40px, 5vw, 64px) 0 0;
  }

  /* Referans: bölüm butonu lime kenarlıklı outline'dır (dolgulu değil). */
  :global(.section-stats .section__ctas .btn--outline) {
    border-color: rgba(207, 255, 0, 0.5);
    color: var(--accent);
  }

  /*
   * Altı sütun üzerinde 3+2 ritmi: ilk üç hücre ikişer, son iki hücre üçer sütun.
   * Beş eşit kutu bölümü basit bir sayaç şeridine çeviriyordu; `auto-fit` ise son
   * sırayı yarım bırakıp sağda boşluk açıyordu.
   */
  .stats__item {
    grid-column: span 2;
  }

  .stats:has(.stats__item:nth-child(5)):not(:has(.stats__item:nth-child(6))) .stats__item:nth-child(n + 4) {
    grid-column: span 3;
  }

  .stats__bar {
    display: block;
    width: 100%;
    height: 3px;
    margin: 14px 0 2px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 10%);
    overflow: hidden;
  }

  .stats__bar::after {
    content: '';
    display: block;
    width: var(--fill);
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }

  :global(.section--light) .stats__bar {
    background: rgb(10 10 10 / 10%);
  }

  .stats__item {
    background: var(--bg);
    padding: 36px 28px;
    /* Değerin puntosu hücre genişliğine bağlanabilsin diye kapsayıcı. */
    container-type: inline-size;
  }

  /*
   * Punto ekran genişliğine DEĞİL hücre genişliğine bağlıdır.
   *
   * Ekrana bağlıyken öğe sayısı arttıkça hücre daralıyor ama punto sabit
   * kalıyordu: beş öğede "₺80M+" hücresini 38px aşıp ayraç çizgisine
   * giriyordu. `cqi` ile punto hücreyle birlikte küçülür, öğe sayısı ne
   * olursa olsun taşma olmaz.
   */
  .stats__value {
    font: 600 clamp(34px, 28cqi, 64px) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .stats__label {
    margin: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stats__label-text {
    font: 600 16px var(--font-display);
    color: var(--text);
  }

  .stats__description {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  :global(.section--light) .stats__item {
    background: var(--bg-light);
  }

  :global(.section--light) .stats__label-text {
    color: var(--text-on-light);
  }

  :global(.section--light) .stats__description {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .stats {
    background: var(--border-on-light);
    border-color: var(--border-on-light);
  }

  :global(.section--light) .stats__value {
    color: var(--text-on-light);
    /* Referans: açık zeminli sayaçlar bir kademe küçüktür (max 58px). */
    font-size: clamp(40px, 4.2vw, 58px);
  }
</style>

<script>
  // Sayaç: eleman viewport'a girince 0'dan hedef değere sayar.
  const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
  const DURATION = 1600;

  const runCount = (element: HTMLElement) => {
    const target = Number(element.dataset.counterTo ?? 0);
    const start = performance.now();

    const step = (now: number) => {
      const progress = Math.min((now - start) / DURATION, 1);
      // easeOutCubic — sonlara doğru yavaşlar
      const eased = 1 - Math.pow(1 - progress, 3);
      element.textContent = String(Math.round(target * eased));
      if (progress < 1) requestAnimationFrame(step);
    };

    requestAnimationFrame(step);
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (counters.length > 0) {
    if (reduceMotion || !('IntersectionObserver' in window)) {
      for (const element of counters) element.textContent = element.dataset.counterTo ?? '0';
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            runCount(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.4 },
      );

      for (const element of counters) observer.observe(element);
    }
  }
</script>
