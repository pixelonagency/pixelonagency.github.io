---
/**
 * Öne çıkan tek yazı kartı.
 *
 * İçeriğin tamamı posts koleksiyonundan gelir — bu bölümde elle yazılan
 * başlık/özet/tarih alanı YOKTUR. Daha önce bu blok sabit metinle yazılmıştı
 * ve kartın anlattığı yazı ile açtığı yazı birbirinden ayrışmıştı.
 *
 * Seçim sırası: sabitlenmiş `slug` → `featured: true` olan en yeni yazı →
 * genel olarak en yeni yazı.
 */
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import type { PageSection } from '../../content/page-schema';
import { formatDate, isoDate, readingTime } from '../../lib/format';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';
import { blocksText } from '../article/types';
import Section from './Section.astro';

type FeaturedPost = Extract<PageSection, { type: 'featuredPost' }>;

interface Props {
  section: FeaturedPost;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

const all = await getCollection('posts', ({ data }) => data.status === 'published');
const inLocale = all.filter((entry) => entry.id.startsWith(`${locale}/`));
const entries = inLocale.length > 0 ? inLocale : all.filter((entry) => entry.id.startsWith(`${DEFAULT_LOCALE}/`));
const slugOf = (id: string) => id.split('/').slice(1).join('/');

const newestFirst = [...entries].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const post =
  (section.slug ? newestFirst.find((entry) => slugOf(entry.id) === section.slug) : undefined) ??
  newestFirst.find((entry) => entry.data.featured) ??
  newestFirst[0];

const cover: ImageMetadata | undefined =
  post?.data.cover && typeof post.data.cover === 'object' && 'src' in post.data.cover
    ? (post.data.cover as ImageMetadata)
    : undefined;

/* Okuma süresi bloklu yazılarda gövdeden değil bloklardan hesaplanır. */
const minutes = post
  ? readingTime(post.data.article?.blocks.length ? blocksText(post.data.article.blocks) : (post.body ?? ''))
  : 0;

const shown = post?.data.article?.updated ?? post?.data.date;
const href = post ? localizedPath('blog', locale, slugOf(post.id)) : '';
---

{
  post && (
    <Section anchor={section.anchor} background={section.background} ctas={section.ctas} class="fp-section">
      {section.eyebrow && <p class="eyebrow fp__eyebrow">{section.eyebrow}</p>}

      <a class="fp" href={href}>
        {cover && (
          <span class="fp__media">
            <Picture
              src={cover}
              alt={post.data.coverAlt ?? post.data.title}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[480, 800, 1200]}
              sizes="(max-width: 900px) 100vw, 50vw"
              quality={72}
              loading="lazy"
              decoding="async"
            />
          </span>
        )}

        <span class="fp__body">
          <span class="fp__category">{post.data.category}</span>
          <h2 class="fp__title">{post.data.title}</h2>
          <p class="fp__excerpt">{post.data.excerpt}</p>

          <span class="fp__meta">
            <span>
              {minutes} {t('blog.readingTime', locale)}
            </span>
            <span aria-hidden="true">·</span>
            {shown && <time datetime={isoDate(shown)}>{formatDate(shown, locale)}</time>}
            <span aria-hidden="true">·</span>
            <span>{post.data.author}</span>
          </span>

          <span class="fp__cta">
            {section.ctaLabel ?? t('blog.readPost', locale)} <span aria-hidden="true">→</span>
          </span>
        </span>
      </a>
    </Section>
  )
}

<style>
  .fp__eyebrow {
    margin: 0 0 clamp(16px, 2vw, 24px);
  }

  .fp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-tint);
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition:
      border-color var(--t-slow),
      transform var(--t-slow);
  }

  .fp:hover {
    border-color: var(--accent);
    transform: translateY(-6px);
  }

  .fp__media {
    display: block;
    overflow: hidden;
    background: rgb(10 10 10 / 4%);
  }

  .fp__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease-out);
  }

  .fp:hover .fp__media :global(img) {
    transform: scale(1.03);
  }

  .fp__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(24px, 3.4vw, 44px);
  }

  .fp__category {
    font: 600 12px var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted-on-light);
  }

  .fp__title {
    margin: 0;
    font: 600 clamp(24px, 2.8vw, 36px) / 1.18 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text-on-light);
  }

  .fp__excerpt {
    margin: 0;
    max-width: 52ch;
    font: 400 var(--fs-lead) / 1.7 var(--font-body);
    color: var(--text-muted-on-light);
  }

  .fp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font: 500 var(--fs-small) var(--font-display);
    color: var(--text-muted-on-light);
  }

  .fp__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    font: 600 15px var(--font-display);
    color: var(--text-on-light);
  }

  /* Koyu zeminli varyant */
  :global(.section--dark) .fp {
    background: rgb(255 255 255 / 4%);
    border-color: var(--border);
  }

  :global(.section--dark) .fp__title,
  :global(.section--dark) .fp__cta {
    color: var(--text);
  }

  :global(.section--dark) .fp__excerpt,
  :global(.section--dark) .fp__category,
  :global(.section--dark) .fp__meta {
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .fp {
      grid-template-columns: 1fr;
    }

    .fp__media :global(img) {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp,
    .fp__media :global(img) {
      transition: none;
    }

    .fp:hover,
    .fp:hover .fp__media :global(img) {
      transform: none;
    }
  }
</style>
