---
import CtaButton from '../CtaButton.astro';

interface Cta {
  label: string;
  href: string;
  variant: 'primary' | 'outline' | 'link';
  icon?: 'whatsapp' | 'phone' | 'arrow' | undefined;
  external?: boolean;
}

interface Props {
  anchor?: string | undefined;
  background?: 'dark' | 'light' | 'accent';
  class?: string | undefined;
  /** Bölüm içeriğinin ALTINDA gösterilen bölüm düzeyi butonları. */
  ctas?: readonly Cta[] | undefined;
  ctaAlign?: 'start' | 'center';
}

/* Bölüm sonu butonları referans tasarımda ortalanmıştır — varsayılan 'center'. */
const { anchor, background = 'dark', class: className, ctas = [], ctaAlign = 'center' }: Props = Astro.props;
---

{
  /* data-reveal bölümün KENDİSİNE değil konteynere uygulanır: bölüm zemini her zaman
    boyalı kalır — aksi halde kaydırma sırasında açık bölümler görünür olana dek
    şeffaflaşıp arkadaki koyu gövde "siyah alan" olarak parlıyordu. */
}
<section id={anchor} class:list={['section', `section--${background}`, className]}>
  <div class="container" data-reveal>
    <slot />

    {
      ctas.length > 0 && (
        <div class:list={['section__ctas', ctaAlign === 'center' && 'section__ctas--center']}>
          {ctas.map((cta) => (
            <CtaButton
              label={cta.label}
              href={cta.href}
              variant={cta.variant}
              icon={cta.icon}
              external={cta.external ?? false}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  /*
   * Lime zemin: koyu ve açık bölümlerin arasında bilinçli bir duraklama. Metin
   * renkleri açık zeminle aynı mantıkta koyuya döner; lime üzerine lime vurgusu
   * çalışmadığı için eyebrow ve vurgular da koyu tonlarla basılır.
   */
  .section--accent {
    background: var(--accent);
    color: var(--bg);
  }

  .section--accent :global(.h1),
  .section--accent :global(.h2),
  .section--accent :global(.h3) {
    color: var(--bg);
  }

  .section--accent :global(.lead),
  .section--accent :global(.body-text) {
    color: rgb(10 10 10 / 72%);
  }

  .section--accent :global(.section-head__eyebrow) {
    color: rgb(10 10 10 / 62%);
  }

  .section--light {
    background: var(--bg-light);
    color: var(--text-on-light);
  }

  .section--light :global(.h1),
  .section--light :global(.h2),
  .section--light :global(.h3) {
    color: var(--text-on-light);
  }

  .section--light :global(.lead),
  .section--light :global(.body-text) {
    color: var(--text-muted-on-light);
  }

  .section--light :global(.card) {
    border-color: var(--border-on-light);
  }

  .section__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(32px, 4vw, 48px);
  }

  .section__ctas--center {
    justify-content: center;
  }

  /* Bölüm sonu butonları hero butonlarından bir kademe küçüktür (referans: 15px / 16-17×28-34). */
  .section__ctas :global(.btn) {
    font-size: 15px;
    padding: 16px 30px;
  }

  /* Açık zeminde outline buton koyu kenarlık/metin alır. */
  .section--light .section__ctas :global(.btn--outline) {
    border-color: var(--border-on-light);
    color: var(--text-on-light);
  }

  .section--light .section__ctas :global(.btn--outline:hover) {
    border-color: var(--text-on-light);
    color: var(--text-on-light);
  }

  /* Referans: açık zeminde dolgulu bölüm butonu SİYAHTIR (lime değil). */
  .section--light .section__ctas :global(.btn--primary) {
    background: var(--text-on-light);
    color: #fff;
  }

  .section--light .section__ctas :global(.btn--primary:hover) {
    background: var(--bg-footer);
    color: var(--accent);
  }

  /* Referans: bölüm sonu düz bağlantıları lime olur ("Markanıza özel çözümümüzü keşfedin →"). */
  .section__ctas :global(.cta-link) {
    color: var(--accent);
  }

  .section__ctas :global(.cta-link:hover) {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .section__ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
