---
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import CtaButton from '../CtaButton.astro';
import SectionHead from '../SectionHead.astro';
import ContactFormFields from './ContactFormFields.astro';
import Section from './Section.astro';

type Contact = Extract<PageSection, { type: 'contact' }>;

interface Props {
  section: Contact;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;
---

<Section anchor={section.anchor} background={section.background} class="contact">
  <div class="contact__grid">
    <div class="contact__intro" data-reveal data-reveal-index={0}>
      <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

      {
        section.ctas.length > 0 && (
          <div class="contact__ctas">
            {section.ctas.map((item) => (
              <CtaButton
                label={item.label}
                href={item.href}
                variant={item.variant}
                icon={item.icon}
                external={item.external}
              />
            ))}
          </div>
        )
      }

      <dl class="contact__info">
        {
          section.contactItems.map((item) => (
            <div class="contact__info-item">
              <dt class="contact__info-label">{item.label}</dt>
              <dd class="contact__info-value">{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="contact__form-card" data-reveal data-reveal-index={1}>
      <h3 class="h3">{section.formHeading}</h3>
      {section.formLead && <p class="body-text contact__form-lead">{section.formLead}</p>}

      <ContactFormFields
        formId={section.formId}
        heading={section.formHeading}
        submitLabel={section.submitLabel}
        successHeading={section.successHeading}
        successBody={section.successBody}
        successNote={section.successNote}
        successCtas={section.successCtas}
        errorHeading={section.errorHeading}
        errorBody={section.errorBody}
        {locale}
      />
    </div>
  </div>
</Section>

<style>
  .contact :global(.container) {
    position: relative;
  }

  .contact {
    background-image: radial-gradient(ellipse 50% 55% at 15% 15%, var(--accent-soft), transparent 60%);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: clamp(36px, 5vw, 80px);
    align-items: start;
  }

  .contact__intro :global(.section-head) {
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .contact__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  /* Referans: bu bölümün başlığı en büyüğüdür (max 60px). */
  .contact :global(.section-head .h2) {
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.06;
  }

  /* Referans: iletişim bilgileri yatay sıralanır — çizgisiz, gri etiket + 20px değer. */
  .contact__info {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 32px;
    margin: 0;
  }

  .contact__info-label {
    margin: 0;
    font: 600 12px var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .contact__info-value {
    margin: 8px 0 0;
    font: 600 20px / 1.4 var(--font-display);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .contact__info-value a {
    color: inherit;
    text-decoration: none;
    transition: color var(--t-base);
  }

  .contact__info-value a:hover {
    color: var(--accent);
  }

  .contact__form-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-feature);
    padding: clamp(28px, 3.5vw, 44px);
  }

  .contact__form-card .h3 {
    margin-bottom: 8px;
  }

  .contact__form-lead {
    margin-bottom: 24px;
  }

  .contact__form-card :global(.form) {
    margin-top: 4px;
  }

  /* Açık zeminli varyant */
  :global(.section--light) .contact__info-label {
    color: rgba(10, 10, 10, 0.45);
  }

  :global(.section--light) .contact__info-value {
    color: var(--text-on-light);
  }

  :global(.section--light) .contact__form-card {
    background: #fff;
    border-color: var(--border-on-light);
  }
</style>
