---
import type { PageSection } from '../../content/page-schema';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';
import { inlineHtml } from '../article/types';

type Steps = Extract<PageSection, { type: 'steps' }>;

interface Props {
  section: Steps;
}

const { section } = Astro.props;

// Sıra numarası içerikte tutulmaz — 01, 02, 03… burada üretilir.
const steps = section.items.map((item, index) => ({
  ...item,
  number: String(index + 1).padStart(2, '0'),
}));
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

  <ol class="steps">
    {
      steps.map((item, index) => (
        <li class="steps__item" data-reveal data-reveal-index={index}>
          <span class="steps__number" aria-hidden="true">
            {item.number}
          </span>
          <h3 class="h3 steps__title">{item.title}</h3>
          <p class="body-text steps__text" set:html={inlineHtml(item.description)} />
        </li>
      ))
    }
  </ol>
</Section>

<style>
  /* Referans tasarım: adımlar çerçeveli KARTLAR halinde, sabit 3 sütunlu ızgarada durur. */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps__item {
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 30px;
  }

  .steps__number {
    display: block;
    font: 700 clamp(36px, 3vw, 48px) / 1 var(--font-display);
    letter-spacing: -0.02em;
    /* Referans tasarımda rakamlar dolu değil, yalnızca lime çerçeveli (outline). */
    color: transparent;
    -webkit-text-stroke: 1px rgba(207, 255, 0, 0.8);
  }

  .steps__title {
    margin: 18px 0 0;
  }

  .steps__text {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.65;
    max-width: 40ch;
  }

  /* Açık zeminli varyant — referansta numara konturu koyudur. */
  :global(.section--light) .steps__item {
    border-color: var(--border-on-light);
  }

  :global(.section--light) .steps__number {
    -webkit-text-stroke: 1px rgba(10, 10, 10, 0.7);
  }

  :global(.section--light) .steps__title {
    color: var(--text-on-light);
  }

  :global(.section--light) .steps__text {
    color: var(--text-muted-on-light);
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
