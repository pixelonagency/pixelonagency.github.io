---
import type { PageSection } from '../../content/page-schema';
import ProcessIcon from '../ProcessIcon.astro';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Process = Extract<PageSection, { type: 'process' }>;

interface Props {
  section: Process;
}

const { section } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
---

<Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
  <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

  <ol class="proc" role="list">
    {
      section.items.map((item, index) => (
        <li class="proc__card" data-reveal data-reveal-index={index}>
          {/* Pencere noktaları — kartı bir arayüz penceresi gibi okutur. */}
          <span class="proc__dots" aria-hidden="true">
            <i /> <i /> <i />
          </span>

          <span class="proc__no" aria-hidden="true">
            /{pad(index + 1)}
          </span>

          <span class="proc__icon">
            <ProcessIcon name={item.icon} />
          </span>

          <h3 class="proc__title">
            <span class="proc__mark">{item.title}</span>
          </h3>
          <p class="proc__text">{item.description}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  /*
   * Referanstaki dağınık kart düzeni: kartlar eşit ızgarada değil, dönüşümlü
   * yukarı/aşağı kayar ve hafifçe eğilir. Sayfadaki diğer beş bölüm hizalı
   * ızgara kullanıyor — süreç bölümü bilinçli olarak o ritmi kırar.
   *
   * Tam lime zemin KULLANILMADI: lime sayfada zaten dört yerde aksan (rakam
   * bandı, ilkeler hover'ı, kapsam süpürmesi, hero) ve bölüm zeminleri
   * koyu/açık dönüşümlü akıyor. Referansın karakteri kartlarda ve fosforlu
   * kalem vurgusunda taşınıyor, zeminde değil.
   */
  .proc {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: start;
    gap: 18px;
    margin: 56px 0 0;
    padding: 0 0 20px;
    list-style: none;
  }

  .proc__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 22px 20px 26px;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 20px;
    /*
     * Koyu bölümde kart zeminden AYRIŞMALI: referansta koyu kartlar açık
     * zemin üzerindeydi, kontrast oradan geliyordu. Zemin rengiyle aynı
     * bırakıldığında kartlar kayboluyordu — yüzey bir ton yükseltildi.
     */
    background: #151515;
    box-shadow: 0 18px 44px rgb(0 0 0 / 32%);
    transition:
      transform var(--t-base),
      border-color var(--t-base),
      box-shadow var(--t-base);
  }

  /* Dönüşümlü kayma ve eğim — dizilimin "elle atılmış" hissi buradan gelir. */
  .proc__card:nth-child(odd) {
    transform: translateY(0) rotate(-1.6deg);
  }

  .proc__card:nth-child(even) {
    transform: translateY(38px) rotate(1.4deg);
  }

  .proc__card:hover {
    transform: translateY(-6px) rotate(0deg);
    border-color: var(--accent);
    box-shadow: 0 24px 60px rgb(0 0 0 / 45%);
  }

  .proc__card:nth-child(even):hover {
    transform: translateY(30px) rotate(0deg);
  }

  /* Kesikli bağlantı: her kartın sağından bir sonrakine uzanır. */
  .proc__card::after {
    content: '';
    position: absolute;
    top: 34px;
    left: 100%;
    width: 18px;
    border-top: 1.5px dashed rgb(255 255 255 / 22%);
  }

  .proc__card:last-child::after {
    content: none;
  }

  .proc__dots {
    display: flex;
    gap: 5px;
  }

  .proc__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(255 255 255 / 22%);
  }

  .proc__dots i:first-child {
    background: #ff5f57;
  }

  .proc__dots i:nth-child(2) {
    background: #febc2e;
  }

  .proc__dots i:nth-child(3) {
    background: #28c840;
  }

  .proc__no {
    position: absolute;
    top: 20px;
    right: 20px;
    font: 600 15px/1 var(--font-display);
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 55%);
    transition: color var(--t-base);
  }

  .proc__card:hover .proc__no {
    color: var(--accent);
  }

  .proc__icon {
    display: block;
    margin-top: 6px;
    color: var(--text);
  }

  .proc__icon :global(svg) {
    display: block;
    width: 34px;
    height: 34px;
  }

  .proc__title {
    margin: 0;
    font: 600 clamp(16px, 1.35vw, 19px) / 1.3 var(--font-display);
  }

  /* Fosforlu kalem vurgusu — referansın imzası. */
  .proc__mark {
    display: inline;
    padding: 2px 7px;
    background: var(--accent);
    color: var(--bg);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .proc__text {
    margin: 0;
    font: 400 14px/1.6 var(--font-body);
    color: var(--text-muted);
  }

  /* Açık zeminde kart saf koyu kalır — referanstaki maksimum kontrast. */
  :global(.section--light) .proc__card {
    border-color: rgb(10 10 10 / 12%);
    background: var(--bg);
  }

  :global(.section--light) .proc__card::after {
    border-top-color: rgb(10 10 10 / 22%);
  }

  @media (max-width: 1020px) {
    .proc {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 18px;
    }

    .proc__card:nth-child(even) {
      transform: translateY(24px) rotate(1.4deg);
    }

    .proc__card:nth-child(even):hover {
      transform: translateY(18px) rotate(0deg);
    }

    /* İki sütunda yatay bağlantı çizgisi anlamını yitirir. */
    .proc__card::after {
      content: none;
    }
  }

  @media (max-width: 720px) {
    .proc {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-bottom: 0;
    }

    /* Tek sütunda eğim okumayı zorlaştırır — kartlar düzleşir. */
    .proc__card,
    .proc__card:nth-child(odd),
    .proc__card:nth-child(even) {
      transform: none;
    }

    .proc__card:hover,
    .proc__card:nth-child(even):hover {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proc__card,
    .proc__no {
      transition: none;
    }
  }
</style>
