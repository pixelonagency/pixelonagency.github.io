---
import { getCollection } from 'astro:content';
import type { PageSection } from '../../content/page-schema';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Services = Extract<PageSection, { type: 'services' }>;

interface Props {
  section: Services;
}

const { section } = Astro.props;

// Hizmetler koleksiyondan gelir; sıra editörün belirlediği `order` alanına göredir.
const entries = await getCollection('services');
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
const services = section.limit ? sorted.slice(0, section.limit) : sorted;
---

{
  services.length > 0 && (
    <Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
      <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

      <ul class="services" role="list">
        {services.map((service, index) => (
          <li class="services__cell">
            <a class="card services__item" href={`/hizmetlerimiz/${service.id}`} data-reveal data-reveal-index={index}>
              <span class="services__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="h3 services__title">{service.data.title}</h3>
              <p class="body-text services__text">{service.data.hero.lead}</p>
              <span class="services__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--gap-card);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services__cell {
    display: flex;
  }

  .services__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .services__index {
    font: 600 var(--fs-small) var(--font-display);
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-faint);
  }

  .services__title {
    margin-top: 4px;
  }

  .services__text {
    flex: 1;
  }

  .services__arrow {
    margin-top: 6px;
    font: 600 18px var(--font-display);
    line-height: 1;
    color: var(--accent);
    align-self: flex-end;
    transition: transform var(--t-slow);
  }

  .services__item:hover .services__arrow,
  .services__item:focus-visible .services__arrow {
    transform: translateX(4px);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .services__index {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .services__arrow {
    color: var(--text-on-light);
  }

  @media (max-width: 720px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>
