---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { PageSection } from '../../content/page-schema';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../lib/i18n';
import { menuServices } from '../../lib/nav';
import { t } from '../../lib/ui';
import SectionHead from '../SectionHead.astro';
import Section from './Section.astro';

type Services = Extract<PageSection, { type: 'services' }>;

interface Props {
  section: Services;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

/*
 * `showcase` = ana sayfadaki 6'lı editoryal kart vitrini. Kartlar içerikteki
 * `items`ten gelir; her kart kendi hizmet detay sayfasına bağlanır. Şema
 * çözümleyicisi görseli geniş tiplediği için <Image /> öncesi daraltılır.
 */
const explicitItems = (section.items ?? []).map((item) => ({
  ...item,
  image: item.image as ImageMetadata | undefined,
}));

// Hizmetler koleksiyondan gelir; sıra editörün belirlediği `order` alanına göredir.
const all = await getCollection('services');

/**
 * Girdi kimliği `<locale>/<slug>` biçimindedir. Bu dile ait girdi yoksa varsayılan
 * dildekiler gösterilir — çeviri tamamlanmadan sayfa boş kalmaz.
 */
const inLocale = all.filter((entry) => entry.id.startsWith(`${locale}/`));
const entries = inLocale.length > 0 ? inLocale : all.filter((entry) => entry.id.startsWith(`${DEFAULT_LOCALE}/`));
const slugOf = (id: string) => id.split('/').slice(1).join('/');
const sorted = menuServices(entries);
const services = section.limit ? sorted.slice(0, section.limit) : sorted;

/*
 * Vitrin kartları KOLEKSİYONDAN üretilir: başlık `navLabel`, metin `summary`,
 * görsel `cover`. Böylece bir hizmetin adı ya da görseli tek bir yerden
 * değiştirildiğinde header dropdown'ı, anasayfa vitrini ve hizmetler sayfası
 * birlikte değişir. `items` yalnız istisnai bir sayfa için elle kart yazmak
 * gerekirse kullanılır ve verildiğinde koleksiyonun önüne geçer.
 */
const collectionItems = services.map((entry) => ({
  service: slugOf(entry.id),
  title: entry.data.navLabel,
  description: entry.data.summary ?? '',
  image: entry.data.cover as ImageMetadata | undefined,
  imageAlt: undefined as string | undefined,
}));
const showcaseItems = explicitItems.length > 0 ? explicitItems : collectionItems;
const isShowcase = section.kind === 'showcase' && showcaseItems.length > 0;
---

{
  isShowcase ? (
    <Section anchor={section.anchor} background={section.background} ctas={section.ctas} class="services-showcase">
      {/* Editoryal giriş: büyük başlık solda, kısa açıklama sağda alt hizalı. */}
      <div class="showcase__head">
        <SectionHead eyebrow={section.eyebrow} heading={section.heading} />
        {section.lead && <p class="lead showcase__lead">{section.lead}</p>}
      </div>

      <ul class="showcase" role="list">
        {showcaseItems.map((item, index) => (
          <li class="showcase__cell">
            <a
              class="showcase__card"
              href={localizedPath('services', locale, item.service)}
              data-reveal
              data-reveal-index={index * 1.5}
            >
              <span class="showcase__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>

              {item.image && (
                <div class="showcase__media">
                  <Image
                    src={item.image}
                    alt={item.imageAlt ?? item.title}
                    widths={[480, 760, 1140]}
                    sizes="(max-width: 720px) 100vw, (max-width: 1020px) 50vw, 33vw"
                    loading="lazy"
                    decoding="async"
                    class="showcase__image"
                  />
                </div>
              )}

              <div class="showcase__body">
                <h3 class="showcase__title">{item.title}</h3>
                <p class="showcase__text">{item.description}</p>
                <span class="showcase__more">
                  {t('services.viewDetails', locale)}
                  <span class="showcase__arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  ) : services.length > 0 ? (
    <Section anchor={section.anchor} background={section.background} ctas={section.ctas}>
      <SectionHead eyebrow={section.eyebrow} heading={section.heading} lead={section.lead} />

      <ul class="services" role="list">
        {services.map((service, index) => (
          <li class="services__row">
            <a
              class="services__link"
              href={localizedPath('services', locale, slugOf(service.id))}
              data-reveal
              data-reveal-index={index}
            >
              <span class="services__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="h3 services__title">{service.data.title}</h3>
              <p class="body-text services__text">{service.data.hero.lead}</p>
              <span class="services__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  ) : null
}

<style>
  /* ============ Showcase (ana sayfa 6'lı vitrin) ============ */

  /* Editoryal giriş: başlık solda, açıklama sağda — taban çizgisine hizalı. */
  .showcase__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .showcase__head :global(.section-head) {
    margin-bottom: 0;
  }

  .showcase__lead {
    max-width: 440px;
    justify-self: end;
    padding-bottom: 6px;
  }

  .showcase {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .showcase__cell {
    display: flex;
  }

  /* Kart: zeminden bir tık açık grafit, ince çerçeve, kontrollü radius. */
  .showcase__card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: color-mix(in srgb, var(--text) 3.5%, var(--bg));
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 22px 22px 26px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform var(--t-slow) var(--ease-out),
      border-color var(--t-slow),
      box-shadow var(--t-slow);
  }

  /* Üst kenarda ince lime imza çizgisi — hover/focus'ta soldan sağa açılır. */
  .showcase__card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .showcase__card:hover,
  .showcase__card:focus-visible {
    transform: translateY(-6px);
    border-color: rgba(207, 255, 0, 0.45);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
  }

  .showcase__card:hover::after,
  .showcase__card:focus-visible::after {
    transform: scaleX(1);
  }

  .showcase__card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .showcase__num {
    font: 600 13px var(--font-display);
    letter-spacing: 0.14em;
    color: var(--text-faint);
    margin-bottom: 16px;
    transition: color var(--t-slow);
  }

  .showcase__card:hover .showcase__num,
  .showcase__card:focus-visible .showcase__num {
    color: var(--accent);
  }

  /* 3:2 kapak — konteyner oranı sabit: görsel yüklenirken yerleşim kaymaz. */
  .showcase__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 12px;
  }

  .showcase__media :global(.showcase__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s var(--ease-out);
  }

  .showcase__card:hover .showcase__image,
  .showcase__card:focus-visible .showcase__image {
    transform: scale(1.04);
  }

  .showcase__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
    padding-top: 20px;
  }

  .showcase__title {
    margin: 0;
    font: 600 20px var(--font-display);
    color: var(--text);
  }

  .showcase__text {
    flex: 1;
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .showcase__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font: 600 14px var(--font-display);
    color: var(--text);
  }

  .showcase__arrow {
    color: var(--accent);
    transition: transform var(--t-slow) var(--ease-out);
  }

  .showcase__card:hover .showcase__arrow,
  .showcase__card:focus-visible .showcase__arrow {
    transform: translateX(5px);
  }

  /* CTA'nın grid ile nefes payı — Section'ın kendi ctas satırı kullanılır. */
  :global(.services-showcase .section__ctas) {
    margin-top: clamp(40px, 5vw, 64px);
  }

  @media (max-width: 1020px) {
    .showcase {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .showcase__head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .showcase__lead {
      justify-self: start;
      padding-bottom: 0;
    }
  }

  @media (max-width: 720px) {
    .showcase {
      grid-template-columns: 1fr;
    }

    .showcase__card {
      padding: 18px 18px 22px;
    }
  }

  /* ============ Satır listesi (varsayılan) ============ */

  /* Referans tasarımda hizmetler kart ızgarası değil, numaralı tam genişlik satır listesidir. */
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services__row {
    border-top: 1px solid var(--border);
  }

  .services__row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .services__link {
    display: grid;
    grid-template-columns: 64px 1fr 1.2fr 40px;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    padding: 26px 12px;
    text-decoration: none;
    color: inherit;
    transition:
      background var(--t-slow),
      padding-left var(--t-slow);
  }

  .services__link:hover,
  .services__link:focus-visible {
    background: rgba(207, 255, 0, 0.06);
    padding-left: 24px;
  }

  .services__index {
    font: 600 var(--fs-small) var(--font-display);
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-faint);
  }

  .services__title,
  .services__text {
    margin: 0;
  }

  /* Referans: satır başlığı masaüstünde 24px'e ölçeklenir (sabit 19px değil). */
  .services__title {
    font: 600 clamp(18px, 1.8vw, 24px) var(--font-display);
  }

  .services__text {
    font-size: 14px;
    line-height: 1.6;
  }

  .services__arrow {
    justify-self: end;
    font: 600 22px var(--font-display);
    line-height: 1;
    color: var(--accent);
    transition: transform var(--t-slow);
  }

  .services__link:hover .services__arrow,
  .services__link:focus-visible .services__arrow {
    transform: translateX(4px);
  }

  /* Açık zeminli varyant */
  :global(.section--light) .services__row {
    border-top-color: var(--border-on-light);
  }

  :global(.section--light) .services__row:last-child {
    border-bottom-color: var(--border-on-light);
  }

  :global(.section--light) .services__index {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .services__arrow {
    color: var(--text-on-light);
  }

  @media (max-width: 720px) {
    .services__link {
      grid-template-columns: 44px 1fr 28px;
    }

    /* Açıklama satırı dar ekranda gizlenir — referanstaki data-hide-m davranışı. */
    .services__text {
      display: none;
    }
  }
</style>
