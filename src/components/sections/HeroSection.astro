---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PageSection } from '../../content/page-schema';
import { parseHighlights } from '../../lib/highlight';
import { breadcrumbSchema, toJsonLd } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';
import CtaButton from '../CtaButton.astro';
import PlatformLogo, { PLATFORM_COLORS } from '../PlatformLogo.astro';

type Hero = Extract<PageSection, { type: 'hero' }>;

interface Props {
  section: Hero;
  locale?: Locale;
}

const { section, locale = DEFAULT_LOCALE } = Astro.props;

// Şema çözümleyicisi geniş tiplediği için <Image /> öncesi daraltılır.
const heroImage = section.image as ImageMetadata | undefined;

/*
 * Referans: hero ölçüsü sayfa tipine göre kademelidir —
 * tam (ana/landing, 3 CTA) → alt sayfa (1-2 CTA veya breadcrumb) → kompakt (CTA'sız; blog/analiz).
 */
const heroScale =
  section.ctas.length === 0 ? 'compact' : section.breadcrumb.length > 0 || section.ctas.length < 3 ? 'sub' : 'full';
const isSubpage = heroScale !== 'full';

/* Görünen breadcrumb ile birebir aynı BreadcrumbList JSON-LD'si. */
const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';
const breadcrumbJsonLd =
  section.breadcrumb.length > 0
    ? toJsonLd([
        breadcrumbSchema(
          section.breadcrumb.map((crumb) => ({
            label: crumb.label,
            url: crumb.href ? new URL(crumb.href.replace(/\/?$/, '/'), site).toString() : undefined,
          })),
        ),
      ])
    : null;

/*
 * Referans: "Strateji ✦ Yaratıcılık ✦ …" biçimindeki slogan statik metin değil,
 * lime ✦ ayraçlı KAYAN şerittir. '✦' içeren tagline bu şeride dönüşür.
 */
const heroVideo = section.video;

/*
 * Hero video yükleyicisi: viewport'a göre TEK varyantı indirir (masaüstü varlığı
 * mobile inmez), reduced-motion'da video hiç yüklenmez (poster kalır). <video>
 * içinde <source media> desteklenmediği için seçim script'le yapılır; JSX ifadesi
 * içindeki <script> gövdesini prettier ayrıştıramadığından set:html kullanılır.
 */
const HERO_VIDEO_SCRIPT = `(() => {
  const video = document.currentScript.previousElementSibling.querySelector('.hero__video');
  if (!video) return;
  const init = () => {
  const d = video.dataset;
  const mobile = matchMedia('(max-width: 768px)').matches;
  const poster = (mobile ? d.mPoster : d.dPoster) || d.dPoster;
  if (poster) video.poster = poster;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const webm = mobile ? d.mWebm : d.dWebm;
  const mp4 = (mobile ? d.mMp4 : d.dMp4) || d.dMp4;
  if (webm) {
    const s = document.createElement('source');
    s.src = webm; s.type = 'video/webm';
    video.appendChild(s);
  }
  if (mp4) {
    const s = document.createElement('source');
    s.src = mp4; s.type = 'video/mp4';
    video.appendChild(s);
  }
  video.load();
  const start = () => { video.play().catch(() => {}); };
  video.readyState >= 3 ? start() : video.addEventListener('canplay', start, { once: true });
  };
  // Viewport genişliği yerleşim oturmadan yanlış okunabilir — seçim DCL'e ertelenir.
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', init, { once: true })
    : init();
})();`;

const tickerItems = section.tagline?.includes('✦')
  ? section.tagline
      .split('✦')
      .map((item) => item.trim())
      .filter(Boolean)
  : null;
---

<section
  id={section.anchor}
  class:list={[
    'hero',
    `hero--${section.background}`,
    isSubpage && 'hero--sub',
    heroScale === 'compact' && 'hero--compact',
    section.align === 'center' && 'hero--center',
  ]}
>
  {
    heroVideo && (
      <>
        <div class="hero__media-bg" aria-hidden="true">
          <video
            class="hero__video"
            muted
            loop
            playsinline
            preload="metadata"
            disablepictureinpicture
            data-d-mp4={heroVideo.desktopMp4}
            data-d-webm={heroVideo.desktopWebm}
            data-d-poster={heroVideo.desktopPoster}
            data-m-mp4={heroVideo.mobileMp4}
            data-m-webm={heroVideo.mobileWebm}
            data-m-poster={heroVideo.mobilePoster}
          />
          <span class="hero__video-scrim" />
        </div>
        <script is:inline set:html={HERO_VIDEO_SCRIPT} data-hero-video />
      </>
    )
  }
  <div class="hero__inner">
    {
      section.breadcrumb.length > 0 && (
        <nav class="hero__crumbs" aria-label={t('nav.breadcrumb', locale)}>
          {section.breadcrumb.map((crumb, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    {breadcrumbJsonLd && <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />}

    <div class:list={['hero__grid', heroImage && 'hero__grid--media']}>
      <div>
        {
          section.eyebrow && (
            <span class="hero__eyebrow">
              <span class="hero__eyebrow-dot" aria-hidden="true" />
              {section.eyebrow}
            </span>
          )
        }

        <h1 class="hero__title">
          {
            section.headingLines.map((line, lineIndex) => (
              <>
                {lineIndex > 0 && <br />}
                {parseHighlights(line).map((segment) =>
                  segment.accent ? <span class="hero__accent">{segment.text}</span> : segment.text,
                )}
              </>
            ))
          }
        </h1>

        {section.lead && <p class="hero__lead">{section.lead}</p>}

        {
          section.ctas.length > 0 && (
            <div class="hero__ctas">
              {section.ctas.map((cta) => (
                <CtaButton
                  label={cta.label}
                  href={cta.href}
                  variant={cta.variant}
                  icon={cta.icon}
                  external={cta.external}
                />
              ))}
            </div>
          )
        }

        {
          section.tagline &&
            (tickerItems ? (
              <div class="hero__ticker" aria-label={section.tagline}>
                <div class="hero__ticker-track">
                  {[0, 1].map((copy) => (
                    <div class="hero__ticker-group" aria-hidden={copy === 1 || undefined}>
                      {tickerItems.map((item) => (
                        <>
                          <span class="hero__ticker-item">{item}</span>
                          <span class="hero__ticker-star" aria-hidden="true">
                            ✦
                          </span>
                        </>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <p class="hero__tagline">{section.tagline}</p>
            ))
        }

        {
          /*
            Platform şeridi metin listesinin yerini alır: yedi adı okumak yerine
            ziyaretçi işaretleri tanır. Rakamlar bilinçli olarak burada DEĞİL,
            bir bölüm aşağıdaki rakamlar bandındadır — tekrar olmasın diye.
          */
          section.logos.length > 0 && (
            <ul class="hero__logos" role="list">
              {/* Sayı, logoların önünde ve onlarla aynı boyda durur — şeridi
                  cümle kurmadan etiketler. */}
              <li class="hero__logos-label">{section.logos.length}+ Platform</li>
              {section.logos.map((name) => (
                <li class="hero__logo" style={`--brand: ${PLATFORM_COLORS[name]}`}>
                  <PlatformLogo name={name} />
                </li>
              ))}
            </ul>
          )
        }

        {
          section.chips.length > 0 && (
            <ul class="hero__chips">
              {section.chips.map((chip) => (
                <li class="hero__chip">
                  {parseHighlights(chip).map((segment) =>
                    segment.accent ? <strong class="hero__chip-strong">{segment.text}</strong> : segment.text,
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        heroImage && (
          <div class="hero__media" data-reveal>
            <Image
              src={heroImage}
              alt={section.imageAlt ?? ''}
              class="hero__image"
              width={1000}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 9vw, 116px) var(--gutter) clamp(70px, 8vw, 110px);
    /* Lime parıltı + ince ızgara dokusu — referans tasarımdaki hero zemini. */
    background-image:
      radial-gradient(ellipse 60% 50% at 75% 20%, rgb(207 255 0 / 10%), transparent 65%),
      linear-gradient(rgb(255 255 255 / 4.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4.5%) 1px, transparent 1px);
    background-size:
      100% 100%,
      72px 72px,
      72px 72px;
  }

  .hero--light {
    background-color: var(--bg-light);
    background-image:
      radial-gradient(ellipse 60% 50% at 75% 20%, rgb(207 255 0 / 22%), transparent 65%),
      linear-gradient(rgb(10 10 10 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(10 10 10 / 4%) 1px, transparent 1px);
  }

  /* --- Hero arka plan videosu: metnin altında, etkileşimsiz katman --- */
  .hero__media-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Okunabilirlik örtüsü: sol koyu → sağ görünür; hero zeminiyle kaynaşır. */
  .hero__video-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(5 5 5 / 94%) 0%,
      rgb(5 5 5 / 86%) 35%,
      rgb(5 5 5 / 68%) 62%,
      rgb(5 5 5 / 34%) 100%
    );
  }

  /*
   * Ortalanmış hero'da yatay perde ters çalışıyor: yazı tam ortada durduğu için
   * en koyu bant metnin altına değil, sahnenin görünmesi gereken yere düşüyordu
   * ve video neredeyse hiç görünmüyordu. Ortalı varyantta perde merkezden dışa
   * açılan eliptik bir örtü — metnin arkası koyu, kenarlar sahneye açık.
   */
  .hero--center .hero__video-scrim {
    background:
      radial-gradient(ellipse 58% 66% at 50% 46%, rgb(5 5 5 / 90%) 0%, rgb(5 5 5 / 74%) 52%, rgb(5 5 5 / 34%) 100%),
      linear-gradient(180deg, rgb(5 5 5 / 52%) 0%, rgb(5 5 5 / 18%) 42%, rgb(5 5 5 / 62%) 100%);
  }

  @media (max-width: 768px) {
    /* Mobil kompozisyon: üst koyu (metin), alt görünür (sahne). */
    .hero__video-scrim,
    .hero--center .hero__video-scrim {
      background: linear-gradient(
        180deg,
        rgb(5 5 5 / 95%) 0%,
        rgb(5 5 5 / 85%) 42%,
        rgb(5 5 5 / 45%) 70%,
        rgb(5 5 5 / 25%) 100%
      );
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container);
    margin: 0 auto;
  }

  .hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    margin-bottom: 22px;
    animation: fadeUp 0.8s var(--ease-out) both;
  }

  .hero__crumbs a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--t-base);
  }

  .hero__crumbs a:hover {
    color: var(--accent);
  }

  .hero__crumbs [aria-current] {
    color: var(--text-soft);
  }

  /* Eyebrow: lime kenarlıklı pill */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgb(207 255 0 / 40%);
    border-radius: var(--radius-pill);
    padding: 9px 18px;
    font: 600 12px var(--font-display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    animation: fadeUp 0.8s var(--ease-out) both;
  }

  .hero__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* Görselli hero: metin solda, görsel sağda (referans: 1.15fr / .85fr).
     Görsel dikeyde ortalanmaz — üst kenarı eyebrow hizasından başlar. */
  .hero__grid--media {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  /* Grid ÖĞESİ varsayılan olarak `min-width: auto` taşır: içeriğinin
     min-content genişliğinin altına inmez. Hero'daki marquee şeridi
     (`.hero__ticker-track`, `width: max-content`) ~2000px olduğu için öğe
     track'i aşıyor ve başlık, paragraf ile butonlar da onunla birlikte
     ekran dışına taşıyordu — 390px'te buton 1985px genişleyip ortalanmış
     metni görünmez hâle getiriyordu. `overflow: hidden` yalnız `section`
     düzeyinde olduğundan sayfa kaymıyor, içerik sessizce kırpılıyordu. */
  .hero__grid > *,
  .hero__grid--media > * {
    min-width: 0;
  }

  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 28px;
    /* Görsel yumuşakça aşağı-yukarı süzülür. */
    animation: heroFloat 5s ease-in-out infinite;
  }

  @keyframes heroFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img) {
      animation: none;
    }
  }

  .hero__title {
    margin: 28px 0 0;
    font: 600 clamp(40px, 6.2vw, 86px) / 1.04 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--text);
    max-width: 1050px;
    text-wrap: balance;
    animation: fadeUp 0.8s var(--ease-out) 0.1s both;
  }

  /* Alt sayfa hero'su daha sıkı nefes alır — üst/alt boşluk bir kademe dar. */
  .hero--sub {
    padding-top: clamp(44px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 76px);
  }

  /* Referans: alt sayfa hero başlığı bir kademe küçüktür. */
  .hero--sub .hero__title {
    font-size: clamp(38px, 5.4vw, 74px);
    line-height: 1.05;
  }

  .hero--sub .hero__lead {
    font-size: clamp(16px, 1.3vw, 18px);
    max-width: 600px;
  }

  /* Referans (kariyer): ortalanmış hero — içerik dar kolonda ortada durur. */
  .hero--center .hero__inner {
    max-width: 880px;
    text-align: center;
  }

  .hero--center .hero__title,
  .hero--center .hero__lead {
    margin-inline: auto;
  }

  .hero--center .hero__ctas,
  .hero--center .hero__chips {
    justify-content: center;
  }

  /* Referans: CTA'sız içerik hero'ları (blog, analiz) kompakttır. */
  .hero--compact {
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 72px);
  }

  .hero--compact .hero__title {
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1.1;
  }

  .hero--compact .hero__lead {
    margin-top: 18px;
    font-size: clamp(15px, 1.1vw, 17px);
    max-width: 640px;
  }

  .hero--light .hero__title {
    color: var(--text-on-light);
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lead {
    margin: 28px 0 0;
    max-width: 720px;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.65;
    color: rgb(255 255 255 / 72%);
    animation: fadeUp 0.8s var(--ease-out) 0.2s both;
  }

  .hero--light .hero__lead {
    color: var(--text-muted-on-light);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    animation: fadeUp 0.8s var(--ease-out) 0.3s both;
  }

  .hero__tagline {
    margin: 22px 0 0;
    font-size: 14px;
    color: rgb(255 255 255 / 50%);
    animation: fadeUp 0.8s var(--ease-out) 0.4s both;
  }

  /*
   * Platform şeridi — CTA'ların altında ince bir kanıt bandı. İşaretler
   * durağan hâlde tek renk ve soluktur ki başlıkla yarışmasın; imleç
   * üzerlerine gelince marka rengine döner.
   */
  .hero__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(20px, 2.6vw, 34px);
    margin: 34px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid rgb(255 255 255 / 10%);
    list-style: none;
    animation: fadeUp 0.8s var(--ease-out) 0.45s both;
  }

  .hero__logos-label {
    font: 600 15px/1 var(--font-display);
    letter-spacing: 0.01em;
    color: rgb(255 255 255 / 72%);
    white-space: nowrap;
  }

  .hero--light .hero__logos-label {
    color: rgb(10 10 10 / 72%);
  }

  .hero__logo {
    display: block;
    color: rgb(255 255 255 / 42%);
    transition:
      color var(--t-base),
      transform var(--t-base);
  }

  .hero__logo :global(svg) {
    display: block;
    width: 26px;
    height: 26px;
  }

  .hero__logo:hover {
    color: var(--brand);
    transform: translateY(-2px);
  }

  .hero--light .hero__logo {
    color: rgb(10 10 10 / 45%);
  }

  @media (max-width: 720px) {
    .hero__logos {
      gap: 18px;
      margin-top: 26px;
      padding-top: 18px;
    }

    .hero__logo :global(svg) {
      width: 22px;
      height: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__logos {
      animation: none;
    }

    .hero__logo {
      transition: none;
    }

    .hero__logo:hover {
      transform: none;
    }
  }

  /* Referans: '✦' ayraçlı slogan kayan şerittir — 18px soluk metin + lime yıldızlar. */
  .hero__ticker {
    margin-top: 40px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    animation: fadeUp 0.8s var(--ease-out) 0.4s both;
  }

  .hero__ticker-track {
    display: flex;
    width: max-content;
    animation: marquee 24s linear infinite;
  }

  .hero__ticker-group {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
  }

  .hero__ticker-item {
    font: 600 18px var(--font-display);
    color: rgb(255 255 255 / 50%);
    white-space: nowrap;
  }

  .hero__ticker-star {
    color: var(--accent);
    font-size: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ticker {
      overflow-x: auto;
      overflow-y: hidden;
    }

    .hero__ticker-track {
      animation: none;
    }
  }

  .hero--light .hero__tagline {
    color: var(--text-muted-on-light);
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 52px 0 0;
    padding: 0;
    list-style: none;
    animation: fadeUp 0.8s var(--ease-out) 0.5s both;
  }

  .hero__chip {
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    font: 500 13px var(--font-display);
    color: var(--text-soft);
  }

  .hero__chip-strong {
    color: var(--accent);
    font-weight: 700;
  }

  .hero--light .hero__chip {
    border-color: var(--border-on-light);
    color: var(--text-muted-on-light);
  }

  @media (max-width: 860px) {
    .hero__grid--media {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .hero__ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
