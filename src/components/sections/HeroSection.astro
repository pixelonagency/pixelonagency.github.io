---
import type { PageSection } from '../../content/page-schema';
import { parseHighlights } from '../../lib/highlight';
import CtaButton from '../CtaButton.astro';

type Hero = Extract<PageSection, { type: 'hero' }>;

interface Props {
  section: Hero;
}

const { section } = Astro.props;
---

<section id={section.anchor} class:list={['hero', `hero--${section.background}`]}>
  <div class="hero__inner">
    {
      section.breadcrumb.length > 0 && (
        <nav class="hero__crumbs" aria-label="Site haritası">
          {section.breadcrumb.map((crumb, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
            </>
          ))}
        </nav>
      )
    }

    {
      section.eyebrow && (
        <span class="hero__eyebrow">
          <span class="hero__eyebrow-dot" aria-hidden="true" />
          {section.eyebrow}
        </span>
      )
    }

    <h1 class="hero__title">
      {
        section.headingLines.map((line, lineIndex) => (
          <>
            {lineIndex > 0 && <br />}
            {parseHighlights(line).map((segment) =>
              segment.accent ? <span class="hero__accent">{segment.text}</span> : segment.text,
            )}
          </>
        ))
      }
    </h1>

    {section.lead && <p class="hero__lead">{section.lead}</p>}

    {
      section.ctas.length > 0 && (
        <div class="hero__ctas">
          {section.ctas.map((cta) => (
            <CtaButton
              label={cta.label}
              href={cta.href}
              variant={cta.variant}
              icon={cta.icon}
              external={cta.external}
            />
          ))}
        </div>
      )
    }

    {section.tagline && <p class="hero__tagline">{section.tagline}</p>}

    {
      section.chips.length > 0 && (
        <ul class="hero__chips">
          {section.chips.map((chip) => (
            <li class="hero__chip">
              {parseHighlights(chip).map((segment) =>
                segment.accent ? <strong class="hero__chip-strong">{segment.text}</strong> : segment.text,
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 9vw, 116px) var(--gutter) clamp(70px, 8vw, 110px);
    /* Lime parıltı + ince ızgara dokusu — referans tasarımdaki hero zemini. */
    background-image:
      radial-gradient(ellipse 60% 50% at 75% 20%, rgb(207 255 0 / 10%), transparent 65%),
      linear-gradient(rgb(255 255 255 / 4.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4.5%) 1px, transparent 1px);
    background-size:
      100% 100%,
      72px 72px,
      72px 72px;
  }

  .hero--light {
    background-color: var(--bg-light);
    background-image:
      radial-gradient(ellipse 60% 50% at 75% 20%, rgb(207 255 0 / 22%), transparent 65%),
      linear-gradient(rgb(10 10 10 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(10 10 10 / 4%) 1px, transparent 1px);
  }

  .hero__inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font: 500 13px var(--font-display);
    color: var(--text-faint);
    margin-bottom: 22px;
    animation: fadeUp 0.8s var(--ease-out) both;
  }

  .hero__crumbs a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--t-base);
  }

  .hero__crumbs a:hover {
    color: var(--accent);
  }

  .hero__crumbs [aria-current] {
    color: var(--text-soft);
  }

  /* Eyebrow: lime kenarlıklı pill */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgb(207 255 0 / 40%);
    border-radius: var(--radius-pill);
    padding: 9px 18px;
    font: 600 12px var(--font-display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    animation: fadeUp 0.8s var(--ease-out) both;
  }

  .hero__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .hero__title {
    margin: 28px 0 0;
    font: 600 clamp(40px, 6.2vw, 86px) / 1.04 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--text);
    max-width: 1050px;
    text-wrap: balance;
    animation: fadeUp 0.8s var(--ease-out) 0.1s both;
  }

  .hero--light .hero__title {
    color: var(--text-on-light);
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lead {
    margin: 28px 0 0;
    max-width: 720px;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.65;
    color: rgb(255 255 255 / 72%);
    animation: fadeUp 0.8s var(--ease-out) 0.2s both;
  }

  .hero--light .hero__lead {
    color: var(--text-muted-on-light);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    animation: fadeUp 0.8s var(--ease-out) 0.3s both;
  }

  .hero__tagline {
    margin: 22px 0 0;
    font-size: 14px;
    color: rgb(255 255 255 / 50%);
    animation: fadeUp 0.8s var(--ease-out) 0.4s both;
  }

  .hero--light .hero__tagline {
    color: var(--text-muted-on-light);
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 52px 0 0;
    padding: 0;
    list-style: none;
    animation: fadeUp 0.8s var(--ease-out) 0.5s both;
  }

  .hero__chip {
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    font: 500 13px var(--font-display);
    color: var(--text-soft);
  }

  .hero__chip-strong {
    color: var(--accent);
    font-weight: 700;
  }

  .hero--light .hero__chip {
    border-color: var(--border-on-light);
    color: var(--text-muted-on-light);
  }

  @media (max-width: 720px) {
    .hero__ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
