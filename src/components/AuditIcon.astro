---
/**
 * Ücretsiz analizde incelenen alanların ikonları (cards · kind: audit).
 *
 * Çizgi dili SectorIcon · ReasonIcon · ProcessIcon ile aynı: 24×24 kutu,
 * stroke 1.6, yuvarlatılmış uçlar. Kütüphane eklenmedi (CLAUDE.md).
 */
type AuditIconName = 'web' | 'seo' | 'ads' | 'social' | 'brand' | 'commerce';

interface Props {
  name: AuditIconName;
}

const { name }: Props = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* Web sitesi ve kullanıcı deneyimi — tarayıcı penceresi ve imleç. */}
  {
    name === 'web' && (
      <>
        <rect x="2.8" y="4.2" width="18.4" height="15.6" rx="2.4" />
        <path d="M2.8 8.6h18.4" />
        <path d="M5.8 6.4h.01M8.2 6.4h.01M10.6 6.4h.01" />
        <path d="M10.6 11.8l6 5.6-2.4.5-1.1 2.3z" />
      </>
    )
  }

  {/* SEO ve Google görünürlüğü — büyüteç, içinde yükselen çizgi. */}
  {
    name === 'seo' && (
      <>
        <circle cx="10.6" cy="10.6" r="6.8" />
        <path d="M15.5 15.5l5.1 5.1" />
        <path d="M7.6 12.2l2.2-2.6 2 1.7 2.2-3" />
      </>
    )
  }

  {/* Reklam — hedef halkası ve isabet eden ok. */}
  {
    name === 'ads' && (
      <>
        <circle cx="11" cy="13" r="7.6" />
        <circle cx="11" cy="13" r="3.2" />
        <path d="M11 13l8.4-8.4M15.6 3.2l.7 2.9 2.9.7" />
      </>
    )
  }

  {/* Sosyal medya — konuşma balonu ve kalp. */}
  {
    name === 'social' && (
      <>
        <path d="M20.4 12.4a8 8 0 01-11.9 7L3.6 20.4l1.4-4.1A8 8 0 1120.4 12.4z" />
        <path d="M12 15.4l-2.4-2.3a1.6 1.6 0 012.4-2.1 1.6 1.6 0 012.4 2.1z" />
      </>
    )
  }

  {/* Marka ve kurumsal kimlik — renk paleti ve tipografi damlası. */}
  {
    name === 'brand' && (
      <>
        <path d="M12 3.4a8.6 8.6 0 000 17.2c1.3 0 2-.8 2-1.8 0-.6-.3-1-.6-1.4-.3-.4-.6-.8-.6-1.4 0-1 .8-1.8 1.8-1.8h1.4a4.6 4.6 0 004.6-4.6c0-3.5-3.9-6.2-8.6-6.2z" />
        <circle cx="7.6" cy="12.4" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="9.8" cy="8.2" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="14.4" cy="8.2" r="1.2" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* E-ticaret ve satış deneyimi — alışveriş çantası ve kulp. */}
  {
    name === 'commerce' && (
      <>
        <path d="M4.6 7.8h14.8l-1.2 12.4H5.8z" />
        <path d="M8.8 10V6.6a3.2 3.2 0 016.4 0V10" />
      </>
    )
  }
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
