---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRenderer from './SectionRenderer.astro';
import type { Locale } from '../lib/i18n';
import { jobCrumbs, jobDescriptionHtml } from '../lib/jobs';
import { canonicalUrl } from '../lib/seo';
import { jobPostingSchema } from '../lib/schema';

interface Props {
  job: CollectionEntry<'jobs'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { job, locale, alternates } = Astro.props;
const { seo, sections, whatsappMessage, title, datePosted, validThrough, remote } = job.data;

/*
 * Breadcrumb ilk hero'ya yazılır; hero bileşeni görünür breadcrumb'ı ve BreadcrumbList'i
 * aynı listeden basar. Hero'suz ilan breadcrumb kuralını karşılayamaz, bu yüzden build durur.
 */
const heroIndex = sections.findIndex((section) => section.type === 'hero');
if (heroIndex === -1) throw new Error(`İlan "${job.id}" bir hero bölümüyle başlamalı.`);

const crumbs = jobCrumbs({ locale, title });
const withCrumbs = sections.map((section, index) =>
  index === heroIndex && section.type === 'hero' ? { ...section, breadcrumb: crumbs } : section,
);

const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';
const extraSchema = [
  jobPostingSchema({
    title,
    description: jobDescriptionHtml(sections),
    url: canonicalUrl(Astro.url.pathname, site),
    datePosted,
    validThrough,
    remote,
  }),
];
---

<BaseLayout title={seo.title} description={seo.description} {whatsappMessage} {locale} {alternates} {extraSchema}>
  <SectionRenderer sections={withCrumbs} {locale} />
</BaseLayout>
