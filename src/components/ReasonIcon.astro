---
/**
 * "Neden Pixelon?" gerekçe kartlarının ikonları (cards · kind: feature).
 *
 * Çizgi dili SectorIcon · WhyIcon · ProcessIcon ile aynı: 24×24 kutu, stroke 1.6,
 * yuvarlatılmış uçlar. Kütüphane eklenmedi (CLAUDE.md).
 */
type ReasonIconName = 'strategy' | 'bespoke' | 'craft' | 'orbit' | 'partnership';

interface Props {
  name: ReasonIconName;
}

const { name }: Props = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* Strateji — üst üste binen halkalar: fikirlerin bir hedefte kesişmesi. */}
  {
    name === 'strategy' && (
      <>
        <circle cx="8.6" cy="12" r="5.6" />
        <circle cx="12.6" cy="12" r="5.6" />
        <circle cx="16.6" cy="12" r="5.6" />
      </>
    )
  }

  {/* Markaya özel — kesilmiş taş: hazır şablon değil, işlenmiş tek parça. */}
  {
    name === 'bespoke' && (
      <>
        <path d="M7.2 3.8h9.6l3.4 5-8.2 11.4L3.4 8.8z" />
        <path d="M3.4 8.8h17.2" />
        <path d="M9.4 8.8L12 20.2l2.6-11.4-2.6-5z" />
      </>
    )
  }

  {/* Tasarım ve teknoloji — çekirdek ve etrafındaki iki uydu. */}
  {
    name === 'craft' && (
      <>
        <circle cx="12" cy="12" r="3.4" />
        <circle cx="12" cy="12" r="8.4" />
        <circle cx="12" cy="3.6" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="19.3" cy="16.2" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="4.7" cy="16.2" r="1.5" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* 360° — noktalı yörünge üzerinde dolaşan kanallar. */}
  {
    name === 'orbit' && (
      <>
        <circle cx="12" cy="12" r="8.6" stroke-dasharray="2.2 3.4" />
        <circle cx="12" cy="12" r="2.6" />
        <circle cx="12" cy="3.4" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="20.6" cy="12" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="12" cy="20.6" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="3.4" cy="12" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Ortaklık — üst üste duran katmanlar: birlikte büyüyen iş birliği. */}
  {
    name === 'partnership' && (
      <>
        <path d="M12 3.2l8.4 4.2-8.4 4.2-8.4-4.2z" />
        <path d="M3.6 12l8.4 4.2 8.4-4.2" />
        <path d="M3.6 16.4l8.4 4.2 8.4-4.2" />
      </>
    )
  }
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
