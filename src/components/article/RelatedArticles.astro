---
/**
 * "İlgili Yazılar" — kart dili mevcut blog kartıyla (PostsSection) aynıdır:
 * krem dolgu, kategori etiketi, başlık, özet, okuma bağlantısı, lime hover.
 *
 * Yazılar `article.related` içindeki çeviri anahtarı/slug ile eşleşir; eşleşme
 * yoksa kart üretilmez — kırık bağlantı çıkmaz.
 */
import type { CollectionEntry } from 'astro:content';
import { localizedPath, type Locale } from '../../lib/i18n';
import { t } from '../../lib/ui';

interface Props {
  heading: string;
  posts: CollectionEntry<'posts'>[];
  locale: Locale;
}

const { heading, posts, locale } = Astro.props;

const slugOf = (id: string): string => id.split('/').pop() ?? id;
---

{
  posts.length > 0 && (
    <section class="ra" aria-labelledby="related-heading">
      <h2 class="ra__heading" id="related-heading">
        {heading}
      </h2>

      <ul class="ra__grid" role="list">
        {posts.map((post, index) => (
          <li class="ra__cell">
            <a
              class="ra__item"
              href={localizedPath('blog', locale, slugOf(post.id))}
              data-reveal
              data-reveal-index={index}
            >
              <span class="ra__category">{post.data.category}</span>
              <h3 class="ra__title">{post.data.title}</h3>
              <p class="ra__excerpt">{post.data.excerpt}</p>
              <span class="ra__read">
                {t('blog.readPost', locale)} <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .ra {
    margin-top: clamp(56px, 7vw, 88px);
  }

  .ra__heading {
    margin: 0 0 clamp(20px, 2.4vw, 28px);
    font: 600 clamp(24px, 2.8vw, 34px) / 1.2 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text-on-light);
  }

  .ra__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-card);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ra__cell {
    display: flex;
  }

  .ra__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding: 26px;
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    background: var(--bg-tint);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--t-slow),
      transform var(--t-slow);
  }

  .ra__item:hover {
    border-color: var(--accent);
    transform: translateY(-6px);
  }

  .ra__category {
    font: 600 12px var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted-on-light);
  }

  .ra__title {
    margin: 0;
    font: 600 var(--fs-h3) / 1.3 var(--font-display);
    color: var(--text-on-light);
  }

  .ra__excerpt {
    margin: 0;
    font: 400 var(--fs-body) / 1.65 var(--font-body);
    color: var(--text-muted-on-light);
    /* Kart yüksekliklerini hizalar; tam metin zaten yazının kendisinde. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ra__read {
    margin-top: auto;
    font: 600 var(--fs-small) var(--font-display);
    color: var(--text-on-light);
  }

  @media (max-width: 900px) {
    .ra__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .ra__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ra__item {
      transition: none;
    }

    .ra__item:hover {
      transform: none;
    }
  }
</style>
