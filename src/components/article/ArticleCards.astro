---
/**
 * Numaralı hizmet/özellik kartları. Kutu gürültüsünden kaçınmak için dolgulu
 * kart yerine ince üst çizgi + numara kullanılır.
 */
import { inlineHtml, paragraphs, stepNo, type BlockOf } from './types';

interface Props {
  block: BlockOf<'cards'>;
}

const { block } = Astro.props;

/**
 * Başlık seviyesi atlanmaz: blok kendi başlığını (h3) taşıyorsa kartlar h4,
 * taşımıyorsa bölüm h2'sinin hemen altındaki seviye olan h3 olur.
 */
const ItemHeading = block.heading ? 'h4' : 'h3';
---

<div class="ac" data-reveal>
  {block.heading && <h3 class="ac__heading">{block.heading}</h3>}
  {block.intro && <p class="ac__intro" set:html={inlineHtml(block.intro)} />}

  <ul class="ac__grid" role="list">
    {
      block.items.map((item, index) => (
        <li class="ac__item">
          <span class="ac__no" aria-hidden="true">
            {stepNo(index)}
          </span>
          <ItemHeading class="ac__title">{item.title}</ItemHeading>
          {paragraphs(item.text).map((part) => (
            <p class="ac__text" set:html={inlineHtml(part)} />
          ))}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .ac {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .ac__heading {
    margin: 0;
    font: 600 clamp(20px, 2.2vw, 26px) / 1.25 var(--font-display);
    color: var(--text-on-light);
  }

  .ac__intro {
    margin: 12px 0 0;
    font: 400 var(--fs-lead) / 1.75 var(--font-body);
    color: var(--text-muted-on-light);
  }

  .ac__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px);
    margin: clamp(24px, 3vw, 36px) 0 0;
    padding: 0;
    list-style: none;
  }

  .ac__item {
    padding-top: 18px;
    border-top: 1px solid var(--border-on-light);
  }

  .ac__no {
    display: block;
    font: 600 var(--fs-small) var(--font-display);
    letter-spacing: 0.12em;
    /* Lime beyaz zeminde metin olarak okunmaz; numara koyu, altı lime çizgili. */
    color: var(--text-on-light);
    padding-bottom: 4px;
    border-bottom: 2px solid var(--accent);
    width: fit-content;
  }

  .ac__title {
    margin: 12px 0 0;
    font: 600 var(--fs-h3) / 1.3 var(--font-display);
    color: var(--text-on-light);
  }

  .ac__text {
    margin: 8px 0 0;
    font: 400 var(--fs-body) / 1.7 var(--font-body);
    color: var(--text-muted-on-light);
  }

  @media (max-width: 720px) {
    .ac__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
