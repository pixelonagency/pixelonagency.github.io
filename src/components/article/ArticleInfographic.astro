---
/**
 * Merkez + çevresel düğüm diyagramı.
 *
 * Tüm etiketler ve bağlantılar HTML/CSS ile üretilir — görsel üreticiye Türkçe
 * yazı yazdırılmaz. Böylece diyagram retina keskinliğinde kalır, metin seçilebilir
 * ve ekran okuyucu tarafından okunur.
 *
 * Yerleşim: her düğüm merkezden `--a` açısıyla dışarı taşınır; ikinci ters
 * dönüş etiketi dik tutar. Dar ekranda halka bozulmadan listeye iner.
 */
import { inlineHtml, type BlockOf } from './types';

interface Props {
  block: BlockOf<'infographic'>;
}

const { block } = Astro.props;
const step = 360 / block.nodes.length;

/**
 * Bağlantı çubukları tek bir SVG katmanında çizilir (viewBox 0–100).
 * Merkez dairesinin kenarından (r≈19) etiketin hemen öncesine (r≈27) uzanır.
 */
const spokes = block.nodes.map((_, index) => {
  const rad = ((index * step - 90) * Math.PI) / 180;
  const at = (r: number) => ({ x: 50 + r * Math.cos(rad), y: 50 + r * Math.sin(rad) });
  const from = at(19.5);
  const to = at(27.5);
  return { x1: from.x.toFixed(2), y1: from.y.toFixed(2), x2: to.x.toFixed(2), y2: to.y.toFixed(2) };
});
---

<figure class="ag" data-reveal>
  {block.heading && <h3 class="ag__heading">{block.heading}</h3>}
  {block.intro && <p class="ag__intro" set:html={inlineHtml(block.intro)} />}

  <div class="ag__stage">
    <svg class="ag__wires" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <circle cx="50" cy="50" r="34.5" class="ag__ring"></circle>
      {spokes.map((line) => <line {...line} class="ag__wire" />)}
    </svg>

    <p class="ag__center">{block.center}</p>

    <ul class="ag__nodes" role="list">
      {
        block.nodes.map((node, index) => (
          <li class="ag__node" style={`--a: ${index * step - 90}deg`}>
            <span class="ag__label">{node}</span>
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  .ag {
    margin: clamp(32px, 4vw, 48px) 0 0;
  }

  .ag__heading {
    margin: 0;
    font: 600 clamp(20px, 2.2vw, 26px) / 1.25 var(--font-display);
    color: var(--text-on-light);
  }

  .ag__intro {
    margin: 12px 0 0;
    font: 400 var(--fs-lead) / 1.75 var(--font-body);
    color: var(--text-muted-on-light);
  }

  .ag__stage {
    /* Yarıçap sahne genişliğinin yüzdesi olarak tutulur; `left/top` yüzdeleri
       kapsayıcı bloğa (sahneye) göre çözülür — `transform` yüzdeleri elemanın
       KENDİ boyutuna göre çözüldüğü için orada kullanılamaz. */
    --r: 34.5%;

    position: relative;
    width: min(560px, 100%);
    aspect-ratio: 1;
    margin: clamp(20px, 3vw, 32px) auto 0;
  }

  .ag__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ag__ring {
    fill: none;
    stroke: var(--border-on-light);
    stroke-width: 0.25;
    stroke-dasharray: 1.4 1.4;
  }

  .ag__wire {
    stroke: var(--border-on-light);
    stroke-width: 0.3;
  }

  .ag__center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 36%;
    aspect-ratio: 1;
    margin: 0;
    padding: 10px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--text-on-light);
    font: 600 clamp(13px, 1.6vw, 16px) / 1.25 var(--font-display);
    text-align: center;
  }

  .ag__nodes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Kutupsal konum: merkez + yarıçap × (cos, sin). Döndürme yok, bu yüzden
     etiketleri dik tutmak için ters dönüşe de gerek kalmaz. */
  .ag__node {
    position: absolute;
    left: calc(50% + var(--r) * cos(var(--a)));
    top: calc(50% + var(--r) * sin(var(--a)));
    transform: translate(-50%, -50%);
  }

  .ag__label {
    position: relative;
    display: block;
    width: 128px;
    padding: 8px 10px;
    border: 1px solid var(--border-on-light);
    border-radius: var(--radius-pill);
    background: var(--bg-light);
    font: 600 var(--fs-small) / 1.3 var(--font-display);
    color: var(--text-on-light);
    text-align: center;
  }

  /* --- Dar ekran: halka yerine dikey liste --- */
  @media (max-width: 640px) {
    .ag__stage {
      width: 100%;
      aspect-ratio: auto;
    }

    .ag__wires {
      display: none;
    }

    .ag__center {
      position: static;
      transform: none;
      width: 100%;
      aspect-ratio: auto;
      padding: 14px 18px;
      border-radius: var(--radius-media);
    }

    .ag__nodes {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 10px;
    }

    .ag__node {
      position: static;
      transform: none;
    }

    .ag__label {
      width: auto;
      margin: 0;
    }
  }
</style>
