---
/**
 * Makale içi editorial görsel. Hero DEĞİLDİR: her zaman lazy yüklenir ve
 * genişliği okuma kolonundan taşarak medya genişliğine çıkar.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { BlockOf } from './types';

interface Props {
  block: BlockOf<'image'>;
}

const { block } = Astro.props;

const src = block.src as unknown as ImageMetadata;
---

<figure class="ai" data-reveal>
  {/* AVIF önce, desteklemeyen tarayıcıda WebP'ye düşer. */}
  <Picture
    src={src}
    alt={block.alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[480, 800, 1200, 1600]}
    sizes="(max-width: 720px) 100vw, (max-width: 1100px) 90vw, 1040px"
    quality={72}
    loading="lazy"
    decoding="async"
  />
  {block.caption && <figcaption class="ai__caption">{block.caption}</figcaption>}
</figure>

<style>
  .ai {
    margin: clamp(32px, 4vw, 52px) 0 0;
  }

  .ai :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
    border: 1px solid var(--border-on-light);
  }

  .ai__caption {
    margin: 12px 0 0;
    font: 400 var(--fs-small) / 1.6 var(--font-body);
    color: var(--text-muted-on-light);
  }
</style>
