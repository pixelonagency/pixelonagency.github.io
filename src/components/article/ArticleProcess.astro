---
/**
 * Numaralı süreç akışı. Masaüstünde yatay, tablet/mobilde dikey.
 * Aradaki oklar salt dekoratiftir (`aria-hidden`); sıra zaten `<ol>` ile taşınır.
 */
import { inlineHtml, stepNo, type BlockOf } from './types';

interface Props {
  block: BlockOf<'process'>;
}

const { block } = Astro.props;

/** Başlık seviyesi atlanmaz — bkz. ArticleCards. */
const StepHeading = block.heading ? 'h4' : 'h3';
---

<div class="ap" data-reveal>
  {block.heading && <h3 class="ap__heading">{block.heading}</h3>}
  {block.intro && <p class="ap__intro" set:html={inlineHtml(block.intro)} />}

  <ol class="ap__flow">
    {
      block.steps.map((step, index) => (
        <li class="ap__step">
          <span class="ap__no">{stepNo(index)}</span>
          <StepHeading class="ap__title">{step.title}</StepHeading>
          <p class="ap__text" set:html={inlineHtml(step.text)} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .ap {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .ap__heading {
    margin: 0;
    font: 600 clamp(20px, 2.2vw, 26px) / 1.25 var(--font-display);
    color: var(--text-on-light);
  }

  .ap__intro {
    margin: 12px 0 0;
    font: 400 var(--fs-lead) / 1.75 var(--font-body);
    color: var(--text-muted-on-light);
  }

  .ap__flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
    margin: clamp(24px, 3vw, 36px) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .ap__step {
    position: relative;
    padding-top: 16px;
    border-top: 2px solid var(--accent);
  }

  .ap__no {
    display: block;
    font: 600 var(--fs-small) var(--font-display);
    letter-spacing: 0.12em;
    color: var(--text-muted-on-light);
  }

  .ap__title {
    margin: 6px 0 0;
    font: 600 var(--fs-h3) / 1.3 var(--font-display);
    color: var(--text-on-light);
  }

  .ap__text {
    margin: 6px 0 0;
    font: 400 var(--fs-body) / 1.7 var(--font-body);
    color: var(--text-muted-on-light);
  }

  @media (max-width: 900px) {
    .ap__flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .ap__flow {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* Dikeyde adımlar tek bir çizgi üzerinde akar. */
    .ap__step {
      padding: 16px 0 16px 22px;
      border-top: 0;
      border-left: 2px solid var(--border-on-light);
    }

    .ap__step::before {
      content: '';
      position: absolute;
      left: -5px;
      top: 22px;
      width: 8px;
      height: 8px;
      border-radius: var(--radius-pill);
      background: var(--accent);
    }
  }
</style>
