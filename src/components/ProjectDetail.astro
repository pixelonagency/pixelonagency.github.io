---
/**
 * Proje case study (detay) sayfası — /projelerimiz/<slug>.
 *
 * Akış, sahibin verdiği sayfa taslağını izler:
 *   breadcrumb + hero (dönem, marka adı, konumlama, tanıtım, hizmet çipleri,
 *   sunum hero görseli) → künye şeridi (Müşteri/Hizmetler/Süre/Teslimatlar)
 *   → "Neler Yaptık?" (beyaz bant, editoryal iki kolon) → numaralı disiplin
 *   bölümleri (başlık + metin + sunum boardları) → Sonuç → spot CTA.
 *
 * İçeriğin tamamı projects koleksiyonundaki `detail` alanından gelir; CTA,
 * projeler sayfasının (pages/<locale>/projects.yml) spot CTA'sını yeniden
 * kullanır — kopya tek kaynakta kalır.
 */
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from './sections/CtaSection.astro';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../lib/i18n';
import { mediaUrl } from '../lib/media';
import { canonicalUrl } from '../lib/seo';
import { breadcrumbSchema, caseStudySchema, SERVICE_BY_PROJECT_CATEGORY } from '../lib/schema';
import { t } from '../lib/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { project, locale, alternates } = Astro.props;
const { title, client, category, excerpt, tags, year, cover, seo, detail } = project.data;
if (!detail) throw new Error(`detail alanı olmadan proje detay sayfası üretilemez: ${project.id}`);

const asImage = (value: unknown): ImageMetadata | undefined =>
  value && typeof value === 'object' && 'src' in (value as Record<string, unknown>)
    ? (value as ImageMetadata)
    : undefined;

const heroImage = asImage(detail.heroImage);

/* Metin alanları çift satır sonuyla paragraflanır (schema: text — markdown değil). */
const paragraphs = (text: string): string[] =>
  text
    .split(/\n{2,}/)
    .map((part) => part.trim())
    .filter(Boolean);

const site = Astro.site?.toString() ?? 'https://pixelon.com.tr';

/*
 * Kapanış rayı: aynı dildeki DİĞER vaka sayfaları. Yalnızca `detail`'i olanlar
 * alınır — case study'si olmayan projeye bağlanacak sayfa yok. Aynı kategori
 * öne çekilir (okuyucu benzer işi görmek ister), gerisi yıla göre yeniden eski.
 * Ray en fazla 8 kart taşır; daha fazlası kaydırmayı ödev hâline getiriyor.
 */
const RAIL_LIMIT = 8;
const railProjects = (await getCollection('projects'))
  .filter((entry) => entry.id.startsWith(`${locale}/`) && entry.id !== project.id && Boolean(entry.data.detail))
  .sort((a, b) => {
    const sameCategory = Number(b.data.category === category) - Number(a.data.category === category);
    return sameCategory !== 0 ? sameCategory : (b.data.year ?? '').localeCompare(a.data.year ?? '');
  })
  .slice(0, RAIL_LIMIT)
  .map((entry) => ({
    href: localizedPath('projects', locale, entry.id.slice(locale.length + 1)),
    title: entry.data.title,
    client: entry.data.client,
    /* Kart altı satırı: müşteri adı başlıkla birebir aynı olduğu için sektör
     * etiketi taşınır — aynı kelimeyi iki kez yazmak bilgi vermiyor. */
    categoryLabel: entry.data.categoryLabel,
    cover: asImage(entry.data.cover),
  }));

/*
 * Vakayı hizmet hattına bağla: proje `category`'si bir hizmet `translationKey`'ine
 * düşer (bkz. SERVICE_BY_PROJECT_CATEGORY), o anahtarın BU dildeki hizmet girdisi
 * bulunur. Girdi yoksa bağ hiç kurulmaz — yanlış bağ kurmaktansa bağ kurmamak.
 */
const serviceKey = SERVICE_BY_PROJECT_CATEGORY[category];
const serviceEntry = serviceKey
  ? (await getCollection('services')).find(
      (entry) => entry.id.startsWith(`${locale}/`) && entry.data.translationKey === serviceKey,
    )
  : undefined;
const caseService = serviceEntry
  ? {
      name: serviceEntry.data.title,
      url: new URL(localizedPath('services', locale, serviceEntry.id.split('/').slice(1).join('/')), site).toString(),
    }
  : undefined;

const coverImage = asImage(cover);

const extraSchema = [
  breadcrumbSchema([
    { label: t('nav.home', locale), url: new URL(localizedPath('home', locale), site).toString() },
    {
      label: t('nav.projects', locale),
      url: new URL(localizedPath('projects', locale), site).toString(),
    },
    { label: title },
  ]),
  ...caseStudySchema({
    url: canonicalUrl(Astro.url.pathname, site),
    title,
    description: excerpt,
    client,
    locale,
    year,
    tags,
    imageUrl: coverImage ? new URL(coverImage.src, site).toString() : undefined,
    service: caseService,
  }),
];

/* Kapanış CTA'sı projeler sayfasının spot CTA'sıyla aynı — tek içerik kaynağı. */
const projectsPage =
  (await getEntry('pages', `${locale}/projects`)) ?? (await getEntry('pages', `${DEFAULT_LOCALE}/projects`));
const ctaSection = projectsPage?.data.sections.find((section) => section.type === 'cta');

/* Vitrin loop videosu kullanan bölüm varsa oynatma script'i eklenir. */
const hasLoopVideo = detail.sections.some((section) => Boolean(section.video));

/*
 * Loop davranışı: görünürken oynat, değilken durdur; reduced-motion'da poster
 * kalır. JSX ifadesi içindeki <script> gövdesini prettier ayrıştıramadığı için
 * içerik set:html ile basılır.
 */
const LOOP_SCRIPT = `(() => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) entry.target.play().catch(() => {});
      else entry.target.pause();
    }
  }, { threshold: 0.15 });
  document.querySelectorAll('.pd-loop').forEach((video) => io.observe(video));
})();`;

/*
 * Diğer vakalar rayı: kendi kendine ilerleyen sonsuz döngü. Kart kümesi JS ile
 * bir kez klonlanır, ray bir "periyot" (özgün küme genişliği) sonuna geldiğinde
 * scrollLeft sessizce bir periyot geri alınır — kullanıcı dikişi görmez. Klonlar
 * aria-hidden + tabindex=-1: ekran okuyucu ve klavye aynı kartı iki kez görmez.
 * Otomatik ilerleme; imleç üstteyken, odak içerideyken, sekme arkadayken ve ray
 * ekran dışındayken durur. prefers-reduced-motion'da hiç başlamaz — oklar çalışır.
 */
const RAIL_SCRIPT = `(() => {
  const DELAY = 4000;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll('[data-rail]').forEach((rail) => {
    const root = rail.closest('[data-rail-root]');
    if (!root) return;
    const count = rail.children.length;
    if (!count) return;

    let cloned = false;
    let step = 0;
    let period = 0;
    let content = 0;
    let timer = 0;
    let settle = 0;
    let hovered = false;
    let focused = false;
    let onscreen = true;

    const clone = () => {
      if (cloned) return;
      const source = Array.from(rail.children);
      for (const node of source) {
        const copy = node.cloneNode(true);
        copy.setAttribute('aria-hidden', 'true');
        copy.setAttribute('tabindex', '-1');
        copy.setAttribute('data-rail-clone', '');
        rail.append(copy);
      }
      cloned = true;
    };

    const unclone = () => {
      if (!cloned) return;
      for (const node of rail.querySelectorAll('[data-rail-clone]')) node.remove();
      rail.scrollLeft = 0;
      cloned = false;
    };

    const measure = () => {
      const items = rail.children;
      const first = items[0];
      const last = items[count - 1];
      step = count > 1 ? items[1].offsetLeft - first.offsetLeft : first.offsetWidth;
      content = last.offsetLeft + last.offsetWidth - first.offsetLeft;
      period = content + (count > 1 ? step - first.offsetWidth : 0);
      const box = getComputedStyle(rail);
      const inner = rail.clientWidth - parseFloat(box.paddingLeft) - parseFloat(box.paddingRight);
      return content - inner > 8;
    };

    const normalise = () => {
      if (!cloned || !period) return;
      if (rail.scrollLeft >= period - 1) rail.scrollLeft -= period;
    };

    const go = (dir) => {
      if (!cloned || !step) return;
      if (rail.scrollLeft + dir * step < -1) rail.scrollLeft += period;
      rail.scrollBy({ left: dir * step, behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    const stop = () => {
      if (timer) {
        clearTimeout(timer);
        clearInterval(timer);
      }
      timer = 0;
    };

    const start = () => {
      stop();
      if (!cloned || reduce.matches) return;
      const tick = () => {
        if (hovered || focused || !onscreen || document.hidden) return;
        go(1);
      };
      /* İlk adım daha erken: 4 sn kıpırdamayan ray "bozuk" gibi okunuyor. */
      timer = setTimeout(() => {
        tick();
        timer = setInterval(tick, DELAY);
      }, 1400);
    };

    const refresh = () => {
      const overflowing = measure();
      if (!overflowing) {
        stop();
        unclone();
        root.setAttribute('data-rail-static', '');
        return;
      }
      root.removeAttribute('data-rail-static');
      clone();
      measure();
      start();
    };

    rail.addEventListener('scroll', () => {
      clearTimeout(settle);
      settle = setTimeout(normalise, 160);
    }, { passive: true });

    /*
     * Duraklatma KARTLARIN üstüne bağlı, bölümün tamamına değil: .pd-more şeridi
     * ekran genişliğini ve alttaki buton boşluğunu da kapsıyor, imleç o boşlukta
     * dururken ray hiç kaymıyordu. Odak duraklatması bölüm genelinde kalır —
     * klavye kullanıcısı okla gezerken ray altından kaymasın.
     */
    const hoverZone = root.querySelector('.pd-more__viewport') || rail;
    hoverZone.addEventListener('pointerenter', () => { hovered = true; });
    hoverZone.addEventListener('pointerleave', () => { hovered = false; });
    root.addEventListener('focusin', () => { focused = true; });
    root.addEventListener('focusout', () => { focused = false; });

    for (const button of root.querySelectorAll('[data-rail-step]')) {
      button.addEventListener('click', () => {
        go(Number(button.dataset.railStep));
        start();
      });
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const entry of entries) onscreen = entry.isIntersecting;
      }, { threshold: 0.2 }).observe(root);
    }

    if ('ResizeObserver' in window) {
      let queued = 0;
      new ResizeObserver(() => {
        clearTimeout(queued);
        queued = setTimeout(refresh, 200);
      }).observe(rail);
    } else {
      addEventListener('resize', () => { clearTimeout(settle); refresh(); });
    }

    refresh();
  });
})();`;
---

<BaseLayout
  title={seo?.title ?? `${title} | Pixelon`}
  description={seo?.description ?? excerpt}
  ogType="article"
  {locale}
  {alternates}
  ogImage={heroImage?.src}
  {extraSchema}
>
  <article class="pd">
    {/* ------------------------------------------------------------ HERO --- */}
    <header class="section pd-hero">
      <div class="container">
        <nav class="pd-crumbs" aria-label={t('nav.breadcrumb', locale)}>
          <a href={localizedPath('home', locale)}>{t('nav.home', locale)}</a>
          <span aria-hidden="true">/</span>
          <a href={localizedPath('projects', locale)}>{t('nav.projects', locale)}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{client}</span>
        </nav>

        <div class="pd-hero__grid">
          <div class="pd-hero__copy" data-reveal>
            <p class="eyebrow">
              Case Study
              {detail.period && <span class="pd-hero__period"> · {detail.period}</span>}
            </p>
            <h1 class="h1 pd-hero__title">{client}</h1>
            <p class="pd-hero__intro">{detail.intro}</p>
            {paragraphs(detail.description).map((part) => <p class="body-text pd-hero__desc">{part}</p>)}
          </div>

          {
            /* Hero alt metni projeye göre türetilir: her vakada web sitesi yok,
              sabit "web sitesi tasarımı" ifadesi yanlış bilgi veriyordu. */
          }
          {
            heroImage && (
              <div class="pd-hero__media" data-reveal data-reveal-index="1">
                <Image
                  src={heroImage}
                  alt={`${client} — ${detail.intro}`}
                  widths={[640, 960, 1280, 1600]}
                  sizes="(max-width: 900px) 100vw, 46vw"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            )
          }
        </div>

        {
          /* Kapsam çipleri ızgaranın DIŞINDA: metin kolonuna sıkışınca üç satıra
            taşıyor ve görselin altındaki alan boş kalıyordu. Tam genişlik. */
        }
        {
          detail.services.length > 0 && (
            <ul
              class="pd-hero__chips"
              data-reveal
              data-reveal-index="2"
              aria-label={locale === 'tr' ? 'Proje kapsamı' : 'Project scope'}
            >
              {detail.services.map((service) => (
                <li>{service}</li>
              ))}
            </ul>
          )
        }

        {
          detail.meta.length > 0 && (
            <dl class="pd-meta" data-reveal data-reveal-index="3">
              {detail.meta.map((item) => (
                <div class="pd-meta__item">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </header>

    {/* ------------------------------------------------- NELER YAPTIK? --- */}
    {
      detail.approach && (
        <section class="section section--light pd-approach">
          <div class="container pd-approach__grid">
            <div class="pd-approach__head" data-reveal>
              <p class="eyebrow">{locale === 'tr' ? 'Yaklaşım' : 'Approach'}</p>
              <h2 class="h2 pd-approach__title">{detail.approach.heading}</h2>
            </div>
            <div class="pd-approach__body" data-reveal data-reveal-index="1">
              {paragraphs(detail.approach.text).map((part) => (
                <p>{part}</p>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* ------------------------------------------------- ÖLÇÜLEN SONUÇ --- */}
    {
      detail.stats.length > 0 && (
        <section class="section pd-stats" aria-label={t('projects.measured', locale)}>
          <div class="container">
            <p class="eyebrow">{t('projects.measured', locale)}</p>

            {/* Ana rakam solda tek başına büyük; diğerleri sağda 2x2.
                Tek satır hâlinde dizilince ana rakamın sağı boş kalıyordu. */}
            <div class="pd-stats__grid">
              <div class="pd-stat pd-stat--hero" data-reveal>
                <span class="pd-stat__value" data-count={detail.stats[0]?.value}>
                  {detail.stats[0]?.value}
                </span>
                <span class="pd-stat__label">{detail.stats[0]?.label}</span>
                {detail.stats[0]?.note && <span class="pd-stat__note">{detail.stats[0].note}</span>}
              </div>

              {detail.stats.length > 1 && (
                <div class="pd-stats__rest">
                  {detail.stats.slice(1).map((stat, index) => (
                    <div class="pd-stat" data-reveal data-reveal-index={index + 1}>
                      <span class="pd-stat__value" data-count={stat.value}>
                        {stat.value}
                      </span>
                      <span class="pd-stat__label">{stat.label}</span>
                      {stat.note && <span class="pd-stat__note">{stat.note}</span>}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    {/* --------------------------------------------- DİSİPLİN BÖLÜMLERİ --- */}
    <section class="section pd-work">
      <div class="container">
        {
          detail.sections.map((block, index) => (
            <div class:list={['pd-block', block.reelsFirst && 'pd-block--reels-first']}>
              {/* Editoryal iki kolon: solda numara + başlık, sağda gövde.
                  Metin tek kolonda kalsaydı satır uzunluğu korunurken sağda
                  ~420px ölü alan oluşuyordu. */}
              <div class="pd-block__head" data-reveal>
                <div class="pd-block__lead">
                  <span class="pd-block__no" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h2 class="h2 pd-block__title">{block.heading}</h2>
                </div>
                <div class="pd-block__body">
                  {paragraphs(block.text).map((part) => (
                    <p class="body-text pd-block__text">{part}</p>
                  ))}
                </div>
              </div>

              {(block.video || block.images.length > 0) && (
                <div
                  class:list={[
                    'pd-block__media',
                    /* Yalnızca İKİ board yan yana durur. Üç ve fazlası alt alta
                       tam genişlik akar — sıkışıp küçülmesinler. */
                    block.layout !== 'stack' &&
                      block.images.length + (block.video ? 1 : 0) === 2 &&
                      'pd-block__media--pair',
                  ]}
                  data-reveal
                >
                  {block.video && (
                    <video
                      class="pd-loop"
                      poster={mediaUrl(block.video.poster)}
                      width={block.video.width}
                      height={block.video.height}
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      disablepictureinpicture
                      aria-label={`${client} — ${block.heading}`}
                    >
                      {block.video.webm && <source src={mediaUrl(block.video.webm)} type="video/webm" />}
                      <source src={mediaUrl(block.video.mp4)} type="video/mp4" />
                    </video>
                  )}
                  {block.images.map((img) => {
                    const meta = asImage(img);
                    return (
                      meta && (
                        <Image
                          src={meta}
                          alt={`${client} — ${block.heading}`}
                          widths={[640, 1040, 1600]}
                          sizes={
                            block.images.length > 1
                              ? '(max-width: 900px) 100vw, 48vw'
                              : '(max-width: 1100px) 100vw, 1040px'
                          }
                          loading="lazy"
                        />
                      )
                    );
                  })}
                </div>
              )}

              {/* Sosyal medya reel'leri: poster görünür, tıklayınca sesli oynar. */}
              {block.reels.length > 0 && (
                <div
                  class:list={[
                    'pd-reels',
                    /* Bir tanesi bile yataysa ızgara geniş karta geçer — dikey ve yatay
                       filmi aynı dar sütuna sıkıştırmak yatay olanı okunmaz yapıyor. */
                    block.reels.some((reel) => reel.width && reel.height && reel.width > reel.height) &&
                      'pd-reels--wide',
                  ]}
                  data-reels
                  data-reveal
                >
                  {block.reels.map((reel) => (
                    <figure class="pd-reel">
                      {/*
                        `controls` işaretlemede AÇIK gelir: JS çalışmazsa video yine
                        oynatılabilir. Betik çalışınca kontrolleri kaldırıp aşağıdaki
                        özel play butonunu açar — ilerleyici geliştirme.
                      */}
                      <div
                        class="pd-reel__frame"
                        style={
                          reel.width && reel.height ? `--pd-reel-ratio: ${reel.width} / ${reel.height}` : undefined
                        }
                      >
                        <video
                          class="pd-reel__video"
                          poster={mediaUrl(reel.poster)}
                          controls
                          playsinline
                          preload="none"
                          width={reel.width}
                          height={reel.height}
                          aria-label={reel.title}
                        >
                          <source src={mediaUrl(reel.src)} type="video/mp4" />
                        </video>
                        <button class="pd-reel__play" type="button" hidden aria-label={`${reel.title} — videoyu oynat`}>
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M9 6.5 18 12l-9 5.5z" fill="currentColor" />
                          </svg>
                        </button>
                      </div>
                      <figcaption class="pd-reel__title">{reel.title}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    {/* ----------------------------------------------------------- SONUÇ --- */}
    {
      detail.result && (
        <section class="section pd-result">
          <div class="container pd-result__inner" data-reveal>
            <span class="pd-result__mark" aria-hidden="true">
              ✦
            </span>
            <p class="eyebrow">{detail.result.heading}</p>
            {paragraphs(detail.result.text).map((part, index) => (
              <p class:list={['pd-result__text', index === 0 && 'pd-result__text--lead']}>{part}</p>
            ))}
          </div>
        </section>
      )
    }

    {/* ------------------------------------------------- DİĞER PROJELER --- */}
    {
      railProjects.length > 0 && (
        <section class="section pd-more" aria-labelledby={`${project.id}-more`} data-rail-root>
          <div class="container">
            <p class="eyebrow" id={`${project.id}-more`}>
              {locale === 'tr' ? 'Diğer Vakalar' : 'More Cases'}
            </p>

            <div class="pd-more__viewport">
              <button
                type="button"
                class="pd-more__nav pd-more__nav--prev"
                data-rail-step="-1"
                aria-label={locale === 'tr' ? 'Önceki vakalar' : 'Previous cases'}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    d="M15 5 8 12l7 7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>

              <div
                class="pd-more__rail"
                tabindex="0"
                role="group"
                data-rail
                aria-label={locale === 'tr' ? 'Diğer projeler — yatay kaydırın' : 'More projects — scroll horizontally'}
              >
                {railProjects.map((item) => (
                  <a class="pd-more__card" href={item.href}>
                    <span class="pd-more__media">
                      {item.cover ? (
                        <Image src={item.cover} alt="" loading="lazy" decoding="async" class="pd-more__image" />
                      ) : (
                        <span class="pd-more__placeholder" aria-hidden="true">
                          {item.client}
                        </span>
                      )}
                    </span>
                    <span class="pd-more__title">{item.title}</span>
                    {item.categoryLabel && <span class="pd-more__meta">{item.categoryLabel}</span>}
                  </a>
                ))}
              </div>

              <button
                type="button"
                class="pd-more__nav pd-more__nav--next"
                data-rail-step="1"
                aria-label={locale === 'tr' ? 'Sonraki vakalar' : 'Next cases'}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    d="m9 5 7 7-7 7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>

            <div class="pd-more__footer">
              <a href={localizedPath('projects', locale)} class="btn btn--outline pd-more__all">
                {locale === 'tr' ? 'Tüm Projeler' : 'All Projects'}
              </a>
            </div>
          </div>
        </section>
      )
    }

    {ctaSection && <CtaSection section={ctaSection} />}

    {hasLoopVideo && <script is:inline set:html={LOOP_SCRIPT} />}
    {railProjects.length > 0 && <script is:inline set:html={RAIL_SCRIPT} />}
  </article>
</BaseLayout>

