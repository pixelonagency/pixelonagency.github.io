<script>
  import { parseStatValue } from '../lib/stat-counter';

  /*
   * Sonuç rakamları için sayaç. Rakam HTML'de ZATEN son hâliyle basılıdır; bu betik
   * yalnızca üstüne biner. JS çalışmazsa ya da hata verirse sayfada doğru değer kalır.
   *
   * `prefers-reduced-motion` açıksa animasyon hiç başlamaz.
   * Biçim korunur: "%25" → "%" ön eki ve sayı ayrı ayrı ele alınır; "9,2M" → "M" son eki kalır.
   * Sayı biçimi DİLE BAĞLI (bkz. parseStatValue): Türkçe'de binlik nokta / ondalık virgül,
   * İngilizce'de tersi. Sabit Türkçe ayrıştırma, EN sayfada "9.2M" değerini 92 yapıyordu.
   */
  const nodes = document.querySelectorAll('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const locale = document.documentElement.lang === 'en' ? 'en' : 'tr';

  if (nodes.length > 0 && !reduce && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);

          const el = entry.target as HTMLElement;
          const raw = el.dataset.count ?? '';
          const parsed = parseStatValue(raw, locale);
          if (!parsed) continue;

          const { prefix, suffix, target, decimals } = parsed;
          const format = new Intl.NumberFormat(locale === 'en' ? 'en-GB' : 'tr-TR', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          });

          const duration = 1100;
          const start = performance.now();
          const step = (now: number) => {
            const progress = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = prefix + format.format(target * eased) + suffix;
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = raw;
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.4 },
    );

    nodes.forEach((node) => observer.observe(node));
  }
</script>

<script>
  /*
   * Reel oynatma. İşaretlemede `controls` açıktır (JS yoksa video yine çalışır);
   * betik çalışınca kontrolleri kaldırıp büyük play butonunu devreye alır.
   * Butona basıldığında kontroller geri gelir ve video sesli oynar.
   */
  const frames = document.querySelectorAll('[data-reels] .pd-reel__frame');
  const videos: HTMLVideoElement[] = [];

  frames.forEach((frame) => {
    const video = frame.querySelector('video');
    const button = frame.querySelector('button');
    if (!video || !button) return;

    videos.push(video);
    video.removeAttribute('controls');
    button.hidden = false;

    button.addEventListener('click', () => {
      video.controls = true;
      button.hidden = true;
      void video.play();
    });
  });

  /* Bir reel oynarken diğerleri durur — üç ses üst üste binmesin. */
  videos.forEach((video) => {
    video.addEventListener('play', () => {
      videos.forEach((other) => {
        if (other !== video) other.pause();
      });
    });
  });
</script>
