---
import CtaIcon from './CtaIcon.astro';

interface Props {
  label: string;
  href: string;
  variant?: 'primary' | 'outline' | 'link';
  icon?: 'whatsapp' | 'phone' | 'arrow' | undefined;
  external?: boolean;
}

const { label, href, variant = 'primary', icon, external = false }: Props = Astro.props;

// wa.me / tel: / mailto: bağlantıları da dış bağlantı sayılır.
const isExternal = external || /^(https?:|tel:|mailto:)/.test(href);
const target = isExternal && href.startsWith('http') ? '_blank' : undefined;
---

<a
  {href}
  {target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  class:list={[variant === 'link' ? 'cta-link' : 'btn', variant !== 'link' && `btn--${variant}`]}
>
  {icon && <CtaIcon name={icon} />}
  {label}
</a>

<style>
  .cta-link {
    /* Dokunma hedefi: 15px metin ~20px yükseklik veriyordu. */
    display: inline-block;
    padding-block: 5px;
    color: rgba(255, 255, 255, 0.7);
    font: 600 15px var(--font-display);
    text-decoration: underline;
    text-underline-offset: 5px;
    transition: color var(--t-slow);
  }

  .cta-link:hover {
    color: var(--accent);
  }

  :global(.section--light) .cta-link,
  :global(.hero--light) .cta-link {
    color: var(--text-muted-on-light);
  }

  :global(.section--light) .cta-link:hover,
  :global(.hero--light) .cta-link:hover {
    color: var(--text-on-light);
  }

  /* Dokunmatik hedef: 29px'lik metin bağlantısı parmakla isabetli
     tıklanamıyordu. Apple HIG ve WCAG 2.5.5 en az 44px öneriyor; dikey
     dolgu yalnız dokunmatik girdide artırılır, masaüstü tipografisi
     değişmez. Aynı kalıp `.pb-filter` için zaten kullanılıyordu. */
  @media (pointer: coarse) {
    .cta-link {
      min-height: 44px;
      padding-block: 11px;
    }
  }
</style>
