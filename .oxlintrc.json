{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "off",
    "pedantic": "off",
    "style": "off"
  },
  "rules": {
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "node_modules/**",
    "public/**",
    "design_handoff_astro_site/**",
    ".remember/**"
  ]
}
